layout {
    default_tab_template {
        children
        // Barre du bas : zjstatus (plugin tiers, format configurable). Remplace le
        // tab-bar natif pour mettre le NOM DE SESSION (= dossier) en avant et virer
        // l'habillage « Zellij (...) » codé en dur. Palette = thème muted.
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "#[bg=#000000,fg=#8ed68e,bold] 󰉋 {session} #[bg=#000000,fg=#4a4a4a]│#[bg=#000000,fg=#808080]  {tabs}{pipe_wait}"
                format_right "#[bg=#000000]{mode}#[bg=#000000,fg=#607a60,bold] {swap_layout} "
                format_space "#[bg=#000000]"
                border_enabled "false"

                // Alerte rouge « ⚠ action t'attend · Alt+W » poussée par wait-bar via
                // `zellij pipe` quand un Claude de la session est bloqué sur un QCM.
                // (rendermode dynamic → la couleur #[fg=…] est rendue.)
                pipe_wait_format "{output}"
                pipe_wait_rendermode "dynamic"

                // mode courant — sert aussi de fallback pour tous les modes ({name} = nom du mode)
                mode_normal "#[fg=#808080,bg=#000000] {name} "

                // onglets sur fond noir : actif = souligné (pas de bloc), inactif = gris discret
                tab_normal "#[fg=#707070,bg=#000000] {name} "
                tab_active "#[fg=#000000,bg=#000000] #[fg=#d0d0d0,bg=#000000,bold,underline]{name}#[fg=#000000,bg=#000000] "
            }
        }
    }

    // Page 1 — le front : sidebar+editor (stack) | claude (stack des claudes) + barre ＋
    tab name="le front" focus=true {
        pane split_direction="vertical" {
            // Colonne de gauche = la sidebar, SEULE. Pas de nvim empilé ici :
            // 20 % de large, c'est ~35 colonnes — inéditable, donc le pane
            // `editor` ne servait à rien. Un fichier s'ouvre en plein écran
            // (pane flottant), ce qui est de toute façon la seule taille où
            // éditer est confortable.
            pane size="20%" name="sidebar" command="~/.local/bin/sidebar" {
                args "--live"
            }
            pane split_direction="horizontal" {
                pane stacked=true {
                    pane name="claude" focus=true command="~/.local/bin/engine" {
                        args "launch"
                    }
                }
                pane size=1 borderless=true name="＋ claude" command="~/.local/bin/aside-button"
            }
        }
    }

    // Page 2 — le camp (territoire de Claude, peuplé via `soutien`)
    // La garnison est la BASE d'une stack : les soutiens s'empilent dessus
    // (`soutien` → `zellij run --stacked`). La garnison ne se ferme jamais → l'onglet
    // « le camp » ne se vide (ni ne disparaît) pas quand un soutien se termine.
    tab name="le camp" {
        pane stacked=true {
            pane name="garnison" command="~/.local/bin/garnison"
        }
    }

    // Page 3 — la tente : shell + git (terminaux perso, côte à côte)
    tab name="la tente" {
        pane split_direction="vertical" {
            pane name="shell" command="~/.local/bin/shell-pane"
            pane name="git" command="~/.local/bin/git-pane"
        }
    }
}
