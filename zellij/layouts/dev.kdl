layout {
    default_tab_template {
        children
        // Barre du bas : zjstatus (plugin tiers, format configurable). Remplace le
        // tab-bar natif pour mettre le NOM DE SESSION (= dossier) en avant et virer
        // l'habillage « Zellij (...) » codé en dur. Palette = thème muted.
        pane size=1 borderless=true {
            plugin location="file:/home/jlal/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "#[bg=#000000,fg=#8ed68e,bold] 󰉋 {session} #[bg=#000000,fg=#4a4a4a]│#[bg=#000000,fg=#808080]  {pipe_busy}{tabs}"
                format_right "#[bg=#000000]{mode}#[bg=#000000,fg=#607a60,bold] {swap_layout} "
                format_space "#[bg=#000000]"
                border_enabled "false"

                // Point « ● » busy poussé par tab-pulse via `zellij pipe`, placé juste
                // DEVANT {tabs} → se lit comme un point clignotant devant la 1re page.
                // (rendermode dynamic → le ● coloré et son clignotement sont rendus.)
                pipe_busy_format "{output}"
                pipe_busy_rendermode "dynamic"

                // mode courant — sert aussi de fallback pour tous les modes ({name} = nom du mode)
                mode_normal "#[fg=#808080,bg=#000000] {name} "

                // onglets sur fond noir : actif = souligné (pas de bloc), inactif = gris discret
                tab_normal "#[fg=#707070,bg=#000000] {name} "
                tab_active "#[fg=#000000,bg=#000000] #[fg=#d0d0d0,bg=#000000,bold,underline]{name}#[fg=#000000,bg=#000000] "
            }
        }
    }

    // Page 1 — code page : editor (nvim) | claude (stack des claudes) + barre ＋
    tab name="code page" focus=true {
        pane split_direction="vertical" {
            pane size="20%" name="editor" command="/home/jlal/.local/bin/editor-pane" {
                args "."
            }
            pane split_direction="horizontal" {
                pane stacked=true {
                    pane name="claude" focus=true command="/home/jlal/.local/bin/engine" {
                        args "launch"
                    }
                }
                pane size=1 borderless=true name="＋ claude" command="/home/jlal/.local/bin/aside-button"
            }
        }
    }

    // Page 2 — sandbox (territoire de Claude, peuplé via `crun`)
    tab name="sandbox" {
        pane name="welcome" command="/home/jlal/.local/bin/agents-welcome"
    }

    // Page 3 — my space : shell + git (terminaux perso, côte à côte)
    tab name="my space" {
        pane split_direction="vertical" {
            pane name="shell" command="/home/jlal/.local/bin/shell-pane"
            pane name="git" command="/home/jlal/.local/bin/git-pane"
        }
    }
}
