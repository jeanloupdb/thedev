#!/usr/bin/env bash
# @thedev liens pushes a local folder to a machine (rsync, honours gitignore)
# ship: pushes a local folder to a remote machine (rsync over SSH).
# Basic reusable building block: deploy, back up, share a build…
#
#   ship <machine> [src] [dest]
#     machine : SSH alias (jlax, indice, …), see ~/.ssh/config
#     src     : local folder to send           (default: .)
#     dest    : remote path                    (default: ~/projects/<src-name>)
#
#   ship list                  # known SSH machines (~/.ssh/config aliases)
#
# Behaviour: rsync -az --delete, and HONOURS the project's .gitignore
# (dir-merge filter): no node_modules / .next / .env sent. .git is
# always excluded. Idempotent: rerunning only sends the changed files.
# Prints the remote path at the end (reusable by a following call).

set -u
SSH_OPTS="-o ConnectTimeout=10"

die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
info() { printf '\033[1;34m▸\033[0m %s\n' "$*"; }

cmd_list() {
  info "known SSH machines:"
  grep -E '^Host ' "$HOME/.ssh/config" 2>/dev/null | awk '{for(i=2;i<=NF;i++) print "  • "$i}'
}

case "${1:-}" in
  ''|-h|--help) grep -E '^#( |$)' "$0" | sed -E 's/^# ?//'; exit 0 ;;
  list)         cmd_list; exit 0 ;;
esac

machine="$1"; shift
src="${1:-.}"; [ "${1:-}" ] && shift || true
src="${src%/}"                                   # retire un / final éventuel
[ -d "$src" ] || die "source not found: $src"
name="$(basename "$(cd "$src" && pwd -P)")"
dest="${1:-\$HOME/projects/$name}"               # ~ résolu côté distant

command -v rsync >/dev/null || die "rsync missing locally"

# The remote node must exist + have rsync; the parent folder is created.
info "to $machine:$dest"
ssh $SSH_OPTS "$machine" "command -v rsync >/dev/null || exit 9; mkdir -p \"$dest\"" \
  || die "machine unreachable, without rsync, or dest cannot be created ($machine)"

# --filter dir-merge: applies the .gitignore of every folder walked through.
rsync -az --delete \
  --exclude='.git/' \
  --filter=':- .gitignore' \
  -e "ssh $SSH_OPTS" \
  "$src/" "$machine:$dest/" \
  || die "rsync failed"

# Returns the resolved absolute remote path (handy to chain job/tsnode).
remote="$(ssh $SSH_OPTS "$machine" "cd \"$dest\" && pwd -P" 2>/dev/null)"
ok "sent: $machine:${remote:-$dest}"
printf '%s\n' "${remote:-$dest}"
