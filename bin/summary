#!/usr/bin/env bash
# @thedev org workspace summary: THE shared headline that syncs up to the lead
# summary: a workspace's description of itself, a small SHARED summary that any
# agent can edit. It is what the lead sees for each workspace (the headline
# of the agents page). See plans/org.md.
#
# Recursive: each node has ONE summary (its description of itself). Who writes it varies:
#   workspace → co-written by its AGENTS (collective, no single lead)
#   lead      → written by the lead session itself (the "moi.md")
# A lead stacks the (bounded) summaries of its children, so it stays bounded.
#
#   summary                 show the current summary (+ who / when)
#   summary set "<text>"    replace it (any agent), bounded
#   summary --data          the raw body, folded onto one line (for the lead's view)
#
# UN fichier partage par workspace (contrairement a `note`, 1/agent). Petit + rare →
# ecriture ATOMIQUE (temp + mv), dernier qui ecrit gagne, pas de lock. On trace le
# dernier editeur + l'heure. Stockage : $ROOT/resume/<node_key>.md, 1re ligne meta
# « epoch<TAB>sig », le reste = corps.
set -u

ROOT="$HOME/.cache/thedev/command"
MAXB="${THEDEV_RESUME_MAX:-400}"     # taille max du corps (c'est un SUMMARY, pas un journal)

workspace_name()  { printf '%s' "${ZELLIJ_SESSION_NAME:-$(basename "$(pwd -P)")}"; }
machine_name() {
  local m; m="$(head -n1 "$HOME/.config/dev-vps" 2>/dev/null)"
  [ -n "$m" ] || m="$(hostname -s)"
  printf '%s' "$m"
}
node_key() {
  printf '%s__%s' \
    "$(machine_name | tr -c 'A-Za-z0-9._-' '_')" \
    "$(workspace_name  | tr -c 'A-Za-z0-9._-' '_')"
}
my_sid() { printf '%s' "${CLAUDE_CODE_SESSION_ID:-${USER:-anon}-local}"; }
sig_of() { printf '%s' "${1:0:6}"; }
name_of() { agent-register get "$1" 2>/dev/null | cut -f4 | sed 's/^◆ //'; }

RFILE="$ROOT/resume/$(node_key).md"
_now() { date +%s; }
_ago() {
  local d=$(( $(_now) - ${1:-0} ))
  if [ "$d" -lt 3600 ]; then printf '%dm' $(( d/60 ))
  elif [ "$d" -lt 86400 ]; then printf '%dh' $(( d/3600 ))
  else printf '%dd' $(( d/86400 )); fi
}
_meta_epoch() { head -n1 "$RFILE" 2>/dev/null | cut -f1; }
_meta_sig()   { head -n1 "$RFILE" 2>/dev/null | cut -f2; }
_body()       { [ -f "$RFILE" ] && tail -n +2 "$RFILE" 2>/dev/null; }

cmd_set() {
  # extrait un éventuel --force, le reste = le texte
  local force=0 args=()
  local a; for a in "$@"; do case "$a" in --force|-f) force=1 ;; *) args+=("$a") ;; esac; done
  local txt; txt="$(printf '%s' "${args[*]}" | sed 's/[[:space:]]*$//')"
  [ -n "$txt" ] || { echo "usage: summary set [--force] \"<text>\"" >&2; return 1; }
  local n="${#txt}"
  if [ "$n" -gt "$MAXB" ]; then
    printf '✗ summary too long (%s > %s chars). It is a SUMMARY: shorten it.\n' "$n" "$MAXB" >&2
    return 3
  fi
  mkdir -p "$(dirname "$RFILE")" || return 0
  local mysig; mysig="$(sig_of "$(my_sid)")"
  # Anti-conflit : le résumé est PARTAGÉ. On sérialise l'écriture (flock borné) et on
  # ajoute une garde optimiste — si un AUTRE agent vient d'écrire (< 10 s), on refuse
  # d'écraser sa modif : relis d'abord. `--force` outrepasse.
  exec 9>"$RFILE.lock" 2>/dev/null && flock -w 3 9 2>/dev/null
  local cur_ep cur_sig; cur_ep="$(_meta_epoch)"; cur_sig="$(_meta_sig)"
  if [ "$force" = 0 ] && [ -n "$cur_ep" ] && [ "$cur_sig" != "$mysig" ] \
       && [ $(( $(_now) - cur_ep )) -lt 10 ]; then
    printf '⚠ another agent (%s) changed the summary %ss ago. Reread it with "summary", then retry (or summary set --force).\n' \
      "$cur_sig" "$(( $(_now) - cur_ep ))" >&2
    return 1
  fi
  local now; now="$(_now)"
  local tmp="$RFILE.$$.tmp"
  { printf '%s\t%s\n' "$now" "$mysig"; printf '%s\n' "$txt"; } > "$tmp" \
    && mv -f "$tmp" "$RFILE"                       # remplacement atomique (le « courant »)
  # Historique daté (append-only) : garde l'évolution du headline pour la timeline.
  # Le corps est replié sur une ligne (pas de tab/newline) → une ligne = un changement.
  local flat; flat="$(printf '%s' "$txt" | tr '\t\n\r' '   ' | sed 's/  */ /g; s/ *$//')"
  mkdir -p "$ROOT/resume-log" 2>/dev/null \
    && printf '%s\t%s\t%s\n' "$now" "$mysig" "$flat" >> "$ROOT/resume-log/$(node_key).md"
  flock -u 9 2>/dev/null || true
  printf '✓ workspace summary updated (%s/%s chars).\n' "$n" "$MAXB"
}

cmd_show() {
  printf '── summary · %s (%s) ──\n' "$(workspace_name)" "$(machine_name)"
  if [ ! -s "$RFILE" ]; then
    echo "(no summary yet: summary set \"<workspace state in one sentence>\")"; return 0
  fi
  _body
  local ep sg nm; ep="$(_meta_epoch)"; sg="$(_meta_sig)"; nm="$(name_of "$sg" 2>/dev/null)"
  printf '  · updated %s ago%s\n' "$(_ago "$ep")" "${nm:+ · $nm}"
}

cmd_data() {   # corps replie sur une ligne, pour la facade du lead (une ligne/workspace)
  _body | tr '\n' ' ' | sed 's/  */ /g; s/ *$//'
}

# brouillon pour tuer la friction : l'agent AJUSTE au lieu de composer de zéro.
# Source zéro-IA : le summary actuel + les derniers sujets de commit du dossier courant.
cmd_suggest() {
  local cwd; cwd="$(pwd -P)"
  local cur commits
  cur="$(_body 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g; s/ *$//')"
  commits="$(git -C "$cwd" log --no-merges -n 3 --format='%s' 2>/dev/null | awk 'NR>1{printf " · "} {printf "%s",$0} END{if(NR)print ""}')"
  echo "draft: adjust it, then: summary set \"...\""
  [ -n "$cur" ]     && printf '  current         : %s\n' "$cur"
  [ -n "$commits" ] && printf '  recent activity : %s\n' "$commits"
  [ -z "$cur$commits" ] && echo "  (nothing to suggest: no summary and no recent commits)"
}

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  set|edit)       cmd_set "$@" ;;
  suggest|--suggest) cmd_suggest ;;
  --data)         cmd_data ;;
  show|ls|"")     cmd_show ;;
  help|-h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "usage: summary | summary set \"...\" | summary --data" >&2; exit 1 ;;
esac
