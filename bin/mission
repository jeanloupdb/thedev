#!/usr/bin/env bash
# @thedev liens envoie une mission a un espace distant et attend le resultat (--model)
# mission — envoie une MISSION à un ESPACE distant (lien thedev) et attend le RÉSULTAT.
# Voir NAMING.md + plans/thedev-liens.md. C'est le CÔTÉ ÉMETTEUR (cross-machine, via SSH).
#
#   mission [--model <m>] <machine>/<espace> "<texte>"   envoie, attend, affiche le résultat
#   mission ls <machine>                                  liste les espaces joignables (via ssh)
#
# Réglages : TIMEOUT=<sec> (défaut 600 ; 0 = pas de plafond, l'espace attend
# tant que le Claude de mission vit — utile pour un workflow long).
# --model <m> : modèle du Claude de mission (alias fable|opus|sonnet|haiku ou id
# complet). Absent = défaut de la machine cible.  L'espace doit être OUVERT.
set -u
me="$(basename "$0")"
from="$( { cat "$HOME/.config/dev-vps" 2>/dev/null || hostname -s; } )/${ZELLIJ_SESSION_NAME:-shell}"
SSH="ssh -o ConnectTimeout=10"

cmd_ls() {
  local machine="$1"
  echo "Espaces joignables sur $machine :"
  $SSH "$machine" 'shopt -s nullglob; n=0; for f in ~/.cache/thedev/links/*; do e=$(basename "$f"); c=$(sed -n "s/^cwd=//p" "$f"); printf "  ● %s  (%s)\n" "$e" "$c"; n=$((n+1)); done; if [ $n -eq 0 ]; then echo "  (aucun espace ouvert)"; fi; exit 0' 2>/dev/null \
    || { echo "  ✗ injoignable (ssh $machine)"; return 1; }
}

cmd_send() {
  local addr="$1" text="$2" model="${3:-}"
  local machine="${addr%%/*}" espace="${addr#*/}"
  [ "$machine" = "$addr" ] && { echo "✗ format : <machine>/<espace>"; exit 1; }
  local id="m-$(date +%Y%m%d-%H%M%S)-$RANDOM"
  local wait="${TIMEOUT:-600}" loops
  # wait=0 (pas de plafond) : on sonde longtemps côté serveur (cap d'attente ssh
  # généreux, l'espace gère le vrai sans-timeout via la vivacité du pane).
  if [ "$wait" -eq 0 ] 2>/dev/null; then loops=$(( 21600 / 3 )); else loops=$(( (wait + 30) / 3 )); fi
  # en-tête Model: seulement si demandé
  local model_hdr=""; [ -n "$model" ] && model_hdr="Model: $model"$'\n'
  # 1. l'espace est-il ouvert ?
  if ! $SSH "$machine" "[ -f \$HOME/.cache/thedev/links/$espace ]" 2>/dev/null; then
    echo "✗ '$espace' n'est pas ouvert aux missions sur $machine."
    echo "  (là-bas, dans l'espace : thedev-link open ; ici : mission ls $machine)"
    exit 1
  fi
  # 2. déposer la mission dans l'inbox
  printf 'From: %s\nCreated: %s\nTimeout: %s\n%s\n%s\n' \
      "$from" "$(date -Iseconds)" "$wait" "$model_hdr" "$text" \
    | $SSH "$machine" "d=\$HOME/.cache/thedev/spaces/$espace/inbox; mkdir -p \"\$d\"; cat > \"\$d/$id.mission\"" \
    || { echo "✗ échec dépôt mission"; exit 1; }
  echo "→ mission $id → $addr (timeout ${wait}s). En attente du résultat…"
  # 3. attendre le résultat côté serveur (une seule connexion)
  $SSH "$machine" "f=\$HOME/.cache/thedev/spaces/$espace/outbox/$id.result
    for i in \$(seq 1 $loops); do [ -f \"\$f\" ] && { echo '──────── RÉSULTAT ────────'; cat \"\$f\"; exit 0; }; sleep 3; done
    exit 7" \
    || { echo "✗ pas de résultat (timeout ${wait}s)"; exit 1; }
}

# sous-commande ls à part
if [ "${1:-}" = "ls" ]; then
  shift; [ -n "${1:-}" ] || { echo "usage: $me ls <machine>"; exit 1; }; cmd_ls "$1"; exit $?
fi

# envoi : --model optionnel avant <machine>/<espace> "<texte>"
model=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model|-m) model="$2"; shift 2 ;;
    *) break ;;
  esac
done
if [ -z "${1:-}" ] || [ -z "${2:-}" ]; then
  printf 'usage:\n  %s [--model <fable|opus|sonnet|haiku>] <machine>/<espace> "<texte>"\n  %s ls <machine>\n' "$me" "$me"; exit 1
fi
cmd_send "$1" "$2" "$model"
