#!/usr/bin/env bash
# @thedev org partition: sorts a machine's workspaces into themed domains
# partition: when a machine overflows (> span workspaces), groups its workspaces into ≤ span
# well-named themed DOMAINS. It is the ONLY smart step of the org tree.
#
# Clear split:
#   - the DECISION (the grouping) is made by the CLAUDE that runs `partition apply`
#     (intelligence on the SUBSCRIPTION, interactive, never `claude -p`).
#   - this binary only provides the MATERIAL (`prep`) and the SAFE WRITE (`apply`:
#     per-node lock + snapshot re-check). No LLM is called here.
#
# Result = a domain OVERRIDE per workspace: grouping/<key> = <domain>. Non intrusive
# (does not edit project repos), read by `org-tree` (wins over the declared `domaine:`),
# and synced up to the top like the rest. Self-clearing: if the set of workspaces falls
# back under the span, the override just stays harmless.
#
#   partition            (= status): does the machine overflow? current state
#   partition prep       print the material (key · name · summary) + freeze a snapshot
#   partition apply      read "key<TAB>domain" (stdin) → write the domains
#                        (lock + refuse if the set of workspaces changed since prep)
set -u

ROOT="$HOME/.cache/thedev/command"
N_SPAN="${THEDEV_SPAN:-7}"
GDIR="$ROOT/grouping"

machine_self() { local m; m="$(head -n1 "$HOME/.config/dev-vps" 2>/dev/null)"; [ -n "$m" ] || m="$(hostname -s)"; printf '%s' "$m"; }
_fm() { awk -v k="$2" 'NR==1&&$0=="---"{fm=1;next} fm&&$0=="---"{exit} fm&&$0~"^"k":[ \t]*"{sub("^"k":[ \t]*","");print;exit}' "$1"; }
_resume_of() { local f="$ROOT/resume/$1.md"; [ -f "$f" ] && tail -n +2 "$f" 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g; s/ *$//'; }
me="$(machine_self)"

# clés des workspaces de CETTE machine (triées) — la matière à partitionner
_local_keys() {
  local f key mc
  for f in "$ROOT"/workspaces/*.md; do
    [ -e "$f" ] || continue
    key="$(basename "$f" .md)"
    mc="$(_fm "$f" machine)"; [ -n "$mc" ] || mc="$me"
    [ "$mc" = "$me" ] && printf '%s\n' "$key"
  done | sort
}
# domaine courant d'une clé (override grouping prioritaire, sinon frontmatter)
_dom_of() {
  local key="$1"
  [ -f "$GDIR/$key" ] && { head -n1 "$GDIR/$key"; return; }
  _fm "$ROOT/workspaces/$key.md" domaine
}
_snap() { _local_keys | tr '\n' '|'; }   # empreinte de l'ensemble de workspaces

cmd_status() {
  local keys n doms nd
  keys="$(_local_keys)"; n="$(printf '%s\n' "$keys" | grep -c .)"
  doms="$(for k in $keys; do d="$(_dom_of "$k")"; printf '%s\n' "${d:-(sans)}"; done | sort -u)"
  nd="$(printf '%s\n' "$doms" | grep -c .)"
  printf 'machine %s: %s workspace(s), %s domain(s), span %s\n' "$me" "$n" "$nd" "$N_SPAN"
  if [ "$nd" -gt "$N_SPAN" ]; then
    printf '  ⚠ overflow: %s domains > %s → `partition prep`, then group by theme.\n' "$nd" "$N_SPAN"
  else
    printf '  ✓ within span (nothing to do).\n'
  fi
}

cmd_prep() {
  local keys n; keys="$(_local_keys)"; n="$(printf '%s\n' "$keys" | grep -c .)"
  [ "$n" -gt 0 ] || { echo "(no local workspace)"; return 0; }
  mkdir -p "$GDIR" 2>/dev/null; _snap > "$GDIR/.snap"    # fige l'ensemble pour le re-check
  printf '# Partition of machine %s: %s workspaces, target ≤ %s themed domains, clear names.\n' "$me" "$n" "$N_SPAN"
  printf '# Material (key · name · summary):\n'
  local k eq rz
  for k in $keys; do
    eq="$(_fm "$ROOT/workspaces/$k.md" workspace)"; eq="${eq#*/}"; [ -n "$eq" ] || eq="$k"
    rz="$(_resume_of "$k")"; [ -n "$rz" ] || rz="(no summary)"
    printf '%s\t%s\t%s\n' "$k" "$eq" "$rz"
  done
  printf '# → Return a mapping, one line per workspace: <key><TAB><domain>, then: partition apply\n'
}

cmd_apply() {
  mkdir -p "$GDIR" 2>/dev/null
  # verrou par machine (le nœud) : une seule partition à la fois sur cette machine
  exec 9>"$GDIR/.lock" 2>/dev/null && { flock -w 5 9 2>/dev/null || { echo "partition: busy (another partition is running), retry." >&2; return 1; }; }
  # re-check optimiste : l'ensemble de workspaces doit être identique au snapshot de `prep`
  local snap_now snap_prep; snap_now="$(_snap)"; snap_prep="$(cat "$GDIR/.snap" 2>/dev/null)"
  if [ -n "$snap_prep" ] && [ "$snap_now" != "$snap_prep" ]; then
    echo "partition: the set of workspaces changed since \`prep\`, rerun \`partition prep\` then regroup." >&2
    return 1
  fi
  # applique le mapping (stdin : clé<TAB>domaine)
  local k d valid=" $(_local_keys | tr '\n' ' ') " nw=0
  while IFS="$(printf '\t')" read -r k d; do
    [ -n "$k" ] || continue
    case "$k" in \#*) continue ;; esac                 # tolère les lignes de commentaire
    case "$valid" in *" $k "*) : ;; *) printf '✗ unknown key: %s (ignored)\n' "$k" >&2; continue ;; esac
    d="$(printf '%s' "$d" | tr '\t\n\r' '   ' | sed 's/^ *//; s/ *$//')"
    [ -n "$d" ] || continue
    printf '%s\n' "$d" > "$GDIR/$k"
    nw=$((nw+1))
  done
  flock -u 9 2>/dev/null || true
  printf '✓ partition applied: %s workspace(s) sorted. (org-tree shows the new domains)\n' "$nw"
}

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  status|"") cmd_status ;;
  prep)      cmd_prep ;;
  apply)     cmd_apply ;;
  help|-h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "usage: partition [status|prep|apply]" >&2; exit 1 ;;
esac
