#!/usr/bin/env bash
# @thedev infra proposeur de tâches par signaux (parc git + todos + autos) — zéro IA, zéro coût
# thedev-propose — scanne des SIGNAUX déjà présents sur le disque et (ré)écrit
#   ~/.cache/thedev/proposals.json, lu par l'accueil (écran « propositions »).
# AUCUNE IA, AUCUN appel facturé : juste git, grep, systemctl. Idempotent, écriture atomique.
# Signaux v1 (local) :
#   • todos non cochés (« - [ ] ») dans todo.md / PROJECTS.md du parc — ce que TU as écrit
#   • commits locaux non poussés dans les repos git du parc (avec upstream)
#   • automatisations thedev en échec (systemctl --user)
# Usage :
#   thedev-propose            scanne + écrit le cache (+ résumé sur stderr)
#   thedev-propose --stdout   écrit le JSON sur stdout, ne touche pas au cache
set -u
DEV_ROOT="${DEV_ROOT:-$HOME/jlal_perso}"
OUT="$HOME/.cache/thedev/proposals.json"
NOW="$(date -Iseconds 2>/dev/null || date)"
MACHINE="local"
MAX=10
command -v jq >/dev/null 2>&1 || { echo "thedev-propose: jq requis" >&2; exit 1; }

props=()
add() {  # $1 titre  $2 pourquoi  $3 priorite(haute|moyenne|basse)  $4 action(hint)
  props+=("$(jq -nc --arg t "$1" --arg p "$2" --arg pr "$3" --arg a "$4" \
                    --arg m "$MACHINE" --arg c "$NOW" \
    '{titre:$t, pourquoi:$p, priorite:$pr, action:$a, machine:$m, cree_le:$c}')")
}

# (A) todos non cochés — les tâches que TU as écrites (le signal le plus fort, zéro bruit)
for f in "$DEV_ROOT/todo.md" "$DEV_ROOT/PROJECTS.md" \
         "$DEV_ROOT/perso/todo.md" "$DEV_ROOT/perso/PROJECTS.md"; do
  [ -f "$f" ] || continue
  base="$(basename "$(dirname "$f")")/$(basename "$f")"
  while IFS= read -r task; do
    [ -n "$task" ] || continue
    add "$task" "À faire — $base" "moyenne" "open:$(dirname "$f")"
  done < <(grep -hE '^[[:space:]]*[-*] \[ \] ' "$f" 2>/dev/null \
             | sed -E 's/^[[:space:]]*[-*] \[ \] //; s/[[:space:]]+$//' | head -4)
done

# (B) commits locaux non poussés (repos avec upstream, profondeur ≤ 2 sous le parc)
while IFS= read -r gd; do
  repo="${gd%/.git}"; name="$(basename "$repo")"
  git -C "$repo" rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1 || continue
  n="$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null)"
  [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null \
    && add "Pousser $n commit(s) — $name" "$name a $n commit(s) locaux non poussés" "moyenne" "push:$repo"
done < <(find "$DEV_ROOT" -maxdepth 3 -type d -name .git -not -path '*/node_modules/*' 2>/dev/null | head -40)

# (C) automatisations thedev en échec (à réparer en priorité)
if command -v systemctl >/dev/null 2>&1; then
  while IFS= read -r unit; do
    [ -n "$unit" ] || continue
    svc="${unit%.service}"
    desc="$(systemctl --user show "$unit" -p Description --value 2>/dev/null)"
    case "$desc" in *[Tt]hedev*) ;; *) continue ;; esac
    add "Réparer l'automatisation « $svc »" "Le service $unit est en échec" "haute" "auto:$svc"
  done < <(systemctl --user list-units --type=service --state=failed --no-legend 2>/dev/null | awk '{print $1}')
fi

# --- assemblage : tri par priorité (haute → moyenne → basse), cap à MAX ---
if [ "${#props[@]}" -eq 0 ]; then
  json='{"propositions":[]}'
else
  json="$(printf '%s\n' "${props[@]}" | jq -sc --argjson max "$MAX" '
    sort_by(.priorite | if .=="haute" then 0 elif .=="moyenne" then 1 else 2 end)
    | {propositions: .[0:$max]}')"
fi

if [ "${1:-}" = "--stdout" ]; then
  printf '%s\n' "$json"
  exit 0
fi
mkdir -p "$(dirname "$OUT")"
tmp="$(mktemp "${OUT}.XXXXXX")" && printf '%s\n' "$json" > "$tmp" && mv -f "$tmp" "$OUT"
n="$(printf '%s' "$json" | jq '.propositions | length')"
echo "thedev-propose: $n proposition(s) → $OUT" >&2
