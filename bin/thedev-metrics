#!/usr/bin/env bash
# @thedev infra métriques limitantes locales (RAM/disque/load/chaleur) — source unique
# Affichées en permanence : l'etat-major (ligne du bas) et la ligne « ＋ Nouveau soldat ».
#   thedev-metrics            bande ANSI colorée (vert<70 · jaune<88 · rouge sinon)
#   thedev-metrics --raw      valeurs machine, 1/ligne (pour l'etat-major, qui colore en curses)
# RAM% et disque% = couperets DURS (OOM / écritures qui échouent). load = saturation
# (à comparer aux cœurs). Usage Claude (fenêtre Max 5x) = claude-window-usage (endpoint
# OAuth interne, GRATUIT) — le couperet le plus limitant pour le travail d'agents.
set -u
# claude-window-usage vit dans ~/.local/bin, absent du PATH d'un ssh non-interactif
# → on le garantit (sinon l'usage Claude disparaît de la bande à distance).
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
ncpu=$(nproc 2>/dev/null || echo 1)

ram_pct()  { awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{ if(t) printf "%.0f", 100*(t-a)/t }' /proc/meminfo 2>/dev/null; }
disk_pct() { df -P "$1" 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5}'; }
load1()    { awk '{print $1}' /proc/loadavg 2>/dev/null; }
load5()    { awk '{print $2}' /proc/loadavg 2>/dev/null; }

# Batterie (portable uniquement — silencieux sur serveur sans BAT*).
# BAT_PCT=% · BAT_ST=dis|chg|full · BAT_TIME=XhMM restant (avant vide si décharge,
# avant pleine charge si charge ; vide si courant nul/inconnu). Interfaces sysfs :
# charge_now/current_now (µAh/µA) OU energy_now/power_now (µWh/µW) selon le firmware.
BAT_PCT="" BAT_ST="" BAT_TIME=""
for _b in /sys/class/power_supply/BAT*; do
  [ -e "$_b/capacity" ] || continue
  BAT_PCT=$(cat "$_b/capacity" 2>/dev/null)
  case "$(cat "$_b/status" 2>/dev/null)" in
    Discharging) BAT_ST=dis;;
    Charging)    BAT_ST=chg;;
    Full)        BAT_ST=full;;
  esac
  now=""; full=""; rate=""
  if [ -e "$_b/charge_now" ]; then
    now=$(cat "$_b/charge_now" 2>/dev/null); full=$(cat "$_b/charge_full" 2>/dev/null)
    rate=$(cat "$_b/current_now" 2>/dev/null)
  elif [ -e "$_b/energy_now" ]; then
    now=$(cat "$_b/energy_now" 2>/dev/null); full=$(cat "$_b/energy_full" 2>/dev/null)
    rate=$(cat "$_b/power_now" 2>/dev/null)
  fi
  if [ -n "$rate" ] && [ "$rate" -gt 0 ] 2>/dev/null && [ -n "$now" ]; then
    secs=""
    case "$BAT_ST" in
      dis) secs=$(( now * 3600 / rate ));;
      chg) [ -n "$full" ] && secs=$(( (full - now) * 3600 / rate ));;
    esac
    if [ -n "$secs" ] && [ "$secs" -gt 0 ] 2>/dev/null; then
      BAT_TIME=$(printf '%dh%02d' $(( secs / 3600 )) $(( (secs % 3600) / 60 )))
    fi
  fi
  break   # première batterie seulement
done

# Santé de la batterie = capacité pleine ACTUELLE / capacité pleine D'ORIGINE, telle
# que le firmware les expose. Déterministe (une division, pas d'historique à tenir) et
# portable : c'est la seule paire de valeurs que tous les portables publient. Deux
# nomenclatures existent selon le firmware et il faut gérer les deux — energy_* (µWh,
# fréquent chez Lenovo/Dell) ou charge_* (µAh, fréquent chez Asus/HP), ces derniers
# convertis en Wh par la tension nominale. cycle_count n'est pas universel : souvent
# absent ou bloqué à 0, il n'est joint que s'il porte une vraie valeur.
BATH="" BATH_FULL="" BATH_DES="" BATH_CYC=""
for _b in /sys/class/power_supply/BAT*; do
  [ -e "$_b/present" ] || continue
  _f=""; _d=""
  if [ -s "$_b/energy_full" ] && [ -s "$_b/energy_full_design" ]; then
    _f=$(cat "$_b/energy_full"); _d=$(cat "$_b/energy_full_design")
    BATH_FULL=$(awk -v x="$_f" 'BEGIN{printf "%.1f", x/1e6}')
    BATH_DES=$(awk -v x="$_d" 'BEGIN{printf "%.1f", x/1e6}')
  elif [ -s "$_b/charge_full" ] && [ -s "$_b/charge_full_design" ]; then
    _f=$(cat "$_b/charge_full"); _d=$(cat "$_b/charge_full_design")
    _v=$(cat "$_b/voltage_min_design" 2>/dev/null || echo 0)
    if [ "${_v:-0}" -gt 0 ] 2>/dev/null; then    # µAh × µV → Wh
      BATH_FULL=$(awk -v x="$_f" -v v="$_v" 'BEGIN{printf "%.1f", x*v/1e12}')
      BATH_DES=$(awk -v x="$_d" -v v="$_v" 'BEGIN{printf "%.1f", x*v/1e12}')
    fi
  fi
  if [ -n "$_f" ] && [ "${_d:-0}" -gt 0 ] 2>/dev/null; then
    BATH=$(awk -v f="$_f" -v d="$_d" 'BEGIN{printf "%.0f", 100*f/d}')
  fi
  _c=$(cat "$_b/cycle_count" 2>/dev/null)
  [ "${_c:-0}" -gt 0 ] 2>/dev/null && BATH_CYC="$_c"
  break
done

# Chaleur (température du die) — portable surtout : un PC posé sur un lit ou une
# couverture n'évacue plus, se bride, et cuit sa batterie. Capteur : « Package id 0 »
# de coretemp (Intel) ou Tctl de k10temp (AMD) — c'est CETTE température qui déclenche
# le bridage. À défaut : zone x86_pkg_temp, puis acpitz (grossier mais universel).
# TCRIT est lu SUR LE CAPTEUR (100 °C Intel, ~95 AMD), donc tous les seuils sont des
# % de crit et jamais des degrés en dur : une autre machine se calibre toute seule.
# On sort le DEGRÉ, pas un adjectif : la couleur (bornes 70/88 comme toutes les autres
# jauges) dit déjà si le chiffre est bon. Le seul mot ajouté est « étouffé », qui n'est
# pas un niveau mais un diagnostic — il se répare d'un geste.
TEMP="" TCRIT="" FAN="" TETOUF=0
for _h in /sys/class/hwmon/hwmon*; do
  case "$(cat "$_h/name" 2>/dev/null)" in
    coretemp|k10temp|zenpower)
      [ -e "$_h/temp1_input" ] || continue
      TEMP=$(( $(cat "$_h/temp1_input" 2>/dev/null || echo 0) / 1000 ))
      [ -e "$_h/temp1_crit" ] && TCRIT=$(( $(cat "$_h/temp1_crit") / 1000 ))
      break;;
  esac
done
if [ -z "$TEMP" ]; then                      # 2 passes : x86_pkg_temp d'abord, acpitz en dernier
  for _want in x86_pkg_temp acpitz; do
    for _z in /sys/class/thermal/thermal_zone*; do
      [ "$(cat "$_z/type" 2>/dev/null)" = "$_want" ] || continue
      TEMP=$(( $(cat "$_z/temp" 2>/dev/null || echo 0) / 1000 )); break 2
    done
  done
fi
# Ventilateur : informatif (il confirme l'étouffement), jamais décisif — son régime
# max n'est écrit nulle part, donc on ne peut pas en faire un seuil. `acpi_fan` expose
# souvent un fan1_input VIDE : le test > 0 l'écarte au profit du pilote constructeur.
for _h in /sys/class/hwmon/hwmon*; do
  case "$(cat "$_h/name" 2>/dev/null)" in
    asus|dell_smm|thinkpad|applesmc|acpi_fan)
      _v=$(cat "$_h/fan1_input" 2>/dev/null)
      if [ -n "$_v" ] && [ "$_v" -gt 0 ] 2>/dev/null; then FAN=$_v; break; fi;;
  esac
done
# Sur secteur ou sur batterie ? Le branchement déplafonne le CPU (les limites de
# puissance montent), et ça décale TOUT : mesuré sur un Zenbook, même travail,
# 58 °C sur batterie contre 80 °C branché. Un seuil unique ne peut donc pas servir
# les deux régimes — il crierait au loup en permanence dès qu'on branche.
AC=0
for _a in /sys/class/power_supply/*/type; do
  [ "$(cat "$_a" 2>/dev/null)" = Mains ] || continue
  [ "$(cat "${_a%/type}/online" 2>/dev/null)" = 1 ] && AC=1
  break
done

if [ -n "$TEMP" ] && [ "$TEMP" -gt 0 ] 2>/dev/null; then
  : "${TCRIT:=100}"
  # ÉTOUFFÉ = chaud SANS travail. C'est la signature d'un PC dont l'air ne sort plus,
  # pas celle d'un build (qui, lui, a le droit de chauffer). On lit load5 et non load1 :
  # la moyenne 5 min du noyau fait le lissage, donc aucune alerte dans la queue de
  # refroidissement qui suit une compilation, et aucun cache à tenir de notre côté.
  #
  # Les seuils viennent d'une MESURE, pas d'un raisonnement. Même machine, même
  # travail (load ~3,5), trois régimes enregistrés à la minute :
  #     sur batterie ................ 58 °C
  #     branché, sur un bureau ...... 80 °C
  #     branché, sur un lit ......... 92 °C
  # Le secteur pèse +22 °C, le lit +12 °C de plus. D'où deux seuils, placés entre
  # le normal et l'étouffé de CHAQUE régime — et non un seuil unique, qui serait
  # allumé en permanence dès le branchement.
  #
  # C'est bien le DIE qu'on lit, pas les capteurs de châssis (SEN*) : ces derniers
  # ont été essayés et rejetés sur mesure. Ils mettent des dizaines de minutes à
  # bouger et la charge de la batterie les chauffe en continu — sortis du lit,
  # trois d'entre eux étaient PLUS chauds que dessus. Le die, lui, répond en
  # secondes et sépare nettement les deux positions.
  seuil=$(awk -v ac="$AC" 'BEGIN{ print (ac ? 0.88 : 0.70) }')
  TETOUF=$(awk -v t="$TEMP" -v c="$TCRIT" -v l="$(load5)" -v n="$ncpu" -v s="$seuil" \
    'BEGIN{ e=0; if(t >= s*c && l < 0.35*n) e=1; print e }')
else
  TEMP=""
fi

# ---------------------------------------------------------------------------
# Réseau — « est-ce que ça passe, et par où ». TROIS états seulement, parce que
# c'est là que l'action diffère : plus de route (rebrancher) · route mais rien ne
# passe (box en rade, portail captif — inutile de chercher côté agent) · ça passe
# (et alors la force du lien explique la lenteur sans que rien ne soit cassé).
#
# L'interface est celle qui porte la ROUTE PAR DÉFAUT, jamais une énumération de
# /sys/class/net : docker0, virbr0, les veth et tailscale0 y sont « up » en
# permanence, et n'importe quelle boucle naïve annoncerait « connecté » à tort.
#
# Le signal sort en POURCENTAGE et non en dBm (échelle négative et logarithmique,
# illisible) : formule de NetworkManager — % = 2×(dBm+100) borné 0-100 — donc la
# valeur COLLE à l'indicateur Wi-Fi du bureau au lieu d'inventer une échelle
# propre à thedev. C'est une DONNÉE, pas un affichage : la colonne la traduit en
# statut (bon/faible/mauvais), le pourcentage et le débit du lien filaire ne sont
# lus tels quels que par la page « infos », qui a la place de les expliquer.
NET_STATE="" NET_PCT="" NET_NAME="" NET_VPN="" NET_SPD=""
NET_IF=$(awk 'NR>1 && $2=="00000000" && $8=="00000000"{print $7"\t"$1}' /proc/net/route \
         2>/dev/null | sort -n | head -1 | cut -f2)
if [ -z "$NET_IF" ]; then
  NET_STATE=down
else
  NET_STATE=ok
  if [ -d "/sys/class/net/$NET_IF/wireless" ]; then
    # /proc/net/wireless : « wlo1: 0000  30.  -80.  -256 » → $4 = niveau (dBm).
    _lvl=$(awk -v i="$NET_IF:" '$1==i{ sub(/\.$/,"",$4); print $4 }' /proc/net/wireless 2>/dev/null)
    if [ -n "$_lvl" ]; then
      NET_PCT=$(awk -v l="$_lvl" 'BEGIN{
        if (l < 0)         p = 2*(l+100);   # dBm — le cas normal
        else if (l <= 100) p = l;           # pilote qui rend déjà une qualité relative
        else exit;                          # valeur inexploitable → rien
        if (p < 0) p = 0; if (p > 100) p = 100; printf "%.0f", p }')
    fi
  else
    _s=$(cat "/sys/class/net/$NET_IF/speed" 2>/dev/null)
    [ "${_s:-0}" -gt 0 ] 2>/dev/null && NET_SPD="$_s"
  fi

  # Nom du réseau et VPN : ça ne bouge quasi jamais → relu toutes les 30 s, pas à
  # chaque tour (le bandeau se rafraîchit toutes les 3 s). Cache invalidé si
  # l'interface de sortie a changé.
  _idc="${XDG_CACHE_HOME:-$HOME/.cache}/thedev/net-id"
  _fresh=0
  if [ -f "$_idc" ]; then
    IFS=$'\t' read -r _ci _cn _cv < "$_idc" 2>/dev/null || true
    _age=$(( $(date +%s) - $(stat -c %Y "$_idc" 2>/dev/null || echo 0) ))
    [ "$_age" -lt 30 ] && [ "${_ci:-}" = "$NET_IF" ] && _fresh=1
  fi
  if [ "$_fresh" = 1 ]; then
    NET_NAME="${_cn:-}"; NET_VPN="${_cv:-}"
  else
    if [ -d "/sys/class/net/$NET_IF/wireless" ]; then
      NET_NAME=$(iwgetid -r 2>/dev/null)
    else
      NET_NAME=filaire
    fi
    # VPN : une interface tunnel qui porte une ADRESSE. La présence de
    # l'interface ne suffit PAS — tailscale0 existe, garde son carrier et ses
    # règles de routage même éteint : s'y fier annoncerait « VPN actif » à tort.
    case "$NET_IF" in
      tun*|tap*|wg*|tailscale*|ppp*|nordlynx|proton*|zt*) NET_VPN=via ;;
    esac
    if [ -z "$NET_VPN" ] && command -v ip >/dev/null 2>&1; then
      ip -4 -o addr show 2>/dev/null | awk '{print $2}' \
        | grep -qE '^(tun|tap|wg|tailscale|ppp|nordlynx|proton|zt)' && NET_VPN=vpn
    fi
    mkdir -p "$(dirname "$_idc")" 2>/dev/null
    printf '%s\t%s\t%s' "$NET_IF" "$NET_NAME" "$NET_VPN" > "$_idc" 2>/dev/null || true
  fi

  # Est-ce que ça PASSE vraiment ? Sonde vers api.anthropic.com plutôt que
  # 8.8.8.8 : même coût, mais une seule mesure répond aux deux questions
  # (Internet ET le service dont dépend tout le travail). JAMAIS bloquante :
  # dernier état connu + rafraîchissement en fond, verrou anti-stampede.
  # THEDEV_NET_PROBE=0 la coupe (machine sans sortie, mesure de coût).
  _pc="${XDG_CACHE_HOME:-$HOME/.cache}/thedev/net-probe"
  _page=99999
  if [ -f "$_pc" ]; then
    _page=$(( $(date +%s) - $(stat -c %Y "$_pc" 2>/dev/null || echo 0) ))
    [ "$(cat "$_pc" 2>/dev/null)" = ko ] && NET_STATE=noinet
  fi
  if [ "${THEDEV_NET_PROBE:-1}" = 1 ] && [ "$_page" -ge 30 ] && command -v curl >/dev/null 2>&1; then
    mkdir -p "$(dirname "$_pc")" 2>/dev/null
    ( flock -n 9 || exit 0
      if curl -s -o /dev/null -m 4 https://api.anthropic.com/ 2>/dev/null; then
        printf 'ok' > "$_pc"
      else
        printf 'ko' > "$_pc"
      fi
    ) 9>"$_pc.lock" >/dev/null 2>&1 &
  fi
fi

RAM=$(ram_pct)
DISKS=()
for m in / /data; do
  { [ "$m" = "/" ] || [ -d "$m" ]; } || continue
  p=$(disk_pct "$m"); [ -n "$p" ] && DISKS+=("$m:$p")
done
LOAD=$(load1)
CLAUDE5H=$(claude-window-usage --pct 2>/dev/null | awk '{print $2}')   # % fenêtre Max 5x (vide si indispo)
# Temps écoulé dans la fenêtre 5h (= 18000s − temps restant avant reset), depuis
# le resets_at du cache → « Xh%02d » (ex. 4h03). Vide si donnée absente.
CLAUDE5H_EL=""
CL_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-window-usage.json"
if [ -n "$CLAUDE5H" ] && [ -f "$CL_CACHE" ] && command -v jq >/dev/null 2>&1; then
  reset_iso=$(jq -r '.five_hour.resets_at // empty' "$CL_CACHE" 2>/dev/null)
  if [ -n "$reset_iso" ]; then
    reset_s=$(date -d "$reset_iso" +%s 2>/dev/null)
    if [ -n "$reset_s" ]; then
      el=$(( 18000 - (reset_s - $(date +%s)) ))
      [ "$el" -lt 0 ] && el=0; [ "$el" -gt 18000 ] && el=18000
      CLAUDE5H_EL=$(printf '%dh%02d' $(( el / 3600 )) $(( (el % 3600) / 60 )))
    fi
  fi
fi

if [ "${1:-}" = "--raw" ]; then
  # En tête : sans réseau, aucune autre jauge ne sert à quelque chose.
  [ -n "$NET_STATE" ] && printf 'NET\t%s\t%s\t%s\t%s\t%s\n' \
    "$NET_STATE" "$NET_PCT" "$NET_NAME" "$NET_VPN" "$NET_SPD"
  [ -n "$CLAUDE5H" ] && printf 'CLAUDE\t5h\t%s\t%s\n' "$CLAUDE5H" "$CLAUDE5H_EL"
  [ -n "$RAM" ] && printf 'RAM\t%s\n' "$RAM"
  for d in "${DISKS[@]}"; do printf 'DISK\t%s\t%s\n' "${d%%:*}" "${d##*:}"; done
  [ -n "$LOAD" ] && printf 'LOAD\t%s\t%s\n' "$LOAD" "$ncpu"
  [ -n "$TEMP" ] && printf 'TEMP\t%s\t%s\t%s\t%s\n' "$TEMP" "$TCRIT" "$FAN" "$TETOUF"
  [ -n "$BAT_PCT" ] && printf 'BAT\t%s\t%s\t%s\n' "$BAT_PCT" "$BAT_ST" "$BAT_TIME"
  [ -n "$BATH" ] && printf 'BATH\t%s\t%s\t%s\t%s\n' "$BATH" "$BATH_FULL" "$BATH_DES" "$BATH_CYC"
  exit 0
fi

# --- bande ANSI (défaut) ---
G=$'\033[1;32m'; Y=$'\033[1;33m'; R=$'\033[1;31m'; D=$'\033[2m'; Z=$'\033[0m'
col_pct() { if   [ "${1:-0}" -lt 70 ] 2>/dev/null; then printf '%s' "$G"
           elif [ "${1:-0}" -lt 88 ] 2>/dev/null; then printf '%s' "$Y"
           else printf '%s' "$R"; fi; }
out=""
add() { [ -n "$out" ] && out+="${D} │ ${Z}"; out+="$1"; }   # colonnes │ ; libellé DIM, valeur COLORÉE

# `--minimal` = HEURE + BATTERIE, rien d'autre. Les jauges détaillées (fenêtre
# Claude, RAM, disque, charge) vivent désormais dans la colonne de gauche du
# front (`sidebar`), où elles sont visibles en permanence pendant le travail : les
# répéter dans la barre du bas ne ferait que charger l'écran.
if [ "${1:-}" = "--minimal" ]; then
  add "${D}$(date +%H:%M)${Z}"
else
  [ -n "$CLAUDE5H" ] && add "${D}\$ ${CLAUDE5H_EL:+$CLAUDE5H_EL/5h }${Z}$(col_pct "$CLAUDE5H")${CLAUDE5H}%${Z}"
  [ -n "$RAM" ] && add "${D}RAM ${Z}$(col_pct "$RAM")${RAM}%${Z}"
  for d in "${DISKS[@]}"; do
    m="${d%%:*}"; p="${d##*:}"
    [ "$m" = "/" ] || continue        # bande compacte : disque racine seulement (/data → écran Infos)
    add "${D}disque ${Z}$(col_pct "$p")${p}%${Z}"
  done
  if [ -n "$LOAD" ]; then
    lc=$(awk -v l="$LOAD" -v n="$ncpu" 'BEGIN{ if(l<n*0.7)print"g"; else if(l<n)print"y"; else print"r" }')
    case "$lc" in g) c=$G;; y) c=$Y;; *) c=$R;; esac
    add "${D}load ${Z}${c}${LOAD}${Z}"
  fi
  if [ -n "$TEMP" ]; then
    # Colorée en % de crit → mêmes bornes 70/88 que toutes les autres jauges thedev.
    if [ "$TETOUF" = 1 ]; then add "${D}chaleur ${Z}${R}${TEMP}° étouffé${Z}"
    else add "${D}chaleur ${Z}$(col_pct "$(( 100 * TEMP / TCRIT ))")${TEMP}°${Z}"; fi
  fi
fi
if [ -n "$BAT_PCT" ]; then
  # Couleurs RÉSERVÉES — même règle que le bandeau de la sidebar : vert = en
  # charge, rouge = batterie faible (<15 %), neutre sinon. Pas de flèche : le
  # temps restant dit déjà le sens.
  bc=""
  if [ "$BAT_ST" = chg ]; then bc=$G
  elif [ "$BAT_PCT" -lt 15 ] 2>/dev/null; then bc=$R; fi
  seg="${D}bat ${Z}${bc}${BAT_PCT}%${Z}"
  [ -n "$BAT_TIME" ] && seg+="${D} ${BAT_TIME}${Z}"
  add "$seg"
fi
printf '%s' "$out"
