#!/usr/bin/env bash
# @thedev session welcome pane of the jobs page (VPS badge)
# jobs-pane — pane d'accueil pour la page `jobs`.
# Affiche un message statique et reste en bash interactif (le pane survit).
# Quand job lance un vrai agent, il pourrait fermer ce pane, mais simplest :
# il reste, juste comme un panneau d'info.

# Sur un serveur distant : le titre du pane devient le marqueur VPS rouge
# (🔴 <label>) au lieu de « welcome » — le 🔴 porte la couleur, zellij ne
# colore pas le texte des titres de pane. No-op en local.
if [ -f "$HOME/.config/dev-vps" ] && [ -n "${ZELLIJ_PANE_ID:-}" ]; then
  vps_label="🔴 $(cat "$HOME/.config/dev-vps")"
  zellij action rename-pane -p "$ZELLIJ_PANE_ID" "$vps_label" 2>/dev/null
  # re-pose différée : un rename au spawn du layout peut être avalé (storm)
  ( sleep 3; zellij action rename-pane -p "$ZELLIJ_PANE_ID" "$vps_label" 2>/dev/null ) &
fi

# Expose l'id de CE pane pour que job puisse le masquer (quand un job tourne)
# et le réafficher (quand la sandbox se vide). Cf. job: hide_welcome/show_welcome.
if [ -n "${ZELLIJ_PANE_ID:-}" ]; then
  mkdir -p "$HOME/.cache"
  printf '%s\n' "$ZELLIJ_PANE_ID" > "$HOME/.cache/jobs-welcome-${ZELLIJ_SESSION_NAME:-default}.id" 2>/dev/null || true
fi

cat <<'EOF'

  ╭───────────────────────────────────────────────────────╮
  │                                                       │
  │   Jobs                                                │
  │                                                       │
  │   This page holds the long-running processes          │
  │   started by the agents (servers, watchers,           │
  │   tests, ...) through the `job` command.              │
  │                                                       │
  │   Right now: empty.                                   │
  │                                                       │
  │   Useful commands:                                    │
  │     job list            # see what is running         │
  │     job kill <name>     # stop a job                  │
  │     job cleanup         # close finished jobs         │
  │                                                       │
  │   You can also run normal shell commands here.        │
  │                                                       │
  ╰───────────────────────────────────────────────────────╯

EOF

# Keep the pane alive with a normal interactive shell
tmprc=$(mktemp)
cat > "$tmprc" <<EOF
[ -f ~/.bashrc ] && . ~/.bashrc
PS1='\[\033[1;35m\][jobs]\[\033[0m\] \W\$ '
rm -f "$tmprc"
EOF

exec bash --rcfile "$tmprc"
