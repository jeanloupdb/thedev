#!/usr/bin/env bash
# @thedev session nvim pane of the agents page
# Same as claude-pane but for nvim. Preloads `nvim <args>` in the fallback
# shell's history so ↑ relaunches the editor.

nvim "$@"

CMD="nvim $*"
tmprc=$(mktemp)
cat > "$tmprc" <<EOF
[ -f ~/.bashrc ] && . ~/.bashrc
history -s "$CMD"
rm -f "$tmprc"
EOF

exec bash --rcfile "$tmprc"
