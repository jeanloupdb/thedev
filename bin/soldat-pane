#!/usr/bin/env bash
# @thedev session lance le soldat principal d'un pane (surcouche prompt, remote-control, auto-open liens)
# Keep the zellij pane alive even if claude exits. On exit, drop into a
# shell with the launch command preloaded in history — press ↑ to relaunch.
#
# Launches claude with:
#   --dangerously-skip-permissions : no permission prompts (zellij dev pane is trusted)
#   --append-system-prompt          : tells claude it can drive the zellij session
#   CLAUDE_CODE_NO_FLICKER=1        : fullscreen rendering — input pinned at bottom,
#                                     stable scrollback, mouse support
#
# Session selection happens UPSTREAM in the `dev` launcher (bash function),
# which exports CLAUDE_RESUME_ID when resuming a chosen conversation. Here we
# just honor it — no picker, to avoid doubling the selection.

# Claude Code pose un titre de terminal (OSC) résumant la conversation. Dans un
# pane zellij ça « fuit » dans le cadre (ex. « My focus and: ») à côté du nom du
# pane → on le désactive (le nom du pane est géré par rename-pane/pane-name).
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1

# Repo thedev résolu depuis l'emplacement RÉEL de ce script (relocatable : marche
# quel que soit l'endroit où thedev est cloné). $0 peut être un nom nu (exec
# soldat-pane) → on le résout via PATH avant readlink. Résolu AVANT le loader :
# thedev-landing est lancé par ce chemin (pas via PATH — les scripts sont exposés
# par symlinks individuels dans ~/.local/bin, un nouveau script n'en a pas forcément).
_self="$0"; case "$_self" in */*) ;; *) _self="$(command -v -- "$_self")" ;; esac
THEDEV_ROOT="$(cd "$(dirname "$(readlink -f -- "$_self")")/.." && pwd)"

# Écran de chargement : le pane reste NOIR le temps du sleep anti-storm + du
# chargement de la conversation par claude. On y met la landing animée (scène
# nature) tant que claude n'a pas pris l'écran. Tuée juste avant le lancement de
# claude (qui bascule en plein écran). Pane interactif seulement (pas les asides
# « once », ouverts à la demande sans attente).
_loader_pid=""
_loader_stop() {
  [ -n "$_loader_pid" ] || return 0
  kill "$_loader_pid" 2>/dev/null; wait "$_loader_pid" 2>/dev/null; _loader_pid=""
  printf '\033[?25h\033[2J\033[H' >/dev/tty 2>/dev/null   # curseur visible + écran net
}
if { [ -z "${CLAUDE_PANE_ONCE:-}" ] || [ -n "${CLAUDE_PANE_LANDING:-}" ]; } && [ -t 1 ]; then
  # Landing thedev (scène nature animée + logo) — externalisée dans thedev-landing,
  # lancée par son chemin réel. Repli spinner minimal si le script manque.
  # CLAUDE_PANE_LANDING=1 force la landing même en mode « once » (ex. chef du cockpit
  # commandement, ouvert ponctuellement mais qui mérite l'animation de chargement).
  if [ -x "$THEDEV_ROOT/bin/thedev-landing" ]; then
    "$THEDEV_ROOT/bin/thedev-landing" >/dev/tty 2>/dev/null &
    _loader_pid=$!
  else
    (
      frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'; i=0
      printf '\033[?25l\033[2J'
      while :; do
        dims=$(stty size </dev/tty 2>/dev/null); l=${dims%% *}; c=${dims##* }
        { [ "$c" -ge 4 ] && [ "$l" -ge 2 ]; } 2>/dev/null || { c=80; l=24; }
        ch=${frames:i:1}; i=$(( (i + 1) % ${#frames} )); text="$ch  thedev"
        col=$(( (c - ${#text}) / 2 )); [ "$col" -lt 1 ] && col=1
        printf '\033[%d;%dH\033[38;5;108m%s\033[0m' "$(( l / 2 ))" "$col" "$text"
        sleep 0.12
      done
    ) >/dev/tty 2>/dev/null &
    _loader_pid=$!
  fi
  trap _loader_stop EXIT
fi

# Delay startup to avoid I/O storm when zellij spawns all panes at once.
# Les soldats secondaires (aside) sont lancés seuls à la demande → pas de storm,
# ouverture directe.
[ -z "${CLAUDE_PANE_ONCE:-}" ] && sleep 2

# (THEDEV_ROOT résolu en tête de script, avant le loader.)
THEDEV_PROMPT_FILE="$THEDEV_ROOT/claude/thedev-prompt.md"
append=""
[ -s "$THEDEV_PROMPT_FILE" ] && append="$(cat "$THEDEV_PROMPT_FILE")"

# NB : l'identité de la machine (qui/où, serveur partagé, périmètre, pièges) n'est
# PAS injectée ici en surcouche — elle vit nativement dans ~/.claude/CLAUDE.md du
# serveur, que TOUTE session Claude lit (dev pane, heartbeat, gateway, claude -p…).
# Voir claude/vps-context/<machine>.md (symlinké vers ~/.claude/CLAUDE.md).

prompt_args=()
[ -n "$append" ] && prompt_args=(--append-system-prompt "$append")

# Message initial (ex. « ajuster la garde » depuis l'etat-major) : passé en
# positionnel à claude → 1er message de la conversation neuve. One-shot (la relance
# manuelle via ↑ rejoue `claude` nu, sans ce prompt). Deux sources : CLAUDE_PANE_INIT
# (inline) ou CLAUDE_PANE_INIT_FILE (chemin — évite le quoting à travers ssh/zellij ;
# le fichier est consommé puis supprimé). Le fichier prime s'il existe.
init_args=()
if [ -n "${CLAUDE_PANE_INIT_FILE:-}" ] && [ -f "$CLAUDE_PANE_INIT_FILE" ]; then
  init_args=("$(cat "$CLAUDE_PANE_INIT_FILE")")
  rm -f "$CLAUDE_PANE_INIT_FILE"
elif [ -n "${CLAUDE_PANE_INIT:-}" ]; then
  init_args=("$CLAUDE_PANE_INIT")
fi

# Resume the conversation picked in `dev`, if any.
resume_args=()
if [ -n "${CLAUDE_RESUME_ID:-}" ]; then
  resume_args=(--resume "$CLAUDE_RESUME_ID")
fi

# Reopen VPS : si la conversation à reprendre tourne ENCORE comme « background
# agent » (--remote-control la garde vivante quand on ferme le pane sans /exit),
# `claude --resume` la refuse (« currently running as a background agent »). Il
# n'existe ni --attach ni `claude agents kill` en CLI → pour RÉCUPÉRER ma conv,
# on tue le(s) bg agent(s) de CE dossier (ou portant l'id à reprendre), puis on
# laisse --resume reprendre le transcript sauvegardé (= reattach). Pane principal
# seulement ; ciblage par cwd/id exact (jamais un motif large).
if [ -n "${CLAUDE_RESUME_ID:-}" ] && [ -z "${CLAUDE_PANE_ONCE:-}" ] && command -v claude >/dev/null 2>&1; then
  # -k 3 : `claude agents --json` peut ignorer le SIGTERM de timeout et rester
  # hung indéfiniment → sans kill-after, le pane reste NOIR au démarrage (jamais
  # de --resume). On escalade en SIGKILL 3 s après le SIGTERM. [[reopen-vps-bg-agent-reclaim]]
  _bg_pids=$(timeout -k 3 8 claude agents --json 2>/dev/null | _CWD="$(pwd -P)" python3 -c '
import sys, json, os
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
rid = os.environ.get("CLAUDE_RESUME_ID", "")
cwd = os.environ.get("_CWD", "")
for a in (data if isinstance(data, list) else []):
    if not isinstance(a, dict) or a.get("kind") != "background":
        continue
    acwd = a.get("cwd", "") or ""
    try:
        acwd = os.path.realpath(acwd) if acwd else ""
    except Exception:
        pass
    if a.get("sessionId") == rid or a.get("id") == rid or (cwd and acwd == cwd):
        pid = a.get("pid")
        if pid:
            print(pid)
' 2>/dev/null)
  if [ -n "$_bg_pids" ]; then
    echo "[reopen] récupération de la conversation : arrêt du background agent ($_bg_pids)…"
    for _p in $_bg_pids; do kill "$_p" 2>/dev/null; done
    sleep 1.5   # laisse le verrou de session se libérer avant le --resume
  fi
fi

# Sur un VPS distant : ajoute le label au titre du pane (« claude [indice] »)
# pour voir d'un coup d'œil qu'on n'est pas en local. rename-pane fixe le nom →
# claude ne peut pas l'écraser via son titre OSC. (Les soldats secondaires sont
# nommés par renfort, pas ici.)
if [ -f "$HOME/.config/dev-vps" ] && [ -z "${CLAUDE_PANE_ONCE:-}" ] && [ -n "${ZELLIJ_PANE_ID:-}" ]; then
  zellij action rename-pane -p "$ZELLIJ_PANE_ID" "claude [$(cat "$HOME/.config/dev-vps")]" 2>/dev/null
fi

# Restauration des soldats secondaires (asides) ouverts avant un « quitter » (kill).
# Le launcher pose DEV_RESTORE=1 sur une reprise (pas sur une session NEUVE) ; on
# relit le registre pour CE dossier et on respawn un aside --resume par soldat
# secondaire. Pane principal uniquement (pas en mode once), une seule fois.
if [ "${DEV_RESTORE:-}" = "1" ] && [ -z "${CLAUDE_PANE_ONCE:-}" ] && command -v reg-soldat >/dev/null 2>&1; then
  _real=$(realpath "$(pwd -P)" 2>/dev/null || pwd -P)
  while IFS=$'\t' read -r _aid _acwd _arole _aname _azs _ast _aen; do
    [ "$_arole" = "aside" ] && [ -n "$_aid" ] || continue
    renfort --resume "$_aid" --name "$_aname" 2>/dev/null
  done < <(reg-soldat restore "$_real" 2>/dev/null)
fi
unset DEV_RESTORE

# Nom du pane transmis au hook SessionStart comme défaut (évite que le hook
# écrase le nom). Pour un aside, renfort l'a déjà posé → on ne touche pas ;
# pour le principal, c'est « claude » (ou « claude [vps] »).
if [ -z "${CLAUDE_PANE_NAME:-}" ]; then
  CLAUDE_PANE_NAME="claude"
  [ -f "$HOME/.config/dev-vps" ] && CLAUDE_PANE_NAME="claude [$(cat "$HOME/.config/dev-vps")]"
fi
export CLAUDE_PANE_NAME

# Sur un VPS distant : on démarre la session AVEC Remote Control activé, pour
# pouvoir la piloter depuis claude.ai/code ou l'app mobile sans rien relancer.
# Le nom exposé = le dossier de dev (l'hôte est ajouté par défaut en préfixe).
# Pane principal seulement (pas les asides « once »). NB : il faut avoir appairé
# l'appareil une fois (claude.ai/code ou app) pour que la session soit pilotable
# — sinon la session interactive marche quand même, juste non exposée.
rc_args=()
# CLAUDE_PANE_RC : marqueur hérité par le hook SessionStart → reg-soldat, pour
# que le registre sache si CE pane est RÉELLEMENT lancé en remote control (l'etat-major
# n'affiche « remote » que dans ce cas). 1 uniquement quand --remote-control est posé.
export CLAUDE_PANE_RC=0
if [ -f "$HOME/.config/dev-vps" ] && [ -z "${CLAUDE_PANE_ONCE:-}" ]; then
  rc_args=(--remote-control "$(basename "$(pwd -P)")")
  CLAUDE_PANE_RC=1
fi

# Sur VPS : auto-open des liens thedev — l'equipe devient joignable par des missions
# dès son démarrage (watcher dans la sandbox), sans avoir à taper `thedev-link open`.
# Pane principal seulement. Délai pour laisser la session/sandbox se mettre en place.
if [ -f "$HOME/.config/dev-vps" ] && [ -z "${CLAUDE_PANE_ONCE:-}" ] && command -v thedev-link >/dev/null 2>&1; then
  ( sleep 6; thedev-link open >/dev/null 2>&1 ) &
fi

# Modèle imposé (ex. mission distante avec Model:) → --model. Vide = défaut de
# la machine (réglage settings.json local).
model_args=()
[ -n "${CLAUDE_PANE_MODEL:-}" ] && model_args=(--model "$CLAUDE_PANE_MODEL")

_loader_stop   # claude prend l'écran → on retire le spinner de chargement

# Un appelant (ex. le driver du cockpit commandement) peut demander le PID du soldat
# pour pouvoir le cibler ensuite (bascule de chef) : $$ survit à l'exec ci-dessous →
# c'est le PID de claude lui-même.
[ -n "${CLAUDE_PANE_PIDFILE:-}" ] && printf '%s\n' "$$" > "$CLAUDE_PANE_PIDFILE" 2>/dev/null

CLAUDE_CODE_NO_FLICKER=1 claude \
  --dangerously-skip-permissions \
  "${rc_args[@]}" \
  "${model_args[@]}" \
  "${prompt_args[@]}" \
  "${resume_args[@]}" \
  "${init_args[@]}" \
  "$@"

# Mode "once" (soldat secondaire via `aside`) : pas de keep-alive → le pane se
# ferme dès que tu quittes Claude (/exit), combiné à `zellij run --close-on-exit`.
[ -n "${CLAUDE_PANE_ONCE:-}" ] && exit 0

CMD="CLAUDE_CODE_NO_FLICKER=1 claude --dangerously-skip-permissions $*"
tmprc=$(mktemp)
cat > "$tmprc" <<EOF
[ -f ~/.bashrc ] && . ~/.bashrc
history -s "$CMD"
rm -f "$tmprc"
EOF

echo
echo "[claude terminé — ↑ pour relancer]"
exec bash --rcfile "$tmprc"
