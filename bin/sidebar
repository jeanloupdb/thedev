#!/usr/bin/env python3
# @thedev session sidebar — colonne gauche du front : menu cliquable (accueil, files, soldats, sessions…)
"""sidebar — la colonne de gauche de « le front ».

Menu cliquable ET clavier, dans une colonne étroite (~20 % de l'écran, ~35
colonnes). Elle y est SEULE : à cette largeur nvim était inéditable, donc un
fichier s'ouvre en plein écran (pane flottant) plutôt que dans la colonne.

Écran d'accueil — sept entrées, chacune à la fois bouton et état lisible :

    󰋜  accueil            ouvre le modal Ctrl+Q (détacher / fermer)
    󰉋  files              arbre du dossier courant
    󰚩  soldats      2 ⚠1  les soldats de l'équipe
    󰕰  sessions           les équipes récentes
    󰋽  infos              page « infos » de l'accueil, en plein écran
    󰑐  automatisations    page « la garde », en plein écran
    󰐕  soldat             ajoute un soldat aside

Les icônes viennent de la Nerd Font du terminal (set Material Design, nf-md-*) :
une seule famille, même graisse partout — pas d'Unicode « divers » dont chaque
glyphe tombe dans une fonte de fallback différente.

Les listes ne se déplient PAS sous le menu : elles REMPLACENT la colonne, seules,
et la première entrée devient « 󰁍 retour ». Une colonne étroite ne supporte pas
deux niveaux à l'écran en même temps. Même raison pour les choix : ouvrir une
equipe passe par une MODALE (lignes sélectionnables + annuler), pas un dépliage.

La liste des soldats sépare ceux qui occupent VRAIMENT un pane à droite (leur
nom apparaît dans le layout courant) de ceux « à réveiller » — conversations
sans pane, en atténué, qu'un Entrée rouvre en `--resume`. Elle se rafraîchit
toute seule : la colonne vit des heures, un état figé au démarrage ment vite.

Le bandeau de ressources (fenêtre Claude, RAM, disque, charge, chaleur, batterie)
est en bas, TOUJOURS visible, quelle que soit la vue. Source unique :
`thedev-metrics`. La chaleur s'y lit en degrés — la couleur suffit à dire si le
chiffre est bon, un adjectif n'ajouterait rien. Elle bascule sur « étouffé » quand
la machine est chaude SANS travailler : le PC posé sur un lit, qui se bride et cuit
sa batterie. Le détail (ventilateur, bridages subis) est sur la page « infos ».

Le surlignage n'existe QUE quand le pane a le focus. Une ligne allumée dit « je
t'écoute » : la garder allumée pendant que l'utilisateur tape chez un soldat
promet une touche qui n'arrivera pas, et deux curseurs à l'écran font douter de
celui qui répond. La position est conservée — elle se rallume telle quelle au
retour. Mécanique : mode ?1004, zellij envoie CSI I / CSI O (cf. _focus_seq).

La colonne ne confirme RIEN par écrit : ouvrir un fichier, une page ou un soldat
se voit à l'écran, l'annoncer en plus est du bruit. Une ligne n'apparaît en bas
que si quelque chose a ÉCHOUÉ.

MODE PROTOTYPE (défaut) : navigation, données et rendu sont RÉELS ; `infos` et
`automatisations` s'ouvrent pour de bon (un pane flottant ne touche pas la
session). Les actions qui frapperaient la session — détacher, tuer, attacher —
sont seulement AFFICHÉES : la sidebar tourne dans « le camp », un vrai `detach`
détacherait l'utilisateur. `--live` exécute tout (une fois posée dans le front).

Clavier : ↑/↓ naviguer · Entrée activer · Échap revenir d'un cran · q quitter
          Échap ne QUITTE jamais : la colonne est permanente dans le front.
          → sort de la colonne (vers les soldats) — il n'active RIEN
Souris  : clic = activer.
"""
import curses
import json
import os
import re
import subprocess
import tempfile
import threading
import time
import unicodedata

# Largeur simulée de la colonne gauche. Dans « le camp » le pane est large ; on
# dessine quand même dans une bande étroite pour juger le VRAI rendu du front.
BAND = 38

# Habillage d'activité posé sur le TITRE du pane par `pane-pulse` (◆ plein ↔ ◇ creux,
# alternés pendant qu'un soldat répond). Jamais une partie du nom : le registre stocke
# le nom nu, donc tout rapprochement layout ↔ registre doit le retirer d'abord.
PULSE_RE = re.compile(r"^[◆◇]\s+")

IGNORE = {".git", "node_modules", "__pycache__", ".next", ".venv", "target", ".cache"}


def dwidth(s):
    """Largeur d'affichage en CELLULES, pas en caractères.

    Indispensable pour avancer le curseur : « ＋ » (U+FF0B, fullwidth) occupe
    2 cellules mais compte pour 1 en `len()` — sans ça le segment suivant
    s'écrit par-dessus la moitié droite du glyphe."""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def sh(cmd, timeout=6):
    """Commande shell → stdout (vide si échec). Jamais d'exception qui remonte."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout).stdout
    except Exception:
        return ""


def equipe_name():
    """Nom de l'équipe = session zellij, sinon dossier courant."""
    n = os.environ.get("ZELLIJ_SESSION_NAME", "").strip()
    if n:
        return n
    for line in sh(["zellij", "list-sessions", "--no-formatting"], 2).splitlines():
        if "(current)" in line:
            return line.split()[0]
    return os.path.basename(os.getcwd()) or "?"


def equipe_cwd(sess, fallback):
    """Dossier de l'EQUIPE, pas simplement `getcwd()`.

    Tout ce que la colonne montre (soldats présents, soldats à réveiller, arbre
    des fichiers) est relatif à un dossier. Le prendre du process est fragile :
    lancée depuis ailleurs — un pane du camp, un shell — la colonne afficherait
    les soldats d'un AUTRE projet, ce qui se lit comme une liste globale.
    On le déduit donc du registre : le dossier de la session zellij courante,
    d'après le soldat le plus récemment démarré. Repli sur `getcwd()` si
    l'equipe n'a encore aucun soldat inscrit."""
    if not sess:
        return fallback
    best, best_t = "", -1
    try:
        with open(os.path.expanduser("~/.cache/soldats")) as f:
            lines = f.read().splitlines()
    except OSError:
        return fallback
    for line in lines:
        p = line.split("\t")
        if len(p) < 6 or p[4] != sess:
            continue
        try:
            t = int(p[5])
        except ValueError:
            continue
        if t > best_t:
            best, best_t = p[1], t
    if not best:
        return fallback
    try:
        return os.path.realpath(best)
    except OSError:
        return fallback


def fresh_sids(path, max_age=1800):
    """Ids de soldats marqués dans un répertoire-drapeau, encore frais (mtime)."""
    out, now = set(), time.time()
    try:
        with os.scandir(os.path.expanduser(path)) as it:
            for e in it:
                try:
                    if now - e.stat().st_mtime < max_age:
                        out.add(e.name)
                except OSError:
                    pass
    except OSError:
        pass
    return out


def live_pane_names():
    """Noms des panes RÉELLEMENT ouverts dans la session (via le layout courant).

    C'est la seule vérité terrain sur « qui occupe un pane ». Le champ `ended`
    du registre ment dans les deux sens : un soldat tué net garde `ended == 0`,
    et un SessionEnd parasite (compactage, relance) marque terminé un soldat
    bien vivant. On lit donc le layout, en retirant le losange du pulse : c'est un
    habillage d'activité, pas une partie du nom.

    Les DEUX glyphes comptent. `pane-pulse` alterne ◆ et ◇ toutes les ~0,7 s pendant
    qu'un soldat répond ; n'en retirer qu'un fait échouer le rapprochement une frame
    sur deux, et le soldat le plus actif de l'équipe clignote entre « ouverts » et
    « à réveiller ». Le registre, lui, ne stocke que le nom NU (cf. pane-name).

    Renvoie None si le layout est illisible — l'appelant retombe alors sur
    `ended`, imparfait mais toujours mieux que rien."""
    out = sh(["zellij", "action", "dump-layout"], 8)
    if not out:
        return None
    names = []
    for m in re.finditer(r'name="((?:[^"\\]|\\.)*)"', out):
        names.append(PULSE_RE.sub("", m.group(1)))
    return names


def load_soldats(cwd, sess="", dormant_max=12):
    """Soldats de cette équipe, en deux groupes → (actifs, inactifs).

    Registre = ~/.cache/soldats (TSV : id cwd role nom session started ended rc).

    ACTIF   = son nom de pane est présent dans le layout courant — donc il
              occupe vraiment un pane à droite. L'état vient des marqueurs des
              hooks : waiting (il t'attend sur un QCM) prime sur busy.
    INACTIF = conversation sans pane : elle existe toujours et peut être
              RÉVEILLÉE (--resume). Les plus récentes d'abord, bornées :
              l'historique d'un vieux projet ferait sinon une liste sans fin.

    Le rapprochement se fait avec MULTIPLICITÉ (un pane consommé une fois) :
    deux conversations peuvent s'appeler « claude », une seule est ouverte."""
    busy, wait = fresh_sids("~/.cache/soldat-busy"), fresh_sids("~/.cache/soldat-waiting")
    rows = []
    try:
        with open(os.path.expanduser("~/.cache/soldats")) as f:
            lines = f.read().splitlines()
    except OSError:
        return [], []
    for line in lines:
        p = line.split("\t")
        if len(p) < 7:
            continue
        try:
            if os.path.realpath(p[1]) != cwd:
                continue
        except OSError:
            continue
        # …ET de CETTE équipe. Le dossier ne suffit pas : un `claude` lancé à la main
        # depuis la tente, ou une mission entrante, travaille dans le même répertoire
        # sans avoir jamais fait partie de l'équipe. Sa place est dans l'écran
        # « sessions », qui recense toutes les conversations de la machine — pas ici,
        # où la liste répond à « qui est, ou a été, de cette équipe ». Filtre levé si
        # l'équipe est inconnue (sidebar lancée hors zellij), sinon on masquerait tout.
        if sess and p[4] != sess:
            continue
        try:
            started, ended = int(p[5]), int(p[6])
        except ValueError:
            started, ended = 0, 0
        rows.append({"sid": p[0], "role": p[2], "name": p[3] or "claude",
                     "sess": p[4], "started": started, "ended": ended})
    # Le plus récemment démarré d'abord : c'est lui qui doit récupérer le pane
    # quand plusieurs conversations portent le même nom.
    rows.sort(key=lambda r: -r["started"])
    panes = live_pane_names()
    pool = {}
    for n in (panes or []):
        pool[n] = pool.get(n, 0) + 1
    actifs, dormants = [], []
    for r in rows:
        if panes is None:                      # layout illisible → repli sur `ended`
            live = r["ended"] == 0 and (not sess or r["sess"] == sess)
        else:
            live = pool.get(r["name"], 0) > 0
            if live:
                pool[r["name"]] -= 1
        if live:
            state = ("waiting" if r["sid"] in wait else
                     ("busy" if r["sid"] in busy else "idle"))
            actifs.append((r["name"], r["role"], state, r["sid"]))
        else:
            dormants.append((r["name"], r["role"], r["ended"] or r["started"], r["sid"]))
    # Une conversation qui redémarre (reprise, relance de l'équipe, compactage) reçoit
    # un NOUVEAU session id. Le registre accumule donc plusieurs entrées pour un même
    # pane, chacune portant le nom que le pane avait à ce moment-là — un soldat renommé
    # deux fois laissait quatre lignes « à réveiller » qui sont ses propres vies
    # antérieures, pas des conversations à part entière.
    # D'où : une seule entrée par pane, la plus récente. Et AUCUNE si un soldat vivant
    # occupe ce pane — c'est lui, la conversation, les autres n'en sont que des traces.
    # Rien n'est perdu : l'écran « sessions » liste toutes les conversations, lui.
    # La clé est le pane ET la session zellij, pas le pane seul : zellij renumérote
    # ses panes à partir de zéro à chaque session, donc deux conversations sans
    # rapport se retrouvent « pane 6 » et fusionneraient à tort.
    panes_pris = {soldat_ancre(sid) for _, _, _, sid in actifs}
    panes_pris.discard("")
    vus, uniques = set(), []
    for d in sorted(dormants, key=lambda d: -d[2]):
        p = soldat_ancre(d[3])
        if p:
            if p in panes_pris or p in vus:
                continue
            vus.add(p)
        uniques.append(d)
    return actifs, uniques[:dormant_max]


def soldat_ancre(sid):
    """« pane + session zellij » d'un soldat — l'emplacement qu'il occupait, unique
    dans le temps là où `soldat_pane` seul ne l'est pas (les panes sont renumérotés
    à chaque session). Sert à reconnaître les entrées de registre qui décrivent le
    MÊME emplacement, donc la même conversation reprise. Vide si jamais vu."""
    try:
        with open(os.path.expanduser("~/.cache/soldat-panes/%s" % sid)) as f:
            return f.read().strip()
    except OSError:
        return ""


def soldat_pane(sid):
    """Pane id d'un soldat (marqueur posé au SessionStart par soldat-track,
    rafraîchi par pane-name). Vide s'il n'a pas encore été vu."""
    try:
        with open(os.path.expanduser("~/.cache/soldat-panes/%s" % sid)) as f:
            return f.read().split("\t")[0].strip()
    except OSError:
        return ""


def fmt_age(mtime):
    """Âge relatif compact (≤ 6 car.), repris tel quel de l'accueil pour que les
    deux écrans se lisent pareil."""
    d = max(0, int(time.time() - mtime))
    if d < 60:
        return "now"
    if d < 3600:
        return "%dm" % (d // 60)
    if d < 86400:
        return "%dh" % (d // 3600)
    return "%dj" % (d // 86400)


def epoch(iso):
    """ISO 8601 → epoch. 0 si illisible (la ligne passe alors en fin de tri)."""
    try:
        return time.mktime(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return 0.0


def clean_title(t):
    """Titre lisible : les transcripts commencent parfois par une balise injectée
    par le harness (<local-command-caveat>, <system-reminder>…) — on la coupe."""
    t = t.strip()
    while t.startswith("<"):
        end = t.find(">")
        if end < 0:
            return ""
        t = t[end + 1:].strip()
    return " ".join(t.split())


def load_sessions(limit=30):
    """Sessions récentes, via la façade moteur (jamais les transcripts en direct).

    On passe par `engine list --all --json` : c'est le point d'abstraction qui
    évite à la sidebar de connaître le format de Claude Code (cf. ENGINE-COUPLING)."""
    engine = os.path.join(os.path.dirname(os.path.realpath(__file__)), "engine")
    rows = []
    for line in sh([engine, "list", "--all", "--json"], 25).splitlines():
        try:
            d = json.loads(line)
        except Exception:
            continue
        cwd = d.get("cwd") or ""
        # On ne garde que de VRAIS projets : pas les équipes de service (chefs du
        # commandement), pas les scratchpads jetables, pas les dossiers disparus.
        if "/.cache/thedev/" in cwd or "/scratchpad" in cwd or cwd.startswith("/tmp/"):
            continue
        if not os.path.isdir(cwd):
            continue
        rows.append({"id": d.get("id", ""), "cwd": os.path.realpath(cwd),
                     "mtime": epoch(d.get("mtime", "")),
                     "title": clean_title(d.get("title") or ""),
                     "name": os.path.basename(cwd) or cwd})
    rows.sort(key=lambda r: r["mtime"], reverse=True)
    # Une seule entrée par dossier : la plus récente.
    seen, uniq = set(), []
    for r in rows:
        if r["cwd"] in seen:
            continue
        seen.add(r["cwd"])
        uniq.append(r)
        if len(uniq) >= limit:
            break
    return uniq


def live_sessions():
    """Noms des sessions zellij actuellement vivantes (marqueur ●)."""
    names = set()
    for line in sh(["zellij", "list-sessions", "--no-formatting"], 2).splitlines():
        if line.strip() and "EXITED" not in line:
            names.add(line.split()[0])
    return names


def listdir(path):
    """Contenu d'un dossier, dossiers d'abord, bruit filtré."""
    try:
        ents = [e for e in os.scandir(path) if not e.name.startswith(".")
                and e.name not in IGNORE]
    except OSError:
        return []
    ents.sort(key=lambda e: (not e.is_dir(), e.name.lower()))
    return ents


def parse_metrics(out):
    """Sortie TSV de `thedev-metrics --raw` → liste de tuples typés.
    Même découpage que l'accueil : une seule source pour les deux écrans."""
    m = []
    for ln in out.splitlines():
        p = ln.split("\t")
        try:
            if p[0] == "NET" and len(p) >= 2:
                # (état ok|noinet|down, signal %, nom du réseau, vpn, débit Mb/s)
                m.append(("NET",) + tuple(
                    (p[i] if len(p) > i else "") for i in range(1, 6)))
            elif p[0] == "CLAUDE" and len(p) >= 3:
                m.append(("CLAUDE", p[1], int(p[2]), p[3] if len(p) >= 4 else ""))
            elif p[0] == "RAM" and len(p) >= 2:
                m.append(("RAM", int(p[1])))
            elif p[0] == "DISK" and len(p) >= 3:
                m.append(("DISK", p[1], int(p[2])))
            elif p[0] == "LOAD" and len(p) >= 3:
                m.append(("LOAD", float(p[1]), int(p[2])))
            elif p[0] == "TEMP" and len(p) >= 5:
                # (T °C, T critique, ventilateur tr/min ou 0, étouffé)
                m.append(("TEMP", int(p[1]), int(p[2]),
                          int(p[3]) if p[3] else 0, p[4] == "1"))
            elif p[0] == "BAT" and len(p) >= 2:
                m.append(("BAT", int(p[1]), p[2] if len(p) >= 3 else "",
                          p[3] if len(p) >= 4 else ""))
        except ValueError:
            continue
    return m


class Sidebar:
    # (touche, icône, libellé, id d'action)
    # (icône, libellé, id d'action, raccourci global). Pas de numéro : sept
    # entrées se pointent à la souris ou se parcourent aux flèches, un chiffre
    # devant n'aide pas. Le raccourci, lui, est rappelé à droite quand l'entrée
    # est AUSSI joignable au clavier depuis n'importe où dans thedev.
    # Icônes : Nerd Font (set Material Design, nf-md-*) — UNE seule famille,
    # même graisse et même taille partout, là où l'Unicode « divers » mélangeait
    # des glyphes de blocs différents rendus par des fontes de fallback
    # disparates. La fonte du terminal les embarque déjà (cf. barre zjstatus).
    ENTRIES = [
        ("󰋜", "accueil",         "accueil",  "ctrl q"),   # nf-md-home
        ("󰉋", "files",           "files",    ""),         # nf-md-folder
        ("󰚩", "soldats",         "soldats",  ""),         # nf-md-robot
        ("󰕰", "sessions",        "sessions", ""),         # nf-md-view-grid
        ("󰋽", "infos",           "infos",    "alt i"),    # nf-md-information-outline
        ("󰑐", "automatisations", "autos",    ""),         # nf-md-refresh
        ("󰐕", "soldat",          "aside",    ""),         # nf-md-plus
    ]
    VIEWS = {"files": "󰉋 files", "soldats": "󰚩 soldats", "sessions": "󰕰 sessions"}

    def __init__(self, scr, live=False):
        self.scr = scr
        self.live = live
        self.equipe = equipe_name()
        self.cwd = equipe_cwd(self.equipe, os.path.realpath(os.getcwd()))
        self.sel = 0
        self.off = 0            # première ligne visible (défilement)
        self.view = None        # None = menu ; sinon files | soldats | sessions
        self.status = ""
        self.expanded = set()   # dossiers dépliés dans l'arbre files
        self.modal = None       # modale de choix ouverte (dict title/opts/sess) ou None
        self.sessions = None    # None = pas encore chargé (thread)
        self.soldats, self.dormants = load_soldats(self.cwd, self.equipe)
        self.live_names = live_sessions()
        self.metrics = None
        self.stop = threading.Event()
        self.rows = []
        self.band = BAND        # largeur de dessin réelle, posée par draw()
        # Le surlignage ne s'affiche QUE si le pane a le focus : une colonne qui
        # garde une ligne allumée pendant qu'on tape ailleurs prétend attendre
        # une touche qui n'arrivera pas. Faux au démarrage : dans « le front »
        # c'est le soldat qui a le focus, et zellij nous enverra CSI I si on
        # l'obtient (cf. _focus_seq).
        self.focused = False
        self._pending = []      # octets relus après un ESC non consommé
        self._focus_keys()
        self._colors()
        threading.Thread(target=self._metrics_worker, daemon=True).start()

    def _focus_keys(self):
        """Retrouve les codes que ncurses donne à la prise/perte de focus.

        Le terminfo xterm* décrit ces séquences (kxIN=\\E[I, kxOUT=\\E[O), donc
        ncurses les reconnaît lui-même et rend une touche — mais une touche
        ÉTENDUE, sans constante KEY_* : son numéro est attribué à l'exécution
        (590/591 ici, rien ne le garantit ailleurs). On le retrouve par son nom.
        Introuvable = terminfo sans ces capacités : les séquences arriveront
        alors brutes et c'est _focus_seq qui les rattrape après l'ESC."""
        self.KIN = self.KOUT = None
        for c in range(256, 1024):
            try:
                n = curses.keyname(c)
            except Exception:
                continue
            if n == b"kxIN":
                self.KIN = c
            elif n == b"kxOUT":
                self.KOUT = c

    def _colors(self):
        curses.use_default_colors()
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        for i, fg in enumerate((curses.COLOR_GREEN, curses.COLOR_CYAN,
                                curses.COLOR_MAGENTA, curses.COLOR_YELLOW,
                                curses.COLOR_BLUE, curses.COLOR_RED), 1):
            curses.init_pair(i, fg, -1)
        (self.GREEN, self.CYAN, self.MAG, self.YEL,
         self.BLUE, self.RED) = (curses.color_pair(i) for i in range(1, 7))
        # Ligne sélectionnée = un FOND, pas une inversion vidéo. L'inversion
        # écraserait la couleur des noms de session ; ici on re-décline chaque
        # couleur de la palette sur ce fond (paires 21-26) et on garde donc le
        # code couleur intact SOUS le surlignage. Repli A_REVERSE en 8 couleurs.
        self.SEL = curses.A_REVERSE
        self.SELPAIR = {}
        if curses.COLORS >= 256:
            try:
                curses.init_pair(7, 252, 237)
                self.SEL = curses.color_pair(7)
                for i, fg in enumerate((curses.COLOR_GREEN, curses.COLOR_CYAN,
                                        curses.COLOR_MAGENTA, curses.COLOR_YELLOW,
                                        curses.COLOR_BLUE, curses.COLOR_RED), 1):
                    curses.init_pair(20 + i, fg, 237)
                    self.SELPAIR[i] = curses.color_pair(20 + i)
            except curses.error:
                self.SELPAIR = {}
        self.DIM = curses.A_DIM
        # Couleur stable par projet — MÊME palette et MÊME hash que l'accueil,
        # pour qu'une équipe garde sa couleur d'un écran à l'autre.
        self.PALETTE = [self.CYAN, self.MAG, self.YEL, self.BLUE, self.RED, self.GREEN]

    def pcolor(self, name):
        return self.PALETTE[sum(name.encode("utf-8")) % len(self.PALETTE)]

    def sel_attr(self, a):
        """Le même segment, reposé sur le fond de la ligne sélectionnée.

        On récupère la paire de couleurs d'origine (`pair_number`) pour lui
        substituer sa déclinaison « sur fond de sélection », en conservant le
        gras. Sans ça, le fond effacerait la couleur du nom."""
        return self.SELPAIR.get(curses.pair_number(a), self.SEL) | (a & curses.A_BOLD)

    def gcol(self, p):
        """Couleur d'une jauge par sévérité — même seuils que l'accueil."""
        return self.GREEN if p < 70 else (self.YEL if p < 88 else self.RED)

    # ---------- données de fond ----------

    def _metrics_worker(self):
        # Bandeau du bas + liste des soldats, rafraîchis en continu. La colonne
        # vit des heures dans le front : lus une seule fois au démarrage, ces
        # deux états divergeaient de la réalité sans qu'on s'en aperçoive (un
        # soldat ouvert depuis affiché « à réveiller », un soldat fermé toujours
        # listé présent). `thedev-metrics` lit /proc et un cache, `dump-layout`
        # fait ~30 ko en 0,1 s : les deux sont assez légers pour ce rythme.
        while not self.stop.is_set():
            m = parse_metrics(sh(["thedev-metrics", "--raw"], 5))
            if m:
                self.metrics = m
            try:
                self.soldats, self.dormants = load_soldats(self.cwd, self.equipe)
                self.live_names = live_sessions()
            except Exception:
                pass
            if self.stop.wait(3):
                break

    def _load_sessions(self):
        self.sessions = load_sessions()

    # ---------- construction des lignes ----------

    def build(self):
        """Reconstruit la liste plate des lignes affichées.

        Chaque ligne = (segments, action). `action` None = ligne décorative (non
        sélectionnable). C'est cette liste qui sert AUSSI au clic : y → index."""
        R = []
        if self.modal:
            R = self.rows_modal()
        elif self.view is None:
            R.append(([("  ", 0), (self.equipe, curses.A_BOLD)], None))
            R.append(([("", 0)], None))
            for icon, label, act, key in self.ENTRIES:
                segs = [("  ", 0), ("%s " % icon, self.CYAN), (label, 0)]
                segs.extend(self.badge(act))
                if key:
                    # Le raccourci est collé au bord droit : il se lit comme une
                    # colonne, sans décaler les libellés entre eux.
                    pad = self.band - 1 - sum(dwidth(t) for t, _ in segs) - dwidth(key)
                    if pad > 1:
                        segs.append((" " * pad, 0))
                        segs.append((key, self.DIM))
                R.append((segs, ("entry", act)))
        else:
            # Vue liste : la colonne est prise entièrement par la liste, et la
            # première entrée devient le retour. Le titre rappelle où on est.
            R.append(([("  ", 0), ("󰁍 retour", 0),
                       ("   " + self.VIEWS[self.view], self.DIM)], ("back", None)))
            R.append(([("", 0)], None))
            R.extend(getattr(self, "rows_" + self.view)())
        self.rows = R

    def badge(self, act):
        """Le badge qui rend le bouton informatif — l'état sans cliquer."""
        if act == "soldats":
            n = len(self.soldats)
            if not n:
                return []
            segs = [("  %d" % n, self.DIM)]
            # Même règle que la liste : on ne compte QUE ce qui demande une action.
            w = sum(1 for s in self.soldats if s[2] == "waiting")
            if w:
                segs.append((" ⚠%d" % w, self.CYAN | curses.A_BOLD))
            return segs
        if act == "sessions" and self.sessions:
            return [("  %d" % len(self.sessions), self.DIM)]
        return []

    def rows_soldats(self):
        R = []
        for name, role, state, sid in self.soldats:
            # Pas de losange d'activité ici : que tel soldat soit en train de
            # répondre n'appelle AUCUN geste, et le marqueur bougeait sans arrêt
            # dans une liste qu'on lit pour choisir où aller. Le seul état qui
            # mérite un signe est celui qui demande quelque chose — « t'attend » —
            # et il porte le ⚠ du badge, pas un losange de plus.
            dot, col = (("⚠", self.CYAN | curses.A_BOLD) if state == "waiting"
                        else ("·", self.DIM))
            R.append(([("  %s " % dot, col), (name[:BAND - 12], 0)]
                      + ([("  aside", self.DIM)] if role == "aside" else []),
                      ("soldat", sid)))
        if not R:
            R.append(([("  aucun soldat ouvert", self.DIM)], None))
        # Ajouter et réveiller sont les deux façons d'avoir un soldat de plus :
        # elles se suivent, juste après les présents. Placé ICI et pas en fin de
        # liste, sinon douze conversations dormantes le repoussent hors écran.
        R.append(([("", 0)], None))
        R.append(([("  ", 0), ("󰐕", self.GREEN), (" ajouter un soldat", 0)],
                  ("entry", "aside")))
        # Les conversations terminées de cette equipe : plus de pane, mais elles
        # existent toujours. Tout en atténué — ce sont des soldats qu'on PEUT
        # réveiller, pas des soldats présents. Ne pas les confondre d'un coup
        # d'œil est tout l'intérêt de les séparer.
        if self.dormants:
            R.append(([("", 0)], None))
            R.append(([("  à réveiller", self.DIM)], None))
            for name, role, ended, sid in self.dormants:
                segs = [("    ", 0), (name[:BAND - 12], self.DIM)]
                if ended:
                    segs.append(("  " + fmt_age(ended), self.DIM))
                R.append((segs, ("wake", (sid, name))))
        return R

    def rows_files(self):
        """Arbre du dossier courant, dépliable. Un fichier s'ouvre dans nvim."""
        R = []

        def walk(path, depth):
            if depth > 4:
                return
            for e in listdir(path):
                pad = "  " + "  " * depth
                if e.is_dir():
                    o = e.path in self.expanded
                    R.append(([(pad + ("▾ " if o else "▸ "), self.DIM),
                               (e.name[:BAND - len(pad) - 3], self.BLUE)],
                              ("dir", e.path)))
                    if o:
                        walk(e.path, depth + 1)
                else:
                    R.append(([(pad + "  ", 0),
                               (e.name[:BAND - len(pad) - 3], 0)],
                              ("file", e.path)))
        walk(self.cwd, 0)
        return R or [([("  (vide)", self.DIM)], None)]

    def rows_sessions(self):
        if self.sessions is None:
            return [([("  chargement…", self.DIM)], None)]
        if not self.sessions:
            return [([("  aucune session", self.DIM)], None)]
        R = []
        for i, s in enumerate(self.sessions):
            here = s["cwd"] == self.cwd
            live = s["name"] in self.live_names
            dot = ("● ", self.GREEN | curses.A_BOLD) if live else ("  ", 0)
            # Seule reprise de l'accueil : la COULEUR DU NOM — cyan gras si
            # l'équipe est ouverte, sinon la couleur stable du projet. Même
            # palette et même hash, donc une équipe garde sa couleur d'un
            # écran à l'autre.
            R.append(([("  ", 0), dot,
                       (s["name"][:BAND - 10], (self.CYAN | curses.A_BOLD) if live
                        else self.pcolor(s["name"])),
                       ("  " + fmt_age(s["mtime"]), self.DIM)],
                      None if here else ("sess", i)))
        return R

    OPEN_MODES = (
        ("ouvrir ici",          "la courante reste vivante"),
        ("ouvrir ici + fermer", "tue la courante"),
        ("nouvelle instance",   "session détachée à part"),
    )

    def rows_modal(self):
        """Modale de choix : lignes sélectionnables + annuler.

        Elle REMPLACE le contenu de la colonne au lieu de se déplier sous la
        session — dans 35 colonnes, une liste imbriquée devient illisible, et on
        perd de vue ce qu'on est en train de choisir."""
        m = self.modal
        R = [([("  ", 0), (m["title"][:BAND - 4], curses.A_BOLD)], None),
             ([("", 0)], None)]
        for j, (lab, hint) in enumerate(m["opts"]):
            R.append(([("  ", 0), (lab, self.GREEN)], ("choose", j)))
            R.append(([("    " + hint, self.DIM)], None))
        R.append(([("", 0)], None))
        R.append(([("  ", 0), ("annuler", self.DIM)], ("choose", None)))
        return R

    def net_row(self, state, pct, name, vpn, spd):
        """La ligne réseau : « à quoi je suis connecté » à gauche, « est-ce que
        ça passe » à droite.

        Le NOM du réseau tient le libellé — savoir qu'on est sur le partage de
        connexion d'un téléphone plutôt que sur la box change ce qu'on lance. Le
        VPN s'y colle en un mot : « vpn » quand il est monté (accès seulement),
        « via vpn » quand il porte la route par défaut, donc que TOUT le trafic
        sort par là.

        La valeur est un STATUT (bon · faible · mauvais · sans internet · hors
        ligne), jamais une mesure : le signal en % ou en dBm oblige à connaître
        l'échelle avant de savoir s'il faut s'inquiéter. Les chiffres bruts
        (dBm, débit négocié du lien) restent dans `thedev-metrics` pour la page
        « infos », où on a la place de les expliquer."""
        if state == "down":
            return [("réseau", "hors ligne", self.RED)]
        lab = name or "réseau"
        if dwidth(lab) > 18:                      # un SSID peut être très long
            while lab and dwidth(lab) > 17:
                lab = lab[:-1]
            lab += "…"
        lab += " via vpn" if vpn == "via" else (" vpn" if vpn else "")
        if state == "noinet":
            return [(lab, "sans internet", self.RED)]
        # Un STATUT, pas un chiffre : « 40 % » demande de savoir à quoi 40 %
        # correspond, alors que la seule question est « est-ce que ça passe ? ».
        # Un seul vocabulaire tient donc toute l'échelle, du bon au rien — et la
        # couleur redit la même chose sans avoir à lire le mot.
        # Bornes converties depuis l'échelle radio (% = 2×(dBm+100), formule de
        # NetworkManager) : bon ≥ −70 dBm · faible jusqu'à −80 · mauvais en
        # dessous, là où ça décroche. En filaire il n'y a pas de signal — un lien
        # négocié qui répond est « bon ».
        if pct.isdigit():
            p = int(pct)
            if p >= 60:
                return [(lab, "bon", self.GREEN)]
            if p >= 40:
                return [(lab, "faible", self.YEL)]
            return [(lab, "mauvais", self.RED)]
        return [(lab, "bon", self.GREEN)]

    def metrics_rows(self):
        """Bandeau du bas : une ressource par ligne, valeur alignée à droite.
        Toujours affiché — c'est le point de la colonne : voir sans demander."""
        if not self.metrics:
            return []
        out = []
        for it in self.metrics:
            if it[0] == "NET":
                out.extend(self.net_row(*it[1:]))
            elif it[0] == "CLAUDE":
                win, p, el = it[1], it[2], it[3]
                out.append(("claude %s" % (("%s/%s" % (el, win)) if el else win),
                            "%d%%" % p, self.gcol(p)))
            elif it[0] == "RAM":
                out.append(("RAM", "%d%%" % it[1], self.gcol(it[1])))
            elif it[0] == "DISK" and it[1] == "/":
                out.append(("disque", "%d%%" % it[2], self.gcol(it[2])))
            elif it[0] == "LOAD":
                v, n = it[1], it[2]
                c = self.GREEN if v < n * 0.7 else (self.YEL if v < n else self.RED)
                out.append(("charge", "%.2f" % v, c))
            elif it[0] == "TEMP":
                # Le degré et sa couleur, rien de plus : un adjectif ne dirait pas
                # mieux que le rouge. Le seul mot qui s'ajoute est « étouffé » — pas
                # un commentaire du chiffre, mais la seule chose qu'il ne dit PAS :
                # cette chaleur-là ne vient pas du travail, et se répare d'un geste.
                t, crit, _fan, etouf = it[1], it[2], it[3], it[4]
                pct = (100.0 * t / crit) if crit else 0.0
                out.append(("chaleur", "%d°%s" % (t, " étouffé" if etouf else ""),
                            self.RED if etouf else self.gcol(pct)))
            elif it[0] == "BAT":
                # Couleurs RÉSERVÉES : vert = en charge, rouge = batterie
                # faible. Le reste du temps le chiffre reste neutre — un niveau
                # normal sur batterie n'est ni une bonne ni une mauvaise
                # nouvelle. Pas de flèche : le temps restant dit déjà le sens.
                p, st, tm = it[1], it[2], it[3]
                c = self.GREEN if st == "chg" else (self.RED if p < 15 else 0)
                out.append(("batterie" + (("  " + tm) if tm else ""),
                            "%d%%" % p, c))
        return out

    # ---------- rendu ----------

    def draw(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        band = self.band = min(w, BAND)   # build() aligne les raccourcis dessus
        self.build()
        mrows = self.metrics_rows()
        # Hauteur réservée en bas : séparateur + bandeau, et la ligne de statut
        # SEULEMENT s'il y a quelque chose à dire. Pas de rappel de touches en
        # permanence : ça n'apprend rien après le premier jour et ça mange une
        # ligne. La dernière ligne revient donc au bandeau quand tout va bien.
        # Sur un pane minuscule, le bandeau saute avant le contenu.
        status_h = 1 if self.status else 0
        foot_h = (len(mrows) + 1) if mrows else 0
        avail = h - foot_h - status_h
        if avail < 4:
            mrows, foot_h = [], 0
            avail = max(1, h - status_h)

        # Sélection : on la garde sur une ligne activable et dans la fenêtre.
        acts = [i for i, r in enumerate(self.rows) if r[1]]
        if acts:
            if self.sel not in acts:
                nxt = [i for i in acts if i >= self.sel]
                self.sel = nxt[0] if nxt else acts[-1]
            self.off = min(self.off, self.sel)
            if self.sel >= self.off + avail:
                self.off = self.sel - avail + 1
            self.off = max(0, min(self.off, max(0, len(self.rows) - avail)))

        self.ymap = {}
        y = 0
        for i in range(self.off, len(self.rows)):
            if y >= avail:
                break
            segs, act = self.rows[i]
            self.ymap[y] = i
            # Toute ligne activable se surligne quand elle est sélectionnée ET
            # que le pane a le focus. Le fond couvre la bande entière, puis
            # chaque segment est redessiné dans sa couleur déclinée sur ce fond.
            sel = bool(act) and i == self.sel and self.focused
            if sel:
                try:
                    self.scr.addstr(y, 0, " " * band, self.SEL)
                except curses.error:
                    pass
            x = 0
            for t, a in segs:
                if x >= band:
                    break
                try:
                    self.scr.addnstr(y, x, t, band - x, self.sel_attr(a) if sel else a)
                except curses.error:
                    pass
                x += dwidth(t)
            y += 1

        if mrows:
            base = h - status_h - len(mrows)
            try:
                self.scr.addnstr(base - 1, 0, "─" * band, band, self.DIM)
            except curses.error:
                pass
            for k, (label, val, col) in enumerate(mrows):
                try:
                    self.scr.addnstr(base + k, 1, label, band - 2, self.DIM)
                    self.scr.addnstr(base + k, max(0, band - 1 - dwidth(val)),
                                     val, band, col)
                except curses.error:
                    pass

        if self.status:
            try:
                self.scr.addnstr(h - 1, 0, self.status[:band], band, self.YEL)
            except curses.error:
                pass
        self.scr.refresh()

    # ---------- actions ----------

    def act(self, action):
        kind, val = action
        if kind == "back":
            self.view, self.modal, self.sel, self.off = None, None, 0, 0
            return
        if kind == "entry":
            if val in self.VIEWS:
                # La liste REMPLACE la colonne — pas de dépliage sous le menu.
                self.view, self.modal, self.sel, self.off = val, None, 0, 0
                if val == "sessions" and self.sessions is None:
                    threading.Thread(target=self._load_sessions, daemon=True).start()
                return
            self.run(val, None)
            return
        if kind == "dir":
            self.expanded.symmetric_difference_update({val})
            return
        if kind == "sess":
            # Choisir une equipe ouvre une modale : les 3 façons d'y aller ne
            # sont pas équivalentes (l'une TUE la session courante), ça mérite
            # un choix explicite avec une sortie.
            self.modal = {"title": self.sessions[val]["name"],
                          "opts": self.OPEN_MODES, "sess": val}
            self.sel, self.off = 0, 0
            return
        if kind == "choose":
            m, self.modal = self.modal, None
            self.sel, self.off = 0, 0
            if val is not None:
                self.run("open", (m["sess"], val))
            return
        self.run(kind, val)

    def open_page(self, page):
        """Ouvre une page de l'accueil (infos / la garde) EN PLEIN ÉCRAN.

        Pane flottant 100 %×100 % + `--close-on-exit` : le Retour (ou Échap) de
        la page termine `etat-major`, le pane se referme, et on retombe sur le
        front exactement où on était. Pas de navigation à défaire."""
        name = {"infos": "infos", "autos": "automatisations"}[page]
        em = os.path.join(os.path.dirname(os.path.realpath(__file__)), "etat-major")
        r = subprocess.run(
            ["zellij", "run", "--floating", "--close-on-exit",
             "--width", "100%", "--height", "100%", "--name", name,
             "--cwd", self.cwd, "--", em, "--page", page, self.cwd],
            capture_output=True, text=True)
        # Rien à annoncer quand ça marche : l'écran s'ouvre, ça se voit.
        if r.returncode != 0:
            self.status = "✗ %s : %s" % (name, (r.stderr or "échec").strip()[:40])

    def zj(self, *args):
        """`zellij action …`, silencieux. True si la commande a abouti."""
        try:
            return subprocess.run(["zellij", "action"] + list(args),
                                  capture_output=True, timeout=5).returncode == 0
        except Exception:
            return False

    def open_file(self, path):
        """Ouvre un fichier dans nvim, EN PLEIN ÉCRAN (pane flottant).

        Même idiome que les pages infos / la garde : on quitte nvim, le pane se
        referme, on retombe sur le front. Le flottant évite au passage de
        polluer une stack — `zellij action edit` créerait un pane là où est le
        focus, c'est-à-dire ici, dans la colonne de gauche."""
        r = subprocess.run(
            ["zellij", "run", "--floating", "--close-on-exit",
             "--width", "100%", "--height", "100%", "--name", os.path.basename(path),
             "--cwd", self.cwd, "--", "nvim", path],
            capture_output=True, text=True)
        if r.returncode != 0:
            self.status = "✗ %s" % (r.stderr or "échec").strip()[:38]

    def switch_equipe(self, idx, mode):
        """Les trois façons d'ouvrir une autre equipe.

        On ne peut PAS s'attacher ailleurs depuis l'intérieur (la sidebar meurt
        avec la session). Donc : on écrit le choix dans le fichier de relais,
        puis on détache — `dev()` reprend la main dans sa boucle et applique.
        Le mode « nouvelle instance » ne détache pas : team-open crée la session
        à côté, détachée, et on reste où on est."""
        s = self.sessions[idx]
        if mode == 2:
            r = subprocess.run(["team-open", "local", s["name"], "--dir", s["cwd"]],
                               capture_output=True, text=True)
            if r.returncode != 0:
                self.status = "✗ %s" % (r.stderr or "échec").strip()[:38]
            return
        rel = os.path.expanduser("~/.cache/thedev/relais")
        os.makedirs(os.path.dirname(rel), exist_ok=True)
        # id vide → session neuve ; sinon on reprend la conversation du soldat.
        kill = self.equipe if mode == 1 else ""
        with open(rel, "w") as f:
            f.write("RESUME\t%s\t%s\t%s\n" % (s["cwd"], s["id"], kill))
        self.zj("detach")

    def run(self, what, val):
        """Exécute une action terminale.

        En mode prototype (défaut), ce qui frapperait la session de l'utilisateur
        est seulement AFFICHÉ : la sidebar tourne alors dans « le camp », un vrai
        `detach` détacherait l'utilisateur. Les actions inoffensives (pane
        flottant, nvim, focus) s'exécutent toujours."""
        if what in ("infos", "autos"):
            self.open_page(what)
            return
        if what == "file":
            self.open_file(val)
            return
        if what == "soldat":
            pid = soldat_pane(val)
            if pid and self.zj("focus-pane-id", pid):
                self.status = ""
            else:
                self.status = "✗ soldat introuvable (pane non enregistré)"
            return
        if what == "wake":
            sid, name = val
            if not self.live:
                self.status = "⌁ réveille « %s »" % name
                return
            # `renfort --resume` rouvre la conversation dans la stack des
            # soldats (l'ancre s'en charge), avec son nom de pane d'origine.
            r = subprocess.run(["renfort", "--resume", sid, "--name", name],
                               capture_output=True, text=True, cwd=self.cwd)
            if r.returncode == 0:
                self.soldats, self.dormants = load_soldats(self.cwd, self.equipe)
                self.status = ""
            else:
                self.status = "✗ %s" % (r.stderr or "réveil impossible").strip()[:38]
            return
        if what == "accueil":
            if not self.live:
                self.status = "⌁ ouvre le modal Ctrl+Q (détacher / fermer)"
                return
            subprocess.run(["zellij", "run", "--floating", "--close-on-exit",
                            "--name", "quitter", "--width", "54", "--height", "11",
                            "--", "debrief-menu"], capture_output=True)
            return
        if what == "aside":
            if not self.live:
                self.status = "⌁ ajoute un soldat dans la stack"
                return
            r = subprocess.run(["renfort"], capture_output=True, text=True,
                               cwd=self.cwd)
            if r.returncode == 0:
                # Le nouveau soldat ne s'inscrit au registre qu'à son
                # SessionStart : `r` pour le voir arriver dans la liste.
                self.status = ""
            else:
                self.status = "✗ %s" % (r.stderr or "échec").strip()[:38]
            return
        if what == "open":
            i, j = val
            if not self.live and j != 2:
                s = self.sessions[i]
                self.status = ["⌁ détacher → l'accueil attache « %s »" % s["name"],
                               "⌁ détacher → tuer « %s » → attacher « %s »"
                               % (self.equipe, s["name"])][j]
                return
            self.switch_equipe(i, j)
            return

    def back(self):
        """Remonte d'un cran : d'abord la modale, puis la vue.

        Ne QUITTE jamais. La colonne est un élément permanent du front — la
        fermer par mégarde avec Échap (le réflexe pour « annuler ») laisserait
        un pane vide sans moyen évident de la rappeler. Seul `q` sort."""
        if self.modal is not None:
            self.modal = None
            self.sel, self.off = 0, 0
        elif self.view is not None:
            self.act(("back", None))

    # ---------- boucle ----------

    def _getch(self):
        """getch, en resservant d'abord les octets relus après un faux ESC."""
        if self._pending:
            return self._pending.pop(0)
        return self.scr.getch()

    def _focus_seq(self):
        """Appelé sur un ESC : zellij annonce la prise/perte de focus du pane par
        CSI I / CSI O (mode ?1004, activé dans main). Aucune entrée terminfo ne
        décrit ces séquences, donc ncurses les livre en ESC + '[' + lettre : il
        faut les reconnaître à la main, sinon un simple changement de pane
        passerait pour Échap et ferait reculer d'un cran.

        Renvoie True (focus pris), False (focus perdu), ou None si c'était un
        vrai ESC — les octets lus au passage sont remis dans la file."""
        self.scr.timeout(0)                      # reposé au tour suivant par loop()
        a = self.scr.getch()
        if a == -1:
            return None
        if a != ord("["):
            self._pending.append(a)
            return None
        b = self.scr.getch()
        if b in (ord("I"), ord("O")):
            return b == ord("I")
        self._pending.append(ord("["))
        if b != -1:
            self._pending.append(b)
        return None

    def loop(self):
        while True:
            self.draw()
            # Réveils périodiques : le bandeau de ressources bouge tout seul, et
            # la liste des sessions arrive d'un thread.
            self.scr.timeout(1000 if self.metrics or self.sessions is None else 200)
            try:
                c = self._getch()
            except KeyboardInterrupt:
                return
            if c == -1:
                continue
            if c == self.KIN:
                self.focused = True
                continue
            if c == self.KOUT:
                self.focused = False
                continue
            if c == 27:
                f = self._focus_seq()
                if f is not None:
                    self.focused = f
                    continue
                self.back()
                continue
            # Une touche du clavier ne peut arriver QUE si le pane a le focus :
            # ça rattrape l'état initial, supposé sans focus. Deux exclusions —
            # la souris (zellij livre les mouvements au pane sous le curseur,
            # focus ou non : survoler la colonne ne l'allume pas) et le
            # redimensionnement (déclenché depuis un autre pane). Un vrai clic,
            # lui, donne le focus au pane, donc un CSI I derrière.
            if c not in (curses.KEY_MOUSE, curses.KEY_RESIZE):
                self.focused = True
            if c == ord("q"):
                return
            if c == curses.KEY_LEFT:
                self.back()
                continue
            if c == curses.KEY_RIGHT:
                # → ne valide PAS l'entrée sélectionnée (trop facile à déclencher
                # par accident). Dans le front, la droite c'est la stack des
                # soldats : la flèche sort donc de la colonne, ce qu'on cherche
                # neuf fois sur dix en la tapant.
                self.zj("move-focus", "right")
                continue
            if c == ord("r"):
                self.soldats, self.dormants = load_soldats(self.cwd, self.equipe)
                self.live_names = live_sessions()
                self.sessions = None
                threading.Thread(target=self._load_sessions, daemon=True).start()
                self.status = ""
                continue
            if c in (curses.KEY_DOWN, ord("j"), curses.KEY_UP, ord("k")):
                step = 1 if c in (curses.KEY_DOWN, ord("j")) else -1
                acts = [i for i, r in enumerate(self.rows) if r[1]]
                if acts:
                    cur = acts.index(self.sel) if self.sel in acts else 0
                    self.sel = acts[(cur + step) % len(acts)]
                continue
            if c in (curses.KEY_ENTER, 10, 13):
                r = self.rows[self.sel] if self.sel < len(self.rows) else (None, None)
                if r[1]:
                    self.status = ""
                    self.act(r[1])
                continue
            if c == curses.KEY_MOUSE:
                try:
                    _, _, my, _, bs = curses.getmouse()
                except curses.error:
                    continue
                if not (bs & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED)):
                    continue
                i = self.ymap.get(my)
                if i is not None and self.rows[i][1]:
                    self.sel = i
                    self.status = ""
                    self.act(self.rows[i][1])


def main(scr, live):
    curses.mousemask(curses.ALL_MOUSE_EVENTS | curses.REPORT_MOUSE_POSITION)
    curses.mouseinterval(0)
    scr.keypad(True)
    # ncurses attend l'ESCDELAY (1 s par défaut) avant de livrer un ESC, puisque
    # c'est aussi le début d'une séquence de touche. À 1 s, l'extinction du
    # surlignage traînerait d'une seconde après le départ du focus — et Échap
    # aussi. 25 ms suffisent pour distinguer les deux.
    if hasattr(curses, "set_escdelay"):
        curses.set_escdelay(25)
    # Focus reporting (mode ?1004) : zellij enverra CSI I / CSI O à chaque fois
    # que ce pane prend ou perd le focus (changement de pane ET d'onglet). C'est
    # ce qui permet d'éteindre le surlignage quand on tape ailleurs.
    os.write(1, b"\x1b[?1004h")
    v = Sidebar(scr, live)
    try:
        v.loop()
    finally:
        v.stop.set()
        os.write(1, b"\x1b[?1004l")   # sinon le shell de repli hérite du mode


def fallback_shell(live):
    """Après un `q`, ne PAS laisser le pane se fermer : on rend un shell avec la
    commande préchargée dans l'historique (↑ relance la sidebar) — même idiome que
    `editor-pane` avec nvim. Sans ça, quitter ferait disparaître la colonne de
    la stack sans moyen évident de la rappeler."""
    cmd = "sidebar --live" if live else "sidebar"
    rc = tempfile.NamedTemporaryFile("w", suffix=".rc", delete=False)
    rc.write("[ -f ~/.bashrc ] && . ~/.bashrc\nhistory -s %s\nrm -f %s\n"
             % (cmd, rc.name))
    rc.close()
    os.execvp("bash", ["bash", "--rcfile", rc.name])


if __name__ == "__main__":
    import sys
    import tempfile
    _live = "--live" in sys.argv
    curses.wrapper(main, _live)
    if os.environ.get("ZELLIJ"):
        fallback_shell(_live)
