#!/usr/bin/env python3
# @thedev session sidebar: left column of the agents page, the file tree and a quit button
"""sidebar — la colonne de gauche de la page agents.

Une colonne étroite (~20 % de l'écran, ~35 colonnes), cliquable et pilotable au
clavier. À l'usage, seul l'arbre des fichiers servait : c'est désormais la seule
vue. En tête, un bouton « quit » (même modale que Ctrl+Q : détacher ou fermer),
puis les fichiers ouverts (bouton save + close), le dossier du workspace et la
machine — sur un serveur, sa couleur rappelle où l'on est. Un fichier s'ouvre
dans nvim à la place des agents, dans leur pile à droite.

Les icônes viennent de la Nerd Font du terminal (set Material Design, nf-md-*) :
une seule famille, même graisse partout.

Le bandeau de ressources (fenêtre Claude, RAM, disque, charge, chaleur, batterie)
est en bas, TOUJOURS visible, quelle que soit la vue. Source unique :
`thedev-metrics`. La chaleur s'y lit en degrés — la couleur suffit à dire si le
chiffre est bon, un adjectif n'ajouterait rien. Elle bascule sur « étouffé » quand
la machine est chaude SANS travailler : le PC posé sur un lit, qui se bride et cuit
sa batterie. Le détail (ventilateur, bridages subis) est sur la page « infos ».

Le surlignage n'existe QUE quand le pane a le focus. Une ligne allumée dit « je
t'écoute » : la garder allumée pendant que l'utilisateur tape chez un agent
promet une touche qui n'arrivera pas, et deux curseurs à l'écran font douter de
celui qui répond. La position est conservée — elle se rallume telle quelle au
retour. Mécanique : mode ?1004, zellij envoie CSI I / CSI O (cf. _focus_seq).

La colonne ne confirme RIEN par écrit : ouvrir un fichier, une page ou un agent
se voit à l'écran, l'annoncer en plus est du bruit. Une ligne n'apparaît en bas
que si quelque chose a ÉCHOUÉ.

MODE PROTOTYPE (défaut) : l'arbre et le rendu sont RÉELS, le bouton quit est
seulement AFFICHÉ (un vrai detach détacherait l'utilisateur). `--live` exécute
tout (une fois posée dans la page agents).

Clavier : ↑/↓ naviguer · Entrée ouvrir · Échap replier l'arbre · r relire · q quitter
          → sort de la colonne (vers les agents), il n'active rien
Souris  : clic = ouvrir / déplier.
"""
import curses
import hashlib
import json
import os
import re
import socket
import subprocess
import tempfile
import threading
import time
import unicodedata

# Largeur simulée de la colonne gauche. Dans « jobs » le pane est large ; on
# dessine quand même dans une bande étroite pour juger le VRAI rendu de la page agents.
BAND = 38

# Habillage d'activité posé sur le TITRE du pane par `pane-pulse` (◆ plein ↔ ◇ creux,
# alternés pendant qu'un agent répond). Jamais une partie du nom : le registre stocke
# le nom nu, donc tout rapprochement layout ↔ registre doit le retirer d'abord.
PULSE_RE = re.compile(r"^[◆◇]\s+")

IGNORE = {".git", "node_modules", "__pycache__", ".next", ".venv", "target", ".cache"}


def dwidth(s):
    """Largeur d'affichage en CELLULES, pas en caractères.

    Indispensable pour avancer le curseur : « ＋ » (U+FF0B, fullwidth) occupe
    2 cellules mais compte pour 1 en `len()` — sans ça le segment suivant
    s'écrit par-dessus la moitié droite du glyphe."""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def sh(cmd, timeout=6):
    """Commande shell → stdout (vide si échec). Jamais d'exception qui remonte."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout).stdout
    except Exception:
        return ""


def vps_label():
    """Label du serveur (contenu de ~/.config/dev-vps) ; vide en local."""
    try:
        with open(os.path.expanduser("~/.config/dev-vps")) as f:
            return f.readline().strip()
    except OSError:
        return ""


def machine_name():
    """Nom de la machine affiché en tête : label VPS s'il existe, sinon l'hôte."""
    return vps_label() or socket.gethostname().split(".")[0]


def workspace_name():
    """Nom de le workspace = session zellij, sinon dossier courant."""
    n = os.environ.get("ZELLIJ_SESSION_NAME", "").strip()
    if n:
        return n
    for line in sh(["zellij", "list-sessions", "--no-formatting"], 2).splitlines():
        if "(current)" in line:
            return line.split()[0]
    return os.path.basename(os.getcwd()) or "?"


def workspace_cwd(sess, fallback):
    """Dossier de l'WORKSPACE, pas simplement `getcwd()`.

    Tout ce que la colonne montre (agents présents, agents à réveiller, arbre
    des fichiers) est relatif à un dossier. Le prendre du process est fragile :
    lancée depuis ailleurs — un pane de jobs, un shell — la colonne afficherait
    les agents d'un AUTRE projet, ce qui se lit comme une liste globale.
    On le déduit donc du registre : le dossier de la session zellij courante,
    d'après l'agent le plus récemment démarré. Repli sur `getcwd()` si
    le workspace n'a encore aucun agent inscrit."""
    if not sess:
        return fallback
    best, best_t = "", -1
    try:
        with open(os.path.expanduser("~/.cache/agents")) as f:
            lines = f.read().splitlines()
    except OSError:
        return fallback
    for line in lines:
        p = line.split("\t")
        if len(p) < 6 or p[4] != sess:
            continue
        try:
            t = int(p[5])
        except ValueError:
            continue
        if t > best_t:
            best, best_t = p[1], t
    if not best:
        return fallback
    try:
        return os.path.realpath(best)
    except OSError:
        return fallback


def listdir(path):
    """Contenu d'un dossier, dossiers d'abord, bruit filtré."""
    try:
        ents = [e for e in os.scandir(path) if not e.name.startswith(".")
                and e.name not in IGNORE]
    except OSError:
        return []
    ents.sort(key=lambda e: (not e.is_dir(), e.name.lower()))
    return ents


def parse_metrics(out):
    """Sortie TSV de `thedev-metrics --raw` → liste de tuples typés.
    Même découpage que le home : une seule source pour les deux écrans."""
    m = []
    for ln in out.splitlines():
        p = ln.split("\t")
        try:
            if p[0] == "NET" and len(p) >= 2:
                # (état ok|noinet|down, signal %, nom du réseau, vpn, débit Mb/s)
                m.append(("NET",) + tuple(
                    (p[i] if len(p) > i else "") for i in range(1, 6)))
            elif p[0] == "CLAUDE" and len(p) >= 3:
                m.append(("CLAUDE", p[1], int(p[2]), p[3] if len(p) >= 4 else ""))
            elif p[0] == "RAM" and len(p) >= 2:
                m.append(("RAM", int(p[1])))
            elif p[0] == "DISK" and len(p) >= 3:
                m.append(("DISK", p[1], int(p[2])))
            elif p[0] == "LOAD" and len(p) >= 3:
                m.append(("LOAD", float(p[1]), int(p[2])))
            elif p[0] == "TEMP" and len(p) >= 5:
                # (T °C, T critique, ventilateur tr/min ou 0, étouffé)
                m.append(("TEMP", int(p[1]), int(p[2]),
                          int(p[3]) if p[3] else 0, p[4] == "1"))
            elif p[0] == "BAT" and len(p) >= 2:
                m.append(("BAT", int(p[1]), p[2] if len(p) >= 3 else "",
                          p[3] if len(p) >= 4 else ""))
        except ValueError:
            continue
    return m


class Sidebar:
    # (touche, icône, libellé, id d'action)
    # (icône, libellé, id d'action, raccourci global). Pas de numéro : sept
    # entrées se pointent à la souris ou se parcourent aux flèches, un chiffre
    # devant n'aide pas. Le raccourci, lui, est rappelé à droite quand l'entrée
    # est AUSSI joignable au clavier depuis n'importe où dans thedev.
    # Icônes : Nerd Font (set Material Design, nf-md-*) — UNE seule famille,
    # même graisse et même taille partout, là où l'Unicode « divers » mélangeait
    # des glyphes de blocs différents rendus par des fontes de fallback
    # disparates. La fonte du terminal les embarque déjà (cf. barre zjstatus).

    def __init__(self, scr, live=False):
        self.scr = scr
        self.live = live
        self.workspace = workspace_name()
        # Marqueur VPS (~/.config/dev-vps, posé au provisioning, absent en local) :
        # la colonne est le pane le plus visible de la page agents, elle porte le repère
        # « on est sur un serveur » comme le pane d'accueil/shell dans les autres pages.
        self.vps = vps_label()
        self.machine = machine_name()
        self.cwd = workspace_cwd(self.workspace, os.path.realpath(os.getcwd()))
        self.sel = 0
        self.off = 0            # première ligne visible (défilement)
        self.view = "files"     # la seule vue : l'arbre du dossier du workspace
        self.status = ""
        self.expanded = set()   # dossiers dépliés dans l'arbre files
        self.editors = []       # fichiers ouverts : {path, sock, pane}
        self.modal = None       # modale de choix ouverte (dict title/opts/sess) ou None
        self.metrics = None
        self.stop = threading.Event()
        self.rows = []
        self.band = BAND        # largeur de dessin réelle, posée par draw()
        # Le surlignage ne s'affiche QUE si le pane a le focus : une colonne qui
        # garde une ligne allumée pendant qu'on tape ailleurs prétend attendre
        # une touche qui n'arrivera pas. Faux au démarrage : dans « agents »
        # c'est l'agent qui a le focus, et zellij nous enverra CSI I si on
        # l'obtient (cf. _focus_seq).
        self.focused = False
        self._pending = []      # octets relus après un ESC non consommé
        self._focus_keys()
        self._colors()
        threading.Thread(target=self._metrics_worker, daemon=True).start()

    def _focus_keys(self):
        """Retrouve les codes que ncurses donne à la prise/perte de focus.

        Le terminfo xterm* décrit ces séquences (kxIN=\\E[I, kxOUT=\\E[O), donc
        ncurses les reconnaît lui-même et rend une touche — mais une touche
        ÉTENDUE, sans constante KEY_* : son numéro est attribué à l'exécution
        (590/591 ici, rien ne le garantit ailleurs). On le retrouve par son nom.
        Introuvable = terminfo sans ces capacités : les séquences arriveront
        alors brutes et c'est _focus_seq qui les rattrape après l'ESC."""
        self.KIN = self.KOUT = None
        for c in range(256, 1024):
            try:
                n = curses.keyname(c)
            except Exception:
                continue
            if n == b"kxIN":
                self.KIN = c
            elif n == b"kxOUT":
                self.KOUT = c

    def _colors(self):
        curses.use_default_colors()
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        for i, fg in enumerate((curses.COLOR_GREEN, curses.COLOR_CYAN,
                                curses.COLOR_MAGENTA, curses.COLOR_YELLOW,
                                curses.COLOR_BLUE, curses.COLOR_RED), 1):
            curses.init_pair(i, fg, -1)
        (self.GREEN, self.CYAN, self.MAG, self.YEL,
         self.BLUE, self.RED) = (curses.color_pair(i) for i in range(1, 7))
        # Ligne sélectionnée = un FOND, pas une inversion vidéo. L'inversion
        # écraserait la couleur des noms de session ; ici on re-décline chaque
        # couleur de la palette sur ce fond (paires 21-26) et on garde donc le
        # code couleur intact SOUS le surlignage. Repli A_REVERSE en 8 couleurs.
        self.SEL = curses.A_REVERSE
        self.SELPAIR = {}
        if curses.COLORS >= 256:
            try:
                curses.init_pair(7, 252, 237)
                self.SEL = curses.color_pair(7)
                for i, fg in enumerate((curses.COLOR_GREEN, curses.COLOR_CYAN,
                                        curses.COLOR_MAGENTA, curses.COLOR_YELLOW,
                                        curses.COLOR_BLUE, curses.COLOR_RED), 1):
                    curses.init_pair(20 + i, fg, 237)
                    self.SELPAIR[i] = curses.color_pair(20 + i)
            except curses.error:
                self.SELPAIR = {}
        self.DIM = curses.A_DIM
        # Couleur stable par projet — MÊME palette et MÊME hash que le home,
        # pour qu'un workspace garde sa couleur d'un écran à l'autre.
        self.PALETTE = [self.CYAN, self.MAG, self.YEL, self.BLUE, self.RED, self.GREEN]

    def pcolor(self, name):
        return self.PALETTE[sum(name.encode("utf-8")) % len(self.PALETTE)]

    def sel_attr(self, a):
        """Le même segment, reposé sur le fond de la ligne sélectionnée.

        On récupère la paire de couleurs d'origine (`pair_number`) pour lui
        substituer sa déclinaison « sur fond de sélection », en conservant le
        gras. Sans ça, le fond effacerait la couleur du nom."""
        return self.SELPAIR.get(curses.pair_number(a), self.SEL) | (a & curses.A_BOLD)

    def gcol(self, p):
        """Couleur d'une jauge par sévérité — même seuils que le home."""
        return self.GREEN if p < 70 else (self.YEL if p < 88 else self.RED)

    # ---------- données de fond ----------

    def _metrics_worker(self):
        # Bandeau du bas + liste des agents, rafraîchis en continu. La colonne
        # vit des heures dans agents : lus une seule fois au démarrage, ces
        # deux états divergeaient de la réalité sans qu'on s'en aperçoive (un
        # agent ouvert depuis affiché « à réveiller », un agent fermé toujours
        # listé présent). `thedev-metrics` lit /proc et un cache, `dump-layout`
        # fait ~30 ko en 0,1 s : les deux sont assez légers pour ce rythme.
        while not self.stop.is_set():
            m = parse_metrics(sh(["thedev-metrics", "--raw"], 5))
            if m:
                self.metrics = m
            if self.stop.wait(3):
                break

    # ---------- construction des lignes ----------

    def machine_color(self):
        if not self.vps:
            return self.GREEN
        cols = [self.RED, self.MAG, self.YEL, self.BLUE, self.CYAN]
        return cols[sum(map(ord, self.vps)) % len(cols)]

    def build(self):
        """Reconstruit la liste plate des lignes affichées.

        Chaque ligne = (segments, action). `action` None = ligne décorative (non
        sélectionnable). C'est cette liste qui sert AUSSI au clic : y → index."""
        # Une seule vue : l'usage a montré que seul l'arbre des fichiers servait.
        # En tête, le bouton de sortie (même modale que Ctrl+Q), puis le dossier
        # et la machine : sur un serveur, sa couleur rappelle où l'on est.
        R = []
        segs = [("  ", 0), ("󰗼 ", self.RED), ("quit", 0)]
        pad = self.band - 1 - sum(dwidth(t) for t, _ in segs) - dwidth("ctrl q")
        if pad > 1:
            segs += [(" " * pad, 0), ("ctrl q", self.DIM)]
        R.append((segs, ("quit", None)))
        R.append(([("", 0)], None))
        # Fichiers ouverts : une ligne pour y revenir, une ligne de deux boutons.
        # nvim supprime sa socket en sortant : un fichier refermé disparaît seul.
        # Mais nvim met un instant à la CRÉER : une entrée dont la socket n'est pas
        # encore apparue reste (10 s au plus), sinon le redessin qui suit
        # l'ouverture la retirait aussitôt.
        live = []
        for e in self.editors:
            if os.path.exists(e["sock"]):
                e["seen"] = True
                live.append(e)
            elif not e.get("seen") and time.time() - e["t"] < 10:
                live.append(e)
        self.editors = live
        for i, e in enumerate(self.editors):
            R.append(([("  ", 0), ("✎ ", self.YEL), (os.path.basename(e["path"]), curses.A_BOLD)],
                      ("edfocus", i)))
            R.append(([("    ", 0), ("󰆓 save + close", self.GREEN)], ("edclose", i)))
        if self.editors:
            R.append(([("", 0)], None))
        root = os.path.basename(self.cwd.rstrip("/")) or self.cwd
        segs = [("  ", 0), ("󰉋 ", self.CYAN), (root, curses.A_BOLD)]
        pad = self.band - 1 - sum(dwidth(t) for t, _ in segs) - dwidth(self.machine)
        if pad > 1:
            segs += [(" " * pad, 0), (self.machine, self.machine_color() | curses.A_BOLD)]
        R.append((segs, None))
        R.extend(self.rows_files())
        # Au premier affichage, la sélection part sur l'arbre et non sur « quit » :
        # un Entrée réflexe en arrivant dans la colonne ne doit pas ouvrir la sortie.
        if not getattr(self, "_placed", False):
            self._placed = True
            self.sel = next((i for i, r in enumerate(R) if r[1] and r[1][0] in ("dir", "file")), 0)
        self.rows = R

    def rows_files(self):
        """Arbre du dossier courant, dépliable. Un fichier s'ouvre dans nvim."""
        R = []

        def walk(path, depth):
            if depth > 4:
                return
            for e in listdir(path):
                pad = "  " + "  " * depth
                if e.is_dir():
                    o = e.path in self.expanded
                    R.append(([(pad + ("▾ " if o else "▸ "), self.DIM),
                               (e.name[:BAND - len(pad) - 3], self.BLUE)],
                              ("dir", e.path)))
                    if o:
                        walk(e.path, depth + 1)
                else:
                    R.append(([(pad + "  ", 0),
                               (e.name[:BAND - len(pad) - 3], 0)],
                              ("file", e.path)))
        walk(self.cwd, 0)
        return R or [([("  (empty)", self.DIM)], None)]

    def net_row(self, state, pct, name, vpn, spd):
        """La ligne réseau : « à quoi je suis connecté » à gauche, « est-ce que
        ça passe » à droite.

        Le NOM du réseau tient le libellé — savoir qu'on est sur le partage de
        connexion d'un téléphone plutôt que sur la box change ce qu'on lance. Le
        VPN s'y colle en un mot : « vpn » quand il est monté (accès seulement),
        « via vpn » quand il porte la route par défaut, donc que TOUT le trafic
        sort par là.

        La valeur est un STATUT (bon · faible · mauvais · sans internet · hors
        ligne), jamais une mesure : le signal en % ou en dBm oblige à connaître
        l'échelle avant de savoir s'il faut s'inquiéter. Les chiffres bruts
        (dBm, débit négocié du lien) restent dans `thedev-metrics` pour la page
        « infos », où on a la place de les expliquer."""
        if state == "down":
            return [("network", "offline", self.RED)]
        lab = name or "network"
        if dwidth(lab) > 18:                      # un SSID peut être très long
            while lab and dwidth(lab) > 17:
                lab = lab[:-1]
            lab += "…"
        lab += " via vpn" if vpn == "via" else (" vpn" if vpn else "")
        if state == "noinet":
            return [(lab, "no internet", self.RED)]
        # Un STATUT, pas un chiffre : « 40 % » demande de savoir à quoi 40 %
        # correspond, alors que la seule question est « est-ce que ça passe ? ».
        # Un seul vocabulaire tient donc toute l'échelle, du bon au rien — et la
        # couleur redit la même chose sans avoir à lire le mot.
        # Bornes converties depuis l'échelle radio (% = 2×(dBm+100), formule de
        # NetworkManager) : bon ≥ −70 dBm · faible jusqu'à −80 · mauvais en
        # dessous, là où ça décroche. En filaire il n'y a pas de signal — un lien
        # négocié qui répond est « bon ».
        if pct.isdigit():
            p = int(pct)
            if p >= 60:
                return [(lab, "good", self.GREEN)]
            if p >= 40:
                return [(lab, "weak", self.YEL)]
            return [(lab, "poor", self.RED)]
        return [(lab, "good", self.GREEN)]

    def metrics_rows(self):
        """Bandeau du bas : une ressource par ligne, valeur alignée à droite.
        Toujours affiché — c'est le point de la colonne : voir sans demander."""
        if not self.metrics:
            return []
        out = []
        for it in self.metrics:
            if it[0] == "NET":
                out.extend(self.net_row(*it[1:]))
            elif it[0] == "CLAUDE":
                win, p, el = it[1], it[2], it[3]
                out.append(("claude %s" % (("%s/%s" % (el, win)) if el else win),
                            "%d%%" % p, self.gcol(p)))
            elif it[0] == "RAM":
                out.append(("RAM", "%d%%" % it[1], self.gcol(it[1])))
            elif it[0] == "DISK" and it[1] == "/":
                out.append(("disk", "%d%%" % it[2], self.gcol(it[2])))
            elif it[0] == "LOAD":
                v, n = it[1], it[2]
                c = self.GREEN if v < n * 0.7 else (self.YEL if v < n else self.RED)
                out.append(("load", "%.2f" % v, c))
            elif it[0] == "TEMP":
                # Le degré et sa couleur, rien de plus : un adjectif ne dirait pas
                # mieux que le rouge. Le seul mot qui s'ajoute est « étouffé » — pas
                # un commentaire du chiffre, mais la seule chose qu'il ne dit PAS :
                # cette chaleur-là ne vient pas du travail, et se répare d'un geste.
                t, crit, _fan, etouf = it[1], it[2], it[3], it[4]
                pct = (100.0 * t / crit) if crit else 0.0
                out.append(("heat", "%d°%s" % (t, " blocked vents" if etouf else ""),
                            self.RED if etouf else self.gcol(pct)))
            elif it[0] == "BAT":
                # Couleurs RÉSERVÉES : vert = en charge, rouge = batterie
                # faible. Le reste du temps le chiffre reste neutre — un niveau
                # normal sur batterie n'est ni une bonne ni une mauvaise
                # nouvelle. Pas de flèche : le temps restant dit déjà le sens.
                p, st, tm = it[1], it[2], it[3]
                c = self.GREEN if st == "chg" else (self.RED if p < 15 else 0)
                out.append(("battery" + (("  " + tm) if tm else ""),
                            "%d%%" % p, c))
        return out

    # ---------- rendu ----------

    def draw(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        band = self.band = min(w, BAND)   # build() aligne les raccourcis dessus
        self.build()
        mrows = self.metrics_rows()
        # Hauteur réservée en bas : séparateur + bandeau, et la ligne de statut
        # SEULEMENT s'il y a quelque chose à dire. Pas de rappel de touches en
        # permanence : ça n'apprend rien après le premier jour et ça mange une
        # ligne. La dernière ligne revient donc au bandeau quand tout va bien.
        # Sur un pane minuscule, le bandeau saute avant le contenu.
        status_h = 1 if self.status else 0
        foot_h = (len(mrows) + 1) if mrows else 0
        avail = h - foot_h - status_h
        if avail < 4:
            mrows, foot_h = [], 0
            avail = max(1, h - status_h)

        # Sélection : on la garde sur une ligne activable et dans la fenêtre.
        acts = [i for i, r in enumerate(self.rows) if r[1]]
        if acts:
            if self.sel not in acts:
                nxt = [i for i in acts if i >= self.sel]
                self.sel = nxt[0] if nxt else acts[-1]
            self.off = min(self.off, self.sel)
            if self.sel >= self.off + avail:
                self.off = self.sel - avail + 1
            self.off = max(0, min(self.off, max(0, len(self.rows) - avail)))

        self.ymap = {}
        y = 0
        for i in range(self.off, len(self.rows)):
            if y >= avail:
                break
            segs, act = self.rows[i]
            self.ymap[y] = i
            # Toute ligne activable se surligne quand elle est sélectionnée ET
            # que le pane a le focus. Le fond couvre la bande entière, puis
            # chaque segment est redessiné dans sa couleur déclinée sur ce fond.
            sel = bool(act) and i == self.sel and self.focused
            if sel:
                try:
                    self.scr.addstr(y, 0, " " * band, self.SEL)
                except curses.error:
                    pass
            x = 0
            for t, a in segs:
                if x >= band:
                    break
                try:
                    self.scr.addnstr(y, x, t, band - x, self.sel_attr(a) if sel else a)
                except curses.error:
                    pass
                x += dwidth(t)
            y += 1

        if mrows:
            base = h - status_h - len(mrows)
            try:
                self.scr.addnstr(base - 1, 0, "─" * band, band, self.DIM)
            except curses.error:
                pass
            for k, (label, val, col) in enumerate(mrows):
                try:
                    self.scr.addnstr(base + k, 1, label, band - 2, self.DIM)
                    self.scr.addnstr(base + k, max(0, band - 1 - dwidth(val)),
                                     val, band, col)
                except curses.error:
                    pass

        if self.status:
            try:
                self.scr.addnstr(h - 1, 0, self.status[:band], band, self.YEL)
            except curses.error:
                pass
        self.scr.refresh()

    # ---------- actions ----------

    def act(self, action):
        kind, val = action[0], action[1]
        if kind == "quit":
            self.run("quit", None)
            return
        if kind == "dir":
            self.expanded.symmetric_difference_update({val})
            return
        if kind == "edfocus":
            self.zj("focus-pane-id", self.editors[val]["pane"])
            return
        if kind == "edclose":
            self.nvim_cmd(self.editors[val], ":wq")
            return
        self.run(kind, val)

    def zj(self, *args):
        """`zellij action …`, silencieux. True si la commande a abouti."""
        try:
            return subprocess.run(["zellij", "action"] + list(args),
                                  capture_output=True, timeout=5).returncode == 0
        except Exception:
            return False

    def open_file(self, path):
        """Ouvre un fichier dans nvim, À LA PLACE DES AGENTS (zone de droite).

        nvim écoute sur une socket : le bouton « save + close » de la colonne lui
        envoie :wq. Déjà ouvert → on y retourne au lieu d'ouvrir un
        second exemplaire."""
        for e in self.editors:
            if e["path"] == path and os.path.exists(e["sock"]):
                self.zj("focus-pane-id", e["pane"])
                return
        if not self.live:
            self.status = "⌁ opens %s in the agents stack" % os.path.basename(path)
            return
        slug = re.sub(r"[^A-Za-z0-9._-]", "_", self.workspace or "default")[:40]  # socket Unix : 108 car. max
        sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
                            "thedev-nvim-%s-%s.sock" % (
                                slug, hashlib.md5(path.encode()).hexdigest()[:10]))
        # nvim prend la place de l'agent principal (--in-place) : un pane de la
        # mise en page, donc Alt+← mène à la colonne. En flottant (essai écarté),
        # Alt+← ne voyait que les autres flottants et sautait à l'onglet précédent.
        # Fermer nvim rend sa place à l'agent. Limite zellij : les AUTRES agents
        # de la pile restent visibles en une ligne de titre au-dessus.
        anchor = os.path.expanduser("~/.cache/thedev/front-stack/" + slug)
        try:
            with open(anchor) as f:
                pid = f.readline().strip()
            if pid:
                self.zj("focus-pane-id", pid)
        except OSError:
            pass
        r = subprocess.run(
            ["zellij", "run", "--in-place", "--close-on-exit",
             "--name", "✎ " + os.path.basename(path), "--cwd", self.cwd,
             "--", "nvim", "--listen", sock, path],
            capture_output=True, text=True)
        if r.returncode != 0:
            self.status = "✗ %s" % (r.stderr or "failed").strip()[:38]
            return
        m = re.search(r"terminal_\d+", (r.stdout or "") + (r.stderr or ""))
        self.editors.append({"path": path, "sock": sock, "t": time.time(),
                             "pane": m.group(0) if m else ""})

    def nvim_cmd(self, e, cmd):
        """Envoie une commande Ex à un nvim ouvert depuis la colonne."""
        r = subprocess.run(["nvim", "--server", e["sock"], "--remote-send",
                            "<C-\\><C-N>%s<CR>" % cmd],
                           capture_output=True, text=True, timeout=5)
        if r.returncode != 0:
            self.status = "✗ %s" % (r.stderr or "nvim unreachable").strip()[:38]

    def run(self, what, val):
        """Exécute une action terminale.

        En mode prototype (défaut), ce qui frapperait la session de l'utilisateur
        est seulement AFFICHÉ : la sidebar tourne alors dans « jobs », un vrai
        `detach` détacherait l'utilisateur. Les actions inoffensives (pane
        flottant, nvim, focus) s'exécutent toujours."""
        if what == "file":
            self.open_file(val)
            return
        if what == "quit":
            if not self.live:
                self.status = "⌁ opens the Ctrl+Q modal (detach / close)"
                return
            subprocess.run(["zellij", "run", "--floating", "--close-on-exit",
                            "--name", "quit", "--width", "54", "--height", "11",
                            "--", "quit-menu"], capture_output=True)
            return
    def back(self):
        """Échap replie tout l'arbre. Ne QUITTE jamais : la colonne est un élément
        permanent de la page agents, seul `q` sort."""
        self.expanded.clear()
        self.sel, self.off = 0, 0

    # ---------- boucle ----------

    def _getch(self):
        """getch, en resservant d'abord les octets relus après un faux ESC."""
        if self._pending:
            return self._pending.pop(0)
        return self.scr.getch()

    def _focus_seq(self):
        """Appelé sur un ESC : zellij annonce la prise/perte de focus du pane par
        CSI I / CSI O (mode ?1004, activé dans main). Aucune entrée terminfo ne
        décrit ces séquences, donc ncurses les livre en ESC + '[' + lettre : il
        faut les reconnaître à la main, sinon un simple changement de pane
        passerait pour Échap et ferait reculer d'un cran.

        Renvoie True (focus pris), False (focus perdu), ou None si c'était un
        vrai ESC — les octets lus au passage sont remis dans la file."""
        self.scr.timeout(0)                      # reposé au tour suivant par loop()
        a = self.scr.getch()
        if a == -1:
            return None
        if a != ord("["):
            self._pending.append(a)
            return None
        b = self.scr.getch()
        if b in (ord("I"), ord("O")):
            return b == ord("I")
        self._pending.append(ord("["))
        if b != -1:
            self._pending.append(b)
        return None

    def loop(self):
        while True:
            self.draw()
            # Réveil chaque seconde : le bandeau de ressources bouge tout seul.
            self.scr.timeout(1000)
            try:
                c = self._getch()
            except KeyboardInterrupt:
                return
            if c == -1:
                continue
            if c == self.KIN:
                self.focused = True
                continue
            if c == self.KOUT:
                self.focused = False
                continue
            if c == 27:
                f = self._focus_seq()
                if f is not None:
                    self.focused = f
                    continue
                self.back()
                continue
            # Une touche du clavier ne peut arriver QUE si le pane a le focus :
            # ça rattrape l'état initial, supposé sans focus. Deux exclusions —
            # la souris (zellij livre les mouvements au pane sous le curseur,
            # focus ou non : survoler la colonne ne l'allume pas) et le
            # redimensionnement (déclenché depuis un autre pane). Un vrai clic,
            # lui, donne le focus au pane, donc un CSI I derrière.
            if c not in (curses.KEY_MOUSE, curses.KEY_RESIZE):
                self.focused = True
            if c == ord("q"):
                return
            if c == curses.KEY_LEFT:
                self.back()
                continue
            if c == curses.KEY_RIGHT:
                # → ne valide PAS l'entrée sélectionnée (trop facile à déclencher
                # par accident). Dans agents, la droite c'est la stack des
                # agents : la flèche sort donc de la colonne, ce qu'on cherche
                # neuf fois sur dix en la tapant.
                self.zj("move-focus", "right")
                continue
            if c == ord("r"):            # relit l'arbre (fichiers créés entre-temps)
                self.status = ""
                continue
            if c in (curses.KEY_DOWN, ord("j"), curses.KEY_UP, ord("k")):
                step = 1 if c in (curses.KEY_DOWN, ord("j")) else -1
                acts = [i for i, r in enumerate(self.rows) if r[1]]
                if acts:
                    cur = acts.index(self.sel) if self.sel in acts else 0
                    self.sel = acts[(cur + step) % len(acts)]
                continue
            if c in (curses.KEY_ENTER, 10, 13):
                r = self.rows[self.sel] if self.sel < len(self.rows) else (None, None)
                if r[1]:
                    self.status = ""
                    self.act(r[1])
                continue
            if c == curses.KEY_MOUSE:
                try:
                    _, _, my, _, bs = curses.getmouse()
                except curses.error:
                    continue
                if not (bs & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED)):
                    continue
                i = self.ymap.get(my)
                if i is not None and self.rows[i][1]:
                    self.sel = i
                    self.status = ""
                    self.act(self.rows[i][1])


def main(scr, live):
    # Clics seulement. REPORT_MOUSE_POSITION passerait le terminal en « signale
    # chaque mouvement » (?1003h) : zellij relaie ce mode au vrai terminal et, en
    # 0.45, l'y laisse au détachement → le picker et les shells reçoivent ensuite
    # les mouvements comme des frappes (« 35;128;22M… » dans les champs).
    curses.mousemask(curses.ALL_MOUSE_EVENTS)
    curses.mouseinterval(0)
    scr.keypad(True)
    # ncurses attend l'ESCDELAY (1 s par défaut) avant de livrer un ESC, puisque
    # c'est aussi le début d'une séquence de touche. À 1 s, l'extinction du
    # surlignage traînerait d'une seconde après le départ du focus — et Échap
    # aussi. 25 ms suffisent pour distinguer les deux.
    if hasattr(curses, "set_escdelay"):
        curses.set_escdelay(25)
    # Focus reporting (mode ?1004) : zellij enverra CSI I / CSI O à chaque fois
    # que ce pane prend ou perd le focus (changement de pane ET d'onglet). C'est
    # ce qui permet d'éteindre le surlignage quand on tape ailleurs.
    os.write(1, b"\x1b[?1004h")
    v = Sidebar(scr, live)
    try:
        v.loop()
    finally:
        v.stop.set()
        os.write(1, b"\x1b[?1004l")   # sinon le shell de repli hérite du mode


def fallback_shell(live):
    """Après un `q`, ne PAS laisser le pane se fermer : on rend un shell avec la
    commande préchargée dans l'historique (↑ relance la sidebar) — même idiome que
    `editor-pane` avec nvim. Sans ça, quitter ferait disparaître la colonne de
    la stack sans moyen évident de la rappeler."""
    cmd = "sidebar --live" if live else "sidebar"
    rc = tempfile.NamedTemporaryFile("w", suffix=".rc", delete=False)
    rc.write("[ -f ~/.bashrc ] && . ~/.bashrc\nhistory -s %s\nrm -f %s\n"
             % (cmd, rc.name))
    rc.close()
    os.execvp("bash", ["bash", "--rcfile", rc.name])


if __name__ == "__main__":
    import sys
    import tempfile
    _live = "--live" in sys.argv
    curses.wrapper(main, _live)
    if os.environ.get("ZELLIJ"):
        fallback_shell(_live)
