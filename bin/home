#!/usr/bin/env python3
# @thedev home machine/project picker at startup (fzf, multi-server)
"""home — sélecteur de session/dossier à deux panneaux (TUI maison).

Panneau gauche = liste (sessions ou dossiers), panneau droit = actions.
←/→ changent de panneau, ↑/↓ naviguent, Entrée valide, tape pour filtrer,
Esc revient/quitte. Les en-têtes de section ne sont pas sélectionnables.

N'exécute rien lui-même : imprime une décision sur stdout que `dev` applique :
    NEW\t<cwd>
    RESUME\t<cwd>\t<id>
    UPDATE          (bouton « mettre à jour dev » → git pull côté dev())
(rien + code ≠0 si annulé).
"""
import curses
import datetime
import glob
import json
import os
import re
import subprocess
import sys
import threading
import time

# Adaptateur moteur (engine list …) résolu en VOISIN de ce script (relocatable) :
# home n'a plus à connaître l'emplacement ni le schéma des transcripts du
# moteur — il demande la liste des workspaces à `engine`.
ENGINE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "engine")


def vps_label():
    """Label du serveur distant (contenu de ~/.config/dev-vps). Vide en local."""
    try:
        with open(os.path.expanduser("~/.config/dev-vps")) as f:
            return f.read().strip()
    except Exception:
        return ""


def read_machines():
    """Hôtes ssh des autres machines thedev, depuis ~/.config/thedev-machines
    (1 alias par ligne, # = commentaire) — MÊME source que thedev-status.
    Absent = machine seule : aucune ligne « remote control » et aucun SSH."""
    try:
        with open(os.path.expanduser("~/.config/thedev-machines")) as f:
            lines = [l.split("#", 1)[0].strip() for l in f]
    except Exception:
        return []
    return [l for l in lines if l]


def live_sessions():
    """Noms des sessions zellij vivantes (pour marquer '● en cours')."""
    try:
        out = subprocess.run(
            ["zellij", "list-sessions", "--no-formatting"],
            capture_output=True, text=True, timeout=2,
        ).stdout
    except Exception:
        return set()
    names = set()
    for line in out.splitlines():
        if "EXITED" in line or not line.strip():
            continue
        names.add(line.split()[0])
    return names


def fetch_remote_claudes(host):
    """SSH : lit ~/.cache/agents d'un serveur → sessions de dev ouvertes et
    leurs panes Claude. Comme les sessions serveur sont auto-remote-control, ce
    sont les « remote controls dispo ». Renvoie {"sessions":[{name,cwd,panes,
    busy}]} ou {"error":"…"}. (TSV id⇥cwd⇥role⇥nom_pane⇥session⇥started⇥ended ;
    ended==0 → Claude encore ouvert.) Un pane est « busy » (en train de répondre)
    si son sid a un marqueur frais dans ~/.cache/agent-busy (posé par le
    hook sur UserPromptSubmit, retiré sur Stop). ControlMaster → re-fetch rapides
    pour le rafraîchissement live."""
    sep, sep2, sep3, sep4 = "@@@BUSY@@@", "@@@RC@@@", "@@@LIVE@@@", "@@@SESS@@@"
    # 5 sections : registre · marqueurs busy · cwd des process en remote-control
    # (pour le flag « remote ») · cwd de TOUS les process claude VIVANTS · workspaces
    # dont le WATCHER thedev-link est VIVANT (« eq\tcwd » par ligne). Le 4e bloc
    # compte les Claude ; le 5e dit si le THEDEV est encore actif/joignable même
    # sans Claude interactif debout — c'est EXACTEMENT le signal des automations
    # (cf. automation-list : open ⟺ watcher_pid vivant), donc badge auto et liste sont
    # cohérents au pixel. On garde alors le workspace visible (réattachable + ancre des
    # autos) ; un workspace vraiment fermée (watcher mort) disparaît → fini les fantômes.
    remote = ("cat ~/.cache/agents 2>/dev/null; echo %s; "
              "find ~/.cache/agent-busy -type f -mmin -30 -printf '%%f\\n' 2>/dev/null; "
              "echo %s; "
              "for p in $(pgrep -f remote-control 2>/dev/null); do readlink /proc/$p/cwd 2>/dev/null; done; "
              "echo %s; "
              "for p in $(pgrep -x claude 2>/dev/null); do readlink /proc/$p/cwd 2>/dev/null; done; "
              "echo %s; "
              "for lf in ~/.cache/thedev/links/*; do [ -f \"$lf\" ] || continue; "
              "wp=$(sed -n 's/^watcher_pid=//p' \"$lf\" | head -1); "
              "[ -n \"$wp\" ] && kill -0 \"$wp\" 2>/dev/null || continue; "
              "printf '%%s\\t%%s\\n' \"$(basename \"$lf\")\" \"$(sed -n 's/^cwd=//p' \"$lf\" | head -1)\"; done; "
              "true"   # exit 0 garanti si SSH a pu se connecter → returncode ≠0 ⟺ VRAI échec de connexion
              ) % (sep, sep2, sep3, sep4)
    try:
        proc = subprocess.run(
            ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
             "-o", "ControlMaster=auto", "-o", "ControlPath=~/.ssh/dev-cm-%C",
             "-o", "ControlPersist=30s", host, remote],
            capture_output=True, text=True, timeout=12)
    except subprocess.TimeoutExpired:
        return {"error": "unreachable (timeout)"}
    except Exception:
        return {"error": "unreachable"}
    if proc.returncode != 0:
        # ssh n'a pas pu se connecter (box down, refus, auth…). Sans ce test on ne
        # lisait que .stdout (vide) → l'hôte passait pour « 0 session » et disparaissait
        # silencieusement. On classe la cause pour un retour clair à l'utilisateur.
        e = (proc.stderr or "").lower()
        if "timed out" in e or "timeout" in e:                    reason = "unreachable (timeout)"
        elif "refused" in e:                                      reason = "unreachable (refused)"
        elif "permission denied" in e or "publickey" in e:        reason = "auth refused"
        elif "could not resolve" in e or "name or service" in e:  reason = "host not found"
        else:                                                     reason = "unreachable"
        return {"error": reason}
    out = proc.stdout
    reg, _, rest = out.partition(sep)
    busy_raw, _, rest2 = rest.partition(sep2)
    rc_raw, _, rest3 = rest2.partition(sep3)
    live_raw, _, sess_raw = rest3.partition(sep4)
    busy = {x.strip() for x in busy_raw.splitlines() if x.strip()}
    rc_cwds = {x.strip().rstrip("/") for x in rc_raw.splitlines() if x.strip()}
    # vérité terrain : nombre de process claude vivants par cwd
    live_count = {}
    for x in live_raw.splitlines():
        c = x.strip().rstrip("/")
        if c:
            live_count[c] = live_count.get(c, 0) + 1
    # workspaces dont le WATCHER thedev-link est VIVANT (= thedev actif/joignable, prêt à
    # spawner un Claude pour une task/auto). {cwd_normalisé: ws_name}. Même signal
    # que automation-list → cohérence parfaite badge auto ↔ liste.
    alive_watchers = {}
    for x in sess_raw.splitlines():
        x = x.rstrip("\n")
        if not x.strip():
            continue
        parts = x.split("\t")
        if len(parts) < 2:
            continue
        eq, wcwd = parts[0].strip(), parts[1].strip().rstrip("/")
        if wcwd:
            alive_watchers[wcwd] = eq
    groups, order = {}, []
    for line in reg.splitlines():
        p = line.split("\t")
        if len(p) < 7 or not p[0] or p[6].strip() != "0":
            continue
        cwd = p[1]
        g = groups.get(cwd)
        if not g:
            g = {"name": os.path.basename(cwd.rstrip("/")) or cwd, "cwd": cwd, "panes": []}
            groups[cwd] = g
            order.append(cwd)
        g["panes"].append({"name": p[3] or "(claude)", "role": p[2], "busy": p[0] in busy,
                           "started": int(p[5]) if len(p) > 5 and p[5].strip().isdigit() else 0,
                           "rc": (len(p) > 7 and p[7].strip() == "1")})
    sessions = []
    for c in order:
        g = groups[c]
        n = live_count.get(c.rstrip("/"), 0)
        watcher_alive = c.rstrip("/") in alive_watchers   # thedev actif (watcher vivant)
        if n <= 0 and not watcher_alive:
            continue   # ni Claude vivant ni watcher → workspace fermée/fantôme, écartée
        if n > 0:
            # garde les n entrées les plus RÉCENTES : les fantômes (ended==0 jamais
            # nettoyés) sont forcément plus vieux que les panes réellement vivants.
            g["panes"].sort(key=lambda x: x["started"], reverse=True)
            g["panes"] = g["panes"][:n]
            g["panes"].sort(key=lambda x: x["role"] != "main")   # main d'abord (affichage)
            g["claude_dead"] = False
        else:
            # watcher vivant mais AUCUN Claude interactif : workspace joignable (tasks/
            # autos), réattachable via srv. Le watcher rouvrira un Claude à la demande.
            g["panes"] = []
            g["claude_dead"] = True
        g["busy"] = any(pn["busy"] for pn in g["panes"])
        # « remote » si un pane est marqué rc (registre) OU si un process claude en RC
        # tourne dans ce cwd (détection live → couvre les sessions déjà ouvertes).
        g["remote"] = any(pn["rc"] for pn in g["panes"]) or c.rstrip("/") in rc_cwds
        sessions.append(g)
    # Workspaces avec un watcher vivant mais ABSENTES du registre (jamais eu de Claude, ou
    # registre purgé) : ajoutées pour que tout thedev actif/joignable soit visible.
    seen = {s["cwd"].rstrip("/") for s in sessions}
    for wcwd, eq in alive_watchers.items():
        if wcwd in seen:
            continue
        sessions.append({"name": eq or os.path.basename(wcwd) or wcwd, "cwd": wcwd,
                         "panes": [], "busy": False,
                         "remote": wcwd in rc_cwds, "claude_dead": True})
    return {"sessions": sessions}


def fetch_autos(host):
    """automation-list sur <host> ('local' = cette machine) → liste {state,name,next,last,machine}.
    Une automation = un timer systemd --user thedev (cf. bin/automation-list). TSV en entrée."""
    try:
        if host == "local":
            out = subprocess.run(["automation-list"], capture_output=True, text=True, timeout=8).stdout
            label = "local"
        else:
            out = subprocess.run(
                ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
                 "-o", "ControlMaster=auto", "-o", "ControlPath=~/.ssh/dev-cm-%C",
                 "-o", "ControlPersist=30s", host,
                 'PATH="$HOME/.local/bin:$PATH" automation-list'],
                capture_output=True, text=True, timeout=12).stdout
            label = host
    except Exception:
        return []
    autos = []
    for line in out.splitlines():
        p = line.split("\t")
        if len(p) >= 4 and p[1]:
            autos.append({"state": p[0], "name": p[1], "next": p[2], "last": p[3],
                          "workspace": p[4] if len(p) > 4 else "",
                          "cwd": p[5] if len(p) > 5 else "",
                          "desc": p[6] if len(p) > 6 else "",
                          "open": (p[7] == "1") if len(p) > 7 else False,
                          "machine": label})
    return autos


# ----------------------------------------------------------------------------
# Écran « infos » : contexte/version, état live, santé système, abonnement +
# usage Claude. Toutes les données sont LOCALES (la machine où tourne l'home).
# ----------------------------------------------------------------------------
def _read_file(path):
    try:
        with open(os.path.expanduser(path)) as f:
            return f.read()
    except Exception:
        return ""


def _read_json(path):
    try:
        return json.loads(_read_file(path) or "{}")
    except Exception:
        return {}


def fmt_reset(iso):
    """Horodatage ISO (UTC) → « dans 2 h 40 » sous 24 h, sinon « ven. 07:59 ».
    Toujours en heure LOCALE : l'API répond en UTC, afficher ses HH:MM tels quels
    décalait le reset de deux heures."""
    try:
        t = datetime.datetime.fromisoformat(iso).astimezone()
    except Exception:
        return ""
    now = datetime.datetime.now().astimezone()
    sec = int((t - now).total_seconds())
    if sec <= 0:
        return "now"
    if sec < 86400:
        h, m = sec // 3600, sec % 3600 // 60
        return "in %dh%02d" % (h, m) if h else "in %d min" % m
    jours = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    return "%s %s" % (jours[t.weekday()], t.strftime("%H:%M"))


def speedtest_data():
    """Dernier `thedev-metrics --speedtest`, avec une couleur par chiffre. Jamais
    lancé automatiquement : ~25 Mo pris sur le forfait. None si aucune mesure."""
    try:
        f = _read_file(os.path.expanduser("~/.cache/thedev/speedtest")).strip().split("\t")
        d = {"ts": int(f[0]), "down": float(f[1]), "up": float(f[2]),
             "ping": int(f[3]) if f[3] else None, "jit": int(f[4]) if f[4] else None,
             "where": f[6] if len(f) > 6 else ""}
    except Exception:
        return None
    # Seuils usuels : 4K ≈ 25 Mb/s descendant, visio HD ≈ 3 Mb/s montant.
    d["cdown"] = "grn" if d["down"] >= 25 else ("yel" if d["down"] >= 5 else "red")
    d["cup"] = "grn" if d["up"] >= 3 else ("yel" if d["up"] >= 1 else "red")
    p = d["ping"]
    d["cping"] = "" if p is None else ("grn" if p < 50 else ("yel" if p < 100 else "red"))
    age = max(0, int(time.time()) - d["ts"])
    d["age"] = ("<1 min" if age < 60 else "%d min" % (age // 60) if age < 3600
                else "%d h" % (age // 3600) if age < 86400 else "%d d" % (age // 86400))
    return d


def speedtest_rows(d):
    """Vue détail : chaque chiffre traduit en usage concret."""
    def palier(v, paliers):
        for seuil, txt in paliers:
            if v >= seuil:
                return txt
        return paliers[-1][1]
    rows = [("kv", "download", ("%.0f Mb/s  %s" % (d["down"], palier(d["down"], [
                (100, "several 4K videos"), (25, "4K video"), (10, "HD video"),
                (3, "browsing"), (0, "very slow")])), d["cdown"])),
            ("kv", "upload", ("%.1f Mb/s  %s" % (d["up"], palier(d["up"], [
                (10, "fast big uploads"), (3, "HD video call"), (1, "basic video call"),
                (0, "painful uploads")])), d["cup"]))]
    if d["ping"] is not None:
        rows.append(("kv", "ping", ("%d ms  %s" % (d["ping"], "responsive" if d["ping"] < 50 else
                     ("fine" if d["ping"] < 100 else "slow")), d["cping"])))
    if d["jit"] is not None:
        rows.append(("kv", "jitter", "%d ms  (matters for video calls and games)" % d["jit"]))
    rows.append(("kv", "measured", "%s ago%s" % (d["age"], (" on " + d["where"]) if d["where"] else "")))
    return rows


# Modèles Apple par identifiant produit Bluetooth (Modalias bluetooth:v004Cp<PID>).
APPLE_PID = {0x2002: "AirPods", 0x200F: "AirPods 2", 0x2013: "AirPods 3",
             0x2019: "AirPods 4", 0x201B: "AirPods 4 ANC", 0x200E: "AirPods Pro",
             0x2014: "AirPods Pro 2", 0x2024: "AirPods Pro 2 USB-C", 0x200A: "AirPods Max"}


def aap_read(mac, timeout=2.5):
    """Batterie d'écouteurs Apple par leur protocole privé (AAP, L2CAP PSM 0x1001),
    tel que LibrePods l'a documenté (docs/AAP Definitions.md). Apple n'expose PAS la
    batterie standard Bluetooth : c'est la seule voie qui donne gauche, droite et
    boîtier au pourcent, pendant l'écoute, sans root. Lecture seule : poignée de
    main, abonnement aux notifications, on attend le paquet batterie, on ferme.
    Renvoie {"bat": {"gauche"|"droite"|"boîtier": (niveau, état)}, "ear": (a, b)}."""
    import socket, select
    out = {"bat": {}, "ear": None}
    s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_SEQPACKET, socket.BTPROTO_L2CAP)
    try:
        s.settimeout(timeout)
        s.connect((mac, 0x1001))
        s.send(bytes.fromhex("00 00 04 00 01 00 02 00 00 00 00 00 00 00 00 00"))
        s.send(bytes.fromhex("04 00 04 00 0F 00 FF FF FF FF"))
        comp = {0x08: "boîtier", 0x04: "gauche", 0x02: "droite"}
        end = time.time() + timeout
        while time.time() < end and not (out["bat"] and out["ear"]):
            r, _, _ = select.select([s], [], [], 0.3)
            if not r:
                continue
            pk = s.recv(1024)
            if pk[:6] == b"\x04\x00\x04\x00\x04\x00" and len(pk) >= 7:
                for i in range(pk[6]):
                    c, _sp, lvl, st, _e = pk[7 + 5 * i: 12 + 5 * i]
                    if c in comp:
                        out["bat"][comp[c]] = (lvl, st)
            elif pk[:6] == b"\x04\x00\x04\x00\x06\x00" and len(pk) >= 8:
                out["ear"] = (pk[6], pk[7])
    finally:
        s.close()
    return out


def bluetooth_infos(live=None):
    """Appareils Bluetooth CONNECTÉS → lignes de la carte (pas de vue détail).
    Écouteurs Apple : gauche, droite, boîtier par AAP. Autres : la batterie standard
    (Battery1, celle de GNOME) quand l'appareil la publie. Le boîtier ne donne son
    niveau que s'il est proche avec un écouteur dedans : on garde la dernière valeur
    lue en cache, avec son âge, plutôt que de l'afficher « inconnu » la plupart du
    temps. Muet sur une machine sans Bluetooth (serveur)."""
    rows = []
    try:
        out = subprocess.run(["bluetoothctl", "devices", "Connected"],
                             capture_output=True, text=True, timeout=4).stdout
    except Exception:
        return []
    devs = [l.split(" ", 2)[1:] for l in out.splitlines() if l.startswith("Device ")]
    if not devs:
        return [("kv", "bluetooth", ("no device connected", ""))]
    cache_dir = os.path.expanduser("~/.cache/thedev")
    for mac, name in devs:
        try:
            info = subprocess.run(["bluetoothctl", "info", mac], capture_output=True,
                                  text=True, timeout=4).stdout
        except Exception:
            info = ""
        m = re.search(r"Modalias: bluetooth:v004Cp([0-9A-Fa-f]{4})", info)
        icon = (re.search(r"Icon: (\S+)", info) or [None, ""])[1]
        label = name if len(name) <= 12 else name[:11] + "…"
        if m and "audio" in icon:
            model = APPLE_PID.get(int(m.group(1), 16), "Apple earbuds")
            if live is not None:
                a = live.get(mac) or {"bat": {}, "ear": None, "wait": True}
            else:
                try:
                    a = aap_read(mac)
                except Exception:
                    a = {"bat": {}, "ear": None}
            bat = a["bat"]
            cf = os.path.join(cache_dir, "bt-boitier-" + mac.replace(":", ""))
            case = bat.get("boîtier")
            case_age = None
            if case and case[1] != 4:
                try:
                    os.makedirs(cache_dir, exist_ok=True)
                    with open(cf, "w") as f:
                        f.write("%d %d %d" % (int(time.time()), case[0], case[1]))
                except Exception:
                    pass
            else:
                try:
                    ts, lv, st = (int(x) for x in _read_file(cf).split())
                    case, case_age = (lv, st), int(time.time()) - ts
                except Exception:
                    case = None
            chips = []
            for key, short in (("gauche", "L"), ("droite", "R")):
                v = bat.get(key)
                if v and v[1] != 4:
                    chips.append((short, v[0], v[1]))
            if case:
                chips.append(("case", case[0], case[1] if case_age is None else 0))
            if chips:
                rows.append(("buds", label, chips, case_age))
            elif a.get("wait"):
                rows.append(("kv", label, ("reading…", "")))
            else:
                rows.append(("kv", label, ("connected, battery unreadable", "")))
        else:
            b = re.search(r"Battery Percentage: 0x[0-9a-fA-F]+ \((\d+)\)", info)
            if b:
                p = int(b.group(1))
                rows.append(("kv", label, ("%d %%" % p, "red" if p < 15 else "")))
            else:
                rows.append(("kv", label, ("connected", "")))
    return rows


def gather_infos(vps, update_available, head, bt_live=None):
    """Données du dashboard Infos. Renvoie une LISTE de sections [(titre, [items])],
    items = str (ligne dim) ou ('gauge', label, pct, détail) ou ('kv', clé, valeur)."""
    import socket, time, shutil
    sections = []

    # ── thedev ──
    claudes = [p for p in (l.split("\t") for l in _read_file("~/.cache/agents").splitlines())
               if len(p) >= 7 and p[0] and p[6].strip() == "0"]
    neq = len({p[1] for p in claudes})
    njobs = len([l for l in _read_file("~/.cache/thedev-jobs").splitlines() if l.strip()])
    autos_local = fetch_autos("local")
    nact = sum(1 for a in autos_local if a.get("state") in ("active", "running"))
    par_eq = {}
    for p_ in claudes:
        par_eq.setdefault(p_[4] or os.path.basename(p_[1]), []).append(p_[3] or "claude")
    dx = []
    for eq in sorted(par_eq):
        noms = par_eq[eq]
        dx.append(("kv", eq if len(eq) <= 12 else eq[:11] + "…", "%d agent%s   %s" % (
            len(noms), "s" if len(noms) > 1 else "", ", ".join(noms)[:60])))
    if not par_eq:
        dx.append(("kv", "workspaces", "none open"))
    try:
        sl = subprocess.run([os.path.expanduser("~/.local/bin/job"), "list"],
                            capture_output=True, text=True, timeout=4).stdout
        vivants = [l.split()[1] for l in sl.splitlines() if l.startswith("●") and len(l.split()) > 1]
        morts = [l.split()[1] for l in sl.splitlines() if l.startswith("○") and len(l.split()) > 1]
    except Exception:
        vivants, morts = [], []
    dx.append("")
    dx.append(("kv", "jobs", ", ".join(vivants)[:60] if vivants else "none"))
    if morts:
        dx.append(("kv", "dead jobs", (", ".join(morts)[:60], "red")))
    sections.append(("thedev+", dx))
    sections.append(("thedev", [
        ("kv", "version", ("%s  ↑ update available" % (head or "?"), "yel") if update_available
                          else ("%s  ✓" % (head or "?"), "grn")),
        ("chips", "active", [(neq, "workspace", ""), (len(claudes), "agent", ""),
                             (njobs, "job", "")]),
    ]))

    # ── Claude (plan + fenêtre Max 5x via endpoint OAuth) ──
    conf = _read_json("~/.claude.json")
    acc = conf.get("oauthAccount", {})
    cl = []
    try:
        subprocess.run([os.path.expanduser("~/.local/bin/claude-window-usage")],
                       capture_output=True, timeout=6)
    except Exception:
        pass
    win = _read_json("~/.cache/claude-window-usage.json")
    # Les limites viennent de la liste `limits` de l'API : elle inclut la limite
    # hebdo PROPRE À UN MODÈLE, souvent plus haute que la globale, donc celle qui
    # bloque en premier. Repli sur five_hour/seven_day si la liste est absente.
    cx = []
    lims = win.get("limits") or []
    if not lims:
        for key, kind in (("five_hour", "session"), ("seven_day", "weekly_all")):
            v = win.get(key) or {}
            if v.get("utilization") is not None:
                lims.append({"kind": kind, "percent": v["utilization"], "resets_at": v.get("resets_at")})
    for lm in lims:
        k = lm.get("kind")
        if k == "session":
            lbl = "5h window"
        elif k == "weekly_all":
            lbl = "7 days"
        elif k == "weekly_scoped":
            mod = (((lm.get("scope") or {}).get("model") or {}).get("display_name")) or "model"
            lbl = "7 d %s" % mod
        else:
            continue
        rs = fmt_reset(lm.get("resets_at") or "")
        cl.append(("gauge", lbl, lm.get("percent") or 0, ("↻ " + rs) if rs else ""))
    bd = ((win.get("seven_day_breakdown") or {}).get("rows")) or []
    for r_ in bd:
        if r_.get("percent"):
            cx.append(("kv", r_.get("display_name", "?")[:12], "%d %% of the week" % r_["percent"]))
    ex = win.get("extra_usage") or {}
    cx.append(("kv", "extra", ("enabled", "yel") if ex.get("is_enabled") else "disabled"))
    if acc:
        cx.append(("kv", "account", acc.get("emailAddress", "?")))
    if not cl:
        cl.append("(no Claude account detected)")
    sections.append(("Claude", cl))
    sections.append(("Claude+", cx))

    # ── système ──
    health = []
    try:
        mem = {}
        for ln in _read_file("/proc/meminfo").splitlines():
            k, _, v = ln.partition(":")
            mem[k] = int(v.split()[0]) if v.split() else 0
        tot, avail = mem.get("MemTotal", 0) / 1e6, mem.get("MemAvailable", 0) / 1e6
        if tot:
            health.append(("gauge", "RAM", 100 * (tot - avail) / tot, "%.0f/%.0f GB" % (tot - avail, tot)))
    except Exception:
        pass
    try:
        root_dev = os.stat("/").st_dev
    except Exception:
        root_dev = None
    for mnt in ("/", "/data"):
        if mnt != "/":
            if not os.path.isdir(mnt):
                continue
            # Ne montrer un montage non-racine que s'il est sur un FS DISTINCT de /.
            # Sinon /data n'est qu'un dossier de / (pas une partition séparée) → la
            # jauge dupliquerait « disque / » à l'identique = trompeur.
            try:
                if root_dev is not None and os.stat(mnt).st_dev == root_dev:
                    continue
            except Exception:
                continue
        try:
            du = shutil.disk_usage(mnt)
            health.append(("gauge", "disk %s" % mnt, 100 * du.used / du.total, "%.0f GB" % (du.free / 1e9)))
        except Exception:
            pass
    try:
        # charge = jauge VS nombre de cœurs (1 cœur saturé = charge 1). pct = load/cœurs.
        load1 = float(_read_file("/proc/loadavg").split()[0])
        ncpu = os.cpu_count() or 1
        pct = min(100.0, load1 / ncpu * 100)
        health.append(("gauge", "CPU", pct, "%.1f/%d" % (load1, ncpu)))
    except Exception:
        pass
    # chaleur : même jauge que les autres (en % du seuil de bridage du capteur), plus
    # ce que la colonne étroite de la sidebar n'a pas la place de dire — à quel régime
    # souffle le ventilateur, et combien de fois la machine s'est DÉJÀ bridée.
    raw = ""
    try:
        raw = subprocess.run([os.path.expanduser("~/.local/bin/thedev-metrics"), "--raw"],
                             capture_output=True, text=True, timeout=5).stdout
        tp = next((l.split("\t") for l in raw.splitlines() if l.startswith("TEMP\t")), None)
        if tp and len(tp) >= 5 and int(tp[2]):
            t, crit, fan, etouf = int(tp[1]), int(tp[2]), tp[3], tp[4] == "1"
            # La jauge est en % du seuil de bridage, mais on affiche le DEGRÉ : « 51 % »
            # de chaleur ne veut rien dire.
            health.append(("gauge", "heat", 100.0 * t / crit, "", "%d°" % t))
            if etouf:
                health.append(("kv", "airflow", ("blocked", "red")))
    except Exception:
        pass
    try:
        # Bridages thermiques déjà subis (compteurs noyau, depuis le démarrage). C'est la
        # trace des surchauffes passées, invisible autrement : la fréquence s'effondre
        # sans que ni la charge ni la RAM ne bougent, donc aucune autre jauge ne le voit.
        thr = "/sys/devices/system/cpu/cpu0/thermal_throttle/"
        n = int(_read_file(thr + "package_throttle_count") or 0)
        ms = int(_read_file(thr + "package_throttle_total_time_ms") or 0)
        # Seulement s'ils pèsent (> 1 min cumulée) : quelques bridages brefs sont normaux.
        if n and ms > 60000:
            health.append(("kv", "throttling", ("%d×  %.0f s" % (n, ms / 1000.0), "yel")))
    except Exception:
        pass
    try:
        # Capacité pleine actuelle / capacité d'origine. Le libellé ne peut PAS être
        # « batterie » : le bandeau appelle déjà ainsi le niveau de charge, et les deux
        # sont des pourcentages — on lirait « batterie 70 % » comme « il reste 70 % ».
        # « capacité max » est le terme qui dit qu'on parle du plafond, pas du contenu
        # (c'est aussi celui qu'affiche iOS pour la même grandeur).
        # Jauge INVERSE : 100 % est l'état neuf, c'est la chute qui alarme, au contraire
        # de la RAM ou du disque où c'est le remplissage. Seuil de fin de vie annoncé par
        # les constructeurs : 80 %, d'où le passage au jaune à cet endroit.
        bh = next((l.split("\t") for l in raw.splitlines() if l.startswith("BATH\t")), None)
        if bh and len(bh) >= 4:
            health.append(("gaugeinv", "batt. health", int(bh[1]), "%.0f/%.0f Wh" % (float(bh[2]), float(bh[3]))))
    except Exception:
        pass
    sx = []
    try:
        mi = {}
        for ln in _read_file("/proc/meminfo").splitlines():
            k, _, v = ln.partition(":")
            mi[k] = int(v.split()[0]) if v.split() else 0
        st_, sf_ = mi.get("SwapTotal", 0), mi.get("SwapFree", 0)
        if st_:
            # Le swap qui se remplit = la RAM a déjà débordé : la machine rame avant
            # que la jauge RAM n'atteigne le rouge.
            sx.append(("gauge", "swap", 100.0 * (st_ - sf_) / st_, "%.1f/%.0f GB" % ((st_ - sf_) / 1e6, st_ / 1e6)))
    except Exception:
        pass
    try:
        la = _read_file("/proc/loadavg").split()
        sx.append(("kv", "load", "%s   %s   %s   (1, 5, 15 min)" % (la[0], la[1], la[2])))
    except Exception:
        pass
    try:
        if tp and len(tp) >= 5 and int(tp[2]):
            if tp[3] and tp[3] != "0":
                sx.append(("kv", "fan", "%s rpm" % tp[3]))
            sx.append(("kv", "throttle at", "%s°" % tp[2]))
    except Exception:
        pass
    try:
        thr = "/sys/devices/system/cpu/cpu0/thermal_throttle/"
        n_ = int(_read_file(thr + "package_throttle_count") or 0)
        ms_ = int(_read_file(thr + "package_throttle_total_time_ms") or 0)
        sx.append(("kv", "throttling", ("%d, %.0f s total" % (n_, ms_ / 1000.0), "yel" if ms_ > 60000 else "")
                   if n_ else ("none", "grn")))
    except Exception:
        pass
    try:
        if bh and len(bh) >= 5 and bh[4].strip():
            sx.append(("kv", "batt. cycles", bh[4].strip()))
    except Exception:
        pass
    try:
        up = float(_read_file("/proc/uptime").split()[0])
        sx.append(("kv", "uptime", "%dd %dh%02d" % (up // 86400, up % 86400 // 3600, up % 3600 // 60)
                   if up >= 86400 else "%dh%02d" % (up // 3600, up % 3600 // 60)))
    except Exception:
        pass
    sections.append(("system", health))
    sections.append(("system+", sx))

    # ── réseau ──
    # Vue d'ensemble : deux lignes. Le nom du réseau sert de libellé à la jauge de
    # signal, et les trois chiffres du dernier speedtest tiennent sur une ligne,
    # chacun coloré selon ce qu'il permet. Les explications (dBm, usages) sont
    # dans la vue détail : section « réseau+ ».
    net, netx = [], []
    try:
        nl = next((l.split("\t") for l in raw.splitlines() if l.startswith("NET\t")), None)
        if nl and len(nl) >= 2:
            st = nl[1]
            pct = nl[2] if len(nl) > 2 else ""
            name = (nl[3] if len(nl) > 3 else "") or "network"
            vpn = nl[4] if len(nl) > 4 else ""
            spd = nl[5] if len(nl) > 5 else ""
            if st == "down":
                net.append(("kv", "network", ("offline", "red")))
            else:
                tag = "  vpn" if vpn else ""
                dbm = ""
                for ln in _read_file("/proc/net/wireless").splitlines()[2:]:
                    f = ln.split()
                    if len(f) >= 4:
                        dbm = f[3].rstrip(".")
                        break
                short = name if len(name) <= 12 else name[:11] + "…"
                if pct.isdigit():
                    net.append(("gaugesig", short, int(pct), (dbm + " dBm" if dbm else "") + tag))
                    netx.append(("kv", "signal", "%s %% · %s dBm" % (pct, dbm or "?")))
                elif spd:
                    net.append(("kv", short, ("wired %s Mb/s%s" % (spd, tag), "grn")))
                if st != "ok":
                    net.append(("kv", "internet", ("unreachable", "red")))
                if vpn:
                    netx.append(("kv", "vpn", "all traffic" if vpn == "via" else "active, access only"))
    except Exception:
        pass
    sp = speedtest_data()
    if sp:
        cur = locals().get("name", "")
        sp["autre"] = bool(sp["where"] and cur and sp["where"] != cur)
        net.append(("speed", "speed", sp))
        netx.extend(speedtest_rows(sp))
    else:
        net.append(("kv", "speed", ("t to measure", "")))
    if not net:
        net.append("(no network detected)")
    sections.append(("network", net))
    sections.append(("network+", netx))
    bt = bluetooth_infos(live=bt_live)
    if bt:
        sections.append(("Bluetooth", bt))


    return sections


# ----------------------------------------------------------------------------
# Données
# ----------------------------------------------------------------------------
def escape(path):
    return re.sub(r"[^a-zA-Z0-9]", "-", path)


def fmt_date(mtime):
    import time
    return time.strftime("%d %b", time.localtime(mtime))


def fmt_age(mtime):
    """Âge relatif compact (pour les workspaces OUVERTES : « il y a » implicite). Format
    court (≤ 6 car.) pour rester aligné avec les dates des workspaces fermées."""
    import time
    d = max(0, int(time.time() - mtime))
    if d < 60:
        return "now"
    if d < 3600:
        return "%dm" % (d // 60)
    if d < 86400:
        return "%dh" % (d // 3600)
    return "%dd" % (d // 86400)


def short(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home) else path


def fuzzy(query, text):
    """Score de correspondance floue (plus grand = meilleur), ou None si pas de
    correspondance. Sous-chaîne contiguë > début de mot > sous-séquence."""
    if not query:
        return 0
    q, t = query.lower(), text.lower()
    idx = t.find(q)
    if idx != -1:                                   # sous-chaîne contiguë
        s = 1000 - idx
        if idx == 0 or not t[idx - 1].isalnum():
            s += 500                                # bonus début de mot
        return s
    pos, last, gaps = 0, -2, 0                        # sinon sous-séquence
    for ch in q:
        nxt = t.find(ch, pos)
        if nxt == -1:
            return None
        if nxt != last + 1:
            gaps += 1
        last, pos = nxt, nxt + 1
    return 200 - gaps


def _iso_epoch(iso):
    """ISO-8601 (sortie de `engine list`) → epoch float, pour fmt_date/tri."""
    try:
        return datetime.datetime.fromisoformat(iso).timestamp()
    except Exception:
        return 0.0


def load_workspaces():
    """Historique des ESPACES de dev (un par dossier, dédup realpath) via
    l'adaptateur moteur `engine list --all --json`. home n'a plus à
    connaître l'emplacement ni le schéma des transcripts du moteur. On écarte les
    dossiers qui n'existent plus : un dossier renommé/supprimé laisse un transcript
    avec un cwd mort (RESUME → `cd` échoue) → on ne propose pas le lien mort."""
    out = []
    try:
        res = subprocess.run([ENGINE, "list", "--all", "--json"],
                             capture_output=True, text=True, timeout=10)
    except Exception:
        return out
    for line in res.stdout.splitlines():
        if not line.strip():
            continue
        try:
            s = json.loads(line)
        except Exception:
            continue
        cwd = s.get("cwd", "")
        if not cwd or not os.path.isdir(cwd):
            continue
        out.append({"cwd": cwd, "name": os.path.basename(cwd),
                    "id": s.get("id", ""), "mtime": _iso_epoch(s.get("mtime", ""))})
    return out


def list_dirs(path):
    out = []
    try:
        with os.scandir(path) as it:
            for e in it:
                if e.name.startswith("."):
                    continue
                try:
                    if e.is_dir(follow_symlinks=True):
                        out.append((e.path, e.name, e.stat(follow_symlinks=True).st_mtime))
                except OSError:
                    pass
    except OSError:
        pass
    out.sort(key=lambda t: t[2], reverse=True)
    return out


def count_files(path):
    n = 0
    try:
        with os.scandir(path) as it:
            for e in it:
                if e.name.startswith("."):
                    continue
                try:
                    if not e.is_dir(follow_symlinks=True):
                        n += 1
                except OSError:
                    pass
    except OSError:
        pass
    return n


# ----------------------------------------------------------------------------
# TUI
# ----------------------------------------------------------------------------
class Picker:
    def __init__(self, scr, cur_dir):
        self.scr = scr
        self.cur_dir = cur_dir
        self.ws = load_workspaces()   # workspaces de dev (un par dossier, dédup realpath)
        self.live = live_sessions()   # sessions zellij vivantes (basename du cwd)
        self.busy_cwds = set()        # cwd (realpath) des workspaces avec un Claude en plein tour
        self.waiting_cwds = set()     # … bloqué sur une question/permission (t'attend)
        self.stuck_cwds = set()       # … en plein tour depuis > 10 min (probablement coincé)
        self._busy_ts = 0             # throttle de _refresh_busy
        self.vps = vps_label()        # non-vide si on tourne sur un serveur distant
        self.mode = "sessions"        # 'sessions' | 'browser'
        self.solo_page = None         # page ouverte SEULE (--page infos|autos), sans home derrière
        self.new_open = False         # bouton « nouvelle workspace » déplié ? (cibles ici/ailleurs)
        self.focus = "right"          # 'left' | 'right' — démarre sur ACTIONS (quitter présélectionné)
        self.filt = ""
        self.bdir = cur_dir
        self.li = 0                   # index sélection gauche (dans selectables)
        self.ri = 0
        self.loff = 0                 # scroll gauche
        self.decision = None          # ("NEW", cwd) | ("RESUME", cwd, id)
        self.msg = ""
        self.show_all = False         # "voir plus" : déplie toutes les sessions
        self.CAP = 10                 # sessions affichées par section avant "voir plus"
        self.creating = False         # saisie inline du nom de sous-dossier
        self.newname = ""
        # « remote control dispo » : sessions de dev des serveurs + leurs panes
        # Claude, chargées en arrière-plan (SSH) pour ne pas bloquer l'affichage.
        # Rien quand on est déjà sur un serveur (self.vps).
        self.rc_hosts = [] if self.vps else read_machines()
        self.rc_data = {h: {"loading": True} for h in self.rc_hosts}
        self.rc_lock = threading.Lock()
        self.rc_loading = bool(self.rc_hosts)
        self.rc_stop = threading.Event()   # arrête le polling à la fermeture de l'home
        # Une SEULE pinentry à l'ouverture : on déverrouille la clé SSH + on monte le
        # master ControlMaster AVANT le fan-out parallèle (rc + autos). Sans ça, les 4
        # connexions concurrentes réclament chacune la passphrase (cf. _ssh_warmup).
        self.ssh_warmed = threading.Event()
        if self.rc_hosts:
            threading.Thread(target=self._ssh_warmup, daemon=True).start()
            threading.Thread(target=self._rc_worker, daemon=True).start()
        else:
            self.ssh_warmed.set()   # pas d'hôte distant → rien à déverrouiller
        self.carte_nodes = None       # écran org : arbre de nœuds (None = chargement)
        self.ci = 0                   # sélection dans la page org (index sélectionnable)
        # Automatisations (timers thedev) : gather en fond pour le bouton + l'écran dédié.
        self.autos = None
        self.ai = 0                   # sélection dans l'écran automations
        self._autos_flat = []         # automations sélectionnables (rempli par draw_autos)
        self.confirm_del = None       # auto en attente de confirmation de suppression
        threading.Thread(target=self._autos_worker, daemon=True).start()
        # Mise à jour de la config : la machine est-elle en retard sur le git d'où
        # vient sa config dev ? Si oui → bouton « mettre à jour » en tête des actions.
        self.update_available = False
        self.git_checking = True
        threading.Thread(target=self._git_check, daemon=True).start()
        # self.live est capturé une fois ci-dessus ; on le rafraîchit qq sec après
        # l'ouverture pour corriger la race « je reviens à l'home juste après
        # avoir quitté une session » (zellij la liste encore un instant → ● faux).
        self.local_refreshing = True
        threading.Thread(target=self._local_worker, daemon=True).start()
        self.metrics = None           # RAM/disque/load (thedev-metrics) → bande du bas
        threading.Thread(target=self._metrics_worker, daemon=True).start()
        self.infos_data = None        # écran « infos » : rempli en fond à l'ouverture
        self.ii = 0                   # carte sélectionnée dans l'écran Infos
        self.infos_zoom = None        # carte dépliée en grand (None = vue d'ensemble)
        self.infos_panels = []        # titres des cartes, dans l'ordre de navigation
        curses.curs_set(0)
        curses.use_default_colors()
        for i, fg in enumerate((curses.COLOR_GREEN, curses.COLOR_CYAN,
                                curses.COLOR_MAGENTA, curses.COLOR_YELLOW,
                                curses.COLOR_BLUE, curses.COLOR_RED), 1):
            curses.init_pair(i, fg, -1)
        (self.GREEN, self.CYAN, self.MAG, self.YEL,
         self.BLUE, self.RED) = (curses.color_pair(i) for i in range(1, 7))
        # surbrillance de la ligne sélectionnée : une barre gris sombre douce
        # (texte clair en gras sur fond gris discret) plutôt que A_REVERSE, qui
        # produisait un fond blanc éclatant agressif le soir. Repli sur reverse
        # si le terminal n'a pas 256 couleurs.
        self.SEL = curses.A_REVERSE
        try:
            if curses.COLORS >= 256:
                curses.init_pair(7, 252, 237)   # fg gris clair, bg gris sombre
                self.SEL = curses.color_pair(7) | curses.A_BOLD
        except curses.error:
            pass
        # orange vif (256 couleurs) pour « coincé » — distinct du jaune des morts ;
        # repli sur jaune si le terminal n'a pas 256 couleurs.
        self.ORANGE = self.YEL
        try:
            if curses.COLORS >= 256:
                curses.init_pair(8, 208, -1)
                self.ORANGE = curses.color_pair(8)
        except curses.error:
            pass
        # palette stable par projet (tags [projet] colorés différemment)
        self.PALETTE = [self.CYAN, self.MAG, self.YEL, self.BLUE, self.RED, self.GREEN]
        # verts pâles de la landing (ambiance nature dans les zones vides) ;
        # repli sur vert standard atténué sans 256 couleurs
        self.PALE1 = self.PALE2 = self.PALE3 = self.GREEN | curses.A_DIM
        self.BROWN = self.YEL | curses.A_DIM
        self.STARC = self.PALE1 | curses.A_BOLD    # tête de l'étoile filante (repli)
        try:
            if curses.COLORS >= 256:
                for pid, cc in ((9, 151), (10, 108), (11, 65), (12, 94), (13, 231)):
                    curses.init_pair(pid, cc, -1)
                self.PALE1, self.PALE2, self.PALE3 = (curses.color_pair(p) for p in (9, 10, 11))
                self.BROWN = curses.color_pair(12)
                self.STARC = curses.color_pair(13) | curses.A_BOLD   # blanc vif
        except curses.error:
            pass
        self.amb = {}                 # état de l'ambiance par panneau (graine, étoiles, oiseau, île)
        self.amb_last = 0             # dernier tick (temps monotone / 0,4 s)
        self.star_anim = False        # une étoile filante est en cours → refresh accéléré

    def pcolor(self, name):
        return self.PALETTE[sum(name.encode("utf-8")) % len(self.PALETTE)]

    def split_live(self):
        """Sépare les workspaces en (ouvertes ●, récentes). Un workspace est ouverte si
        une session zellij vivante porte son nom (basename). Si deux dossiers
        partagent un basename qui matche une session vivante (rare), un seul
        tourne réellement → on garde le plus récent en ●, l'autre retombe en
        récent : zéro doublon dans « ouverts »."""
        live_by_name, rest = {}, []
        for w in self.ws:
            if w["name"] in self.live:
                cur = live_by_name.get(w["name"])
                if cur is None:
                    live_by_name[w["name"]] = w
                elif w["mtime"] > cur["mtime"]:
                    live_by_name[w["name"]] = w
                    rest.append(cur)
                else:
                    rest.append(w)
            else:
                rest.append(w)
        live = sorted(live_by_name.values(), key=lambda x: -x["mtime"])
        rest.sort(key=lambda x: -x["mtime"])
        return live, rest

    def enter_autos(self):
        self.mode = "autos"
        self.ai = -1                  # bouton Retour sélectionné par défaut
        self._autos_flat = []
        threading.Thread(target=self._autos_worker, daemon=True).start()   # rafraîchit l'état

    def back_page(self):
        """« Retour » depuis une page plein écran (infos / automations).

        Ouverte en solo (`--page`, typiquement lancée depuis la colonne de
        gauche de la page agents), la page n'a PAS de liste de sessions derrière elle :
        Retour doit fermer l'écran — le pane flottant se referme et rend la main
        à la page agents. Sinon, comportement historique : retour au home.
        Renvoie True s'il faut sortir de la boucle."""
        if self.solo_page:
            return True
        self.mode = "sessions"
        self.focus = "left"
        self.li = self.ri = 0
        self.loff = 0
        return False

    def _bt_listen(self):
        """Écoute EN CONTINU les écouteurs Apple tant que la page infos est ouverte.
        Une lecture ponctuelle ne voit que l'état à la connexion ; les AirPods, eux,
        envoient un message à chaque changement (écouteur rangé, boîtier ouvert, charge
        qui démarre), et c'est à ce moment que le boîtier transmet sa batterie. Chaque
        message met à jour l'état puis recalcule les cartes Bluetooth de la page."""
        import socket, select
        try:
            out = subprocess.run(["bluetoothctl", "devices", "Connected"],
                                 capture_output=True, text=True, timeout=4).stdout
        except Exception:
            return
        mac = None
        for l in out.splitlines():
            if not l.startswith("Device "):
                continue
            m_ = l.split(" ", 2)[1]
            try:
                inf = subprocess.run(["bluetoothctl", "info", m_], capture_output=True,
                                     text=True, timeout=4).stdout
            except Exception:
                continue
            if "Modalias: bluetooth:v004C" in inf and "Icon: audio" in inf:
                mac = m_
                break
        if not mac:
            return
        comp = {0x08: "boîtier", 0x04: "gauche", 0x02: "droite"}
        state = {"bat": {}, "ear": None}

        def apply():
            self.bt_state = {mac: dict(state)}
            bt = bluetooth_infos(live=self.bt_state)
            with self.rc_lock:
                if self.infos_data is not None:
                    self.infos_data = [x for x in self.infos_data if x[0] != "Bluetooth"] \
                        + [("Bluetooth", bt)]

        def from_service():
            """État publié par le service bt-reactions, s'il tourne et qu'il est frais.
            Les AirPods n'acceptent qu'UNE connexion : quand le service la tient, la
            page lit son état au lieu d'ouvrir la sienne (qui échouerait)."""
            try:
                with open(os.path.expanduser("~/.cache/thedev/airpods.json")) as f:
                    d = json.load(f)
                os.kill(int(d["pid"]), 0)
                if d.get("mac") != mac or time.time() - d["ts"] > 30:
                    return None
                return {"bat": {k: tuple(v) for k, v in d["bat"].items()},
                        "ear": tuple(d["ear"]) if d.get("ear") else None}
            except Exception:
                return None

        while self.mode == "infos":
            svc = from_service()
            if svc:
                if svc["bat"] and svc != state:
                    state = svc
                    apply()
                time.sleep(2)
                continue
            s_ = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_SEQPACKET, socket.BTPROTO_L2CAP)
            try:
                s_.settimeout(5)
                s_.connect((mac, 0x1001))
                s_.send(bytes.fromhex("00 00 04 00 01 00 02 00 00 00 00 00 00 00 00 00"))
                s_.send(bytes.fromhex("04 00 04 00 0F 00 FF FF FF FF"))
                # Les AirPods n'envoient leur état qu'à la connexion (constaté : rien
                # ne vient quand on range un écouteur) : on se reconnecte toutes les
                # 8 s pour un état frais, sans perdre les notifications entre-temps.
                fin = time.time() + 8
                while self.mode == "infos" and time.time() < fin:
                    r, _, _ = select.select([s_], [], [], 1)
                    if not r:
                        continue
                    pk = s_.recv(1024)
                    if not pk:
                        break
                    changed = False
                    if pk[:6] == b"\x04\x00\x04\x00\x04\x00" and len(pk) >= 7:
                        for i in range(pk[6]):
                            c, _sp, lvl, st, _e = pk[7 + 5 * i: 12 + 5 * i]
                            if c in comp:
                                state["bat"][comp[c]] = (lvl, st)
                        changed = True
                    elif pk[:6] == b"\x04\x00\x04\x00\x06\x00" and len(pk) >= 8:
                        state["ear"] = (pk[6], pk[7])
                        changed = True
                    if changed and state["bat"]:
                        apply()
            except Exception:
                time.sleep(3)          # écouteurs rangés/éteints : on retente
            finally:
                s_.close()

    def enter_infos(self):
        self.mode = "infos"
        self.bt_state = {}
        threading.Thread(target=self._bt_listen, daemon=True).start()
        self.ii = 0                 # carte sélectionnée
        self.infos_zoom = None      # carte dépliée en grand (None = vue d'ensemble)
        self.infos_data = None
        self.speed_running = getattr(self, "speed_running", False)
        threading.Thread(target=self._gather_infos, daemon=True).start()

    def enter_carte(self):
        # Écran org : l'arbre LEADS + SESSIONS (pas les panes), navigable.
        # Données via `org-tree --data` → modèle owner → lead-machine → domaine → session.
        self.mode = "carte"
        self.carte_nodes = None
        self.ci = 0
        threading.Thread(target=self._carte_worker, daemon=True).start()

    def _carte_worker(self):
        try:
            out = subprocess.run(["org-tree", "--data"], capture_output=True, text=True, timeout=8).stdout
        except Exception:
            out = ""
        me = sommet = ""
        rows = []
        etage = {}                       # machine → "split"|"flat" (brique 3, décidé par `reorg`)
        for ln in out.splitlines():
            p = ln.split("\t")
            if p and p[0] == "#meta":
                me = p[1] if len(p) > 1 else ""
                sommet = p[2] if len(p) > 2 else ""
            elif p and p[0] == "#etage":
                if len(p) > 2:
                    etage[p[1]] = p[2]
            elif len(p) >= 6:
                mb = re.match(r'⚠(\d+)', p[4] or "")     # blockers ouverts encodés en tête d'état
                rows.append({"machine": p[0], "domaine": p[1], "workspace": p[2],
                             "live": p[3], "etat": p[4], "ago": p[5],
                             "bloc": int(mb.group(1)) if mb else 0})
        # arbre : owner (racine) → lead par machine → ◆ domaine (header) → session.
        # Sélectionnables : owner + leads + sessions (JAMAIS les panes). Domaine = header.
        is_sommet = bool(sommet) and me == sommet
        self.carte_me = me; self.carte_sommet = sommet     # pour l'en-tête de la page
        machines = ([me] if any(r["machine"] == me for r in rows) else []) + \
                   sorted(m for m in {r["machine"] for r in rows} if m != me)
        # DISSOLUTION : le nœud « owner » n'apparaît que s'il contient ≥2 leads-machine
        # (sur le sommet). Avec UNE seule machine, le lead-machine EST la racine — pas de
        # owner redondant au-dessus d'un unique enfant.
        multi = len(machines) >= 2
        N_SPAN = 7                        # span de contrôle (même valeur que reorg)
        nodes = []
        nodes.append({"lvl": 0, "sel": True, "type": "retour", "label": "‹ Back", "prefix": ""})
        if is_sommet:   glabel = "⌘ owner · all machines"
        elif sommet:    glabel = "⌘ owner · all machines (top %s)" % sommet
        else:           glabel = "⌘ owner · %s" % me
        # ARBRE indenté avec CONNECTEURS (├ └ │) : le owner (apex, toutes les machines) → un lead par
        # MACHINE (son nom = son label) → ses sous-leads. La hiérarchie entre les leads de
        # machines différentes (tous enfants du owner) est ainsi EXPLICITE.
        if multi:
            nodes.append({"lvl": 0, "sel": True, "type": "general",
                          "glyph": "⌘", "name": "owner",
                          "suffix": " · all machines" if (is_sommet or sommet) else " · %s" % me,
                          "label": glabel,
                          "me": me, "sommet": sommet, "rows": rows,
                          "bloc": sum(r["bloc"] for r in rows), "prefix": ""})
        for mi, m in enumerate(machines):
            chef_last = (mi == len(machines) - 1)
            cpref  = ("└─ " if chef_last else "├─ ") if multi else ""
            guide  = ("   " if chef_last else "│  ") if multi else ""
            mrows = [r for r in rows if r["machine"] == m]
            doms = {}
            for r in mrows:
                doms.setdefault(r["domaine"], []).append(r)
            split = etage.get(m) == "split"
            warn = (split and len(doms) > N_SPAN)
            role = "lead"      # tous les leads sont pairs : aucune distinction (couleur/forme/label)
            nlive = sum(1 for r in mrows if r["live"] in ("live", "busy"))
            chef_children = []          # enfants DIRECTS : sous-leads (si scindé) OU sessions
            nodes.append({"lvl": 1 if multi else 0, "sel": True, "type": "chef", "machine": m,
                          "glyph": "⬡", "name": m, "suffix": "  · " + role,
                          "warn": warn, "nlive": nlive,
                          "rows": mrows, "me": me, "sommet": sommet,
                          "label": "⬡ %s · %s" % (m, role),
                          "bloc": sum(r["bloc"] for r in mrows), "children": chef_children,
                          "prefix": cpref})
            scnodes = []                 # sous-leads matérialisés (split, ≥2), pour connecteurs
            for d in sorted(doms):
                drows = doms[d]
                sc_live = sum(1 for r in drows if r["live"] in ("live", "busy"))
                sc_bloc = sum(r["bloc"] for r in drows)
                if split and len(drows) >= 2:
                    scnodes.append((d, drows, sc_bloc, sc_live))
                    chef_children.append({"kind": "souschef", "domaine": d, "n": len(drows),
                                          "live": sc_live, "bloc": sc_bloc})
                else:
                    for r in drows:                       # sessions DIRECTES du lead (droite only)
                        chef_children.append(dict(r, kind="session"))
            for si, (d, drows, sc_bloc, sc_live) in enumerate(scnodes):
                spref = guide + ("└─ " if si == len(scnodes) - 1 else "├─ ")
                nodes.append({"lvl": 2 if multi else 1, "sel": True, "type": "souschef",
                              "machine": m, "domaine": d, "rows": drows,
                              "glyph": "◇", "name": d, "suffix": "", "nlive": sc_live,
                              "me": me, "sommet": sommet, "label": "◇ " + d, "bloc": sc_bloc,
                              "children": [dict(r, kind="session") for r in drows], "prefix": spref})
        with self.rc_lock:
            self.carte_nodes = nodes

    def _open_chef(self):
        """Ouvre le lead sélectionné dans un Claude INTERACTIF (pane flottant, abonnement).
        Un lead est structurel → le convoquer = lancer `lead <node>` qui briefe un Claude
        avec les summaries agrégés du périmètre. owner = toutes les machines ; lead = 1 machine ;
        souschef = 1 domaine."""
        nodes = self.carte_nodes or []
        sel = [n for n in nodes if n.get("sel")]
        if not sel or not (0 <= self.ci < len(sel)):
            return
        node = sel[self.ci]
        t = node.get("type")
        if t == "retour":                       # 1re ligne : retour au home
            self.mode = "sessions"; self.focus = "left"; self.li = self.ri = 0; self.loff = 0
            return
        if t == "chef":
            arg = node.get("machine", "")
        elif t == "souschef":
            arg = "%s/%s" % (node.get("machine", ""), node.get("domaine", ""))
        else:                                   # general → toutes les machines
            arg = ""
        # On ne lance PAS `lead` ici (le TUI tourne dans le pane du home, souvent hors
        # d'une session de workspace → `zellij run` viserait une session au hasard). On émet une
        # DÉCISION, comme pour ouvrir une session : dev() lance `lead <arg>` dans CE pane.
        self.decision = ("CHEF", arg)
        return "quit"

    def _blink_on(self):
        # clignotement ~1 s (même rythme que pane-pulse ◆↔◇), dérivé de l'horloge.
        return int(time.time()) % 2 == 0

    def _refresh_busy(self):
        """Cwd (realpath) des workspaces LOCALES par état : busy (en plein tour) vs
        waiting (bloqué sur une question/permission, il t'attend). Marqueurs frais
        (< 30 min) croisés au registre sid→cwd. Throttle ~1 s (lectures locales)."""
        now = time.time()
        if now - self._busy_ts < 1.0:
            return
        self._busy_ts = now

        def fresh_sids(d):
            d = os.path.expanduser(d); out = set()
            try:
                for f in os.listdir(d):
                    try:
                        if now - os.path.getmtime(os.path.join(d, f)) < 1800:
                            out.add(f)
                    except OSError:
                        pass
            except OSError:
                pass
            return out

        busy, stuck = set(), set()
        bdir = os.path.expanduser("~/.cache/agent-busy")
        try:
            for f in os.listdir(bdir):
                try:
                    age = now - os.path.getmtime(os.path.join(bdir, f))
                except OSError:
                    continue
                if age < 1800:
                    busy.add(f)
                    if age > 600:        # tour en cours depuis > 10 min → probablement coincé
                        stuck.add(f)
        except OSError:
            pass
        wait = fresh_sids("~/.cache/agent-waiting")
        bc, wc, sc = set(), set(), set()
        if busy or wait:
            for line in _read_file("~/.cache/agents").splitlines():
                p = line.split("\t")
                if len(p) < 2:
                    continue
                try:
                    c = os.path.realpath(p[1])
                except OSError:
                    c = p[1]
                if p[0] in busy:
                    bc.add(c)
                if p[0] in stuck:
                    sc.add(c)
                if p[0] in wait:
                    wc.add(c)
        self.busy_cwds, self.waiting_cwds, self.stuck_cwds = bc, wc, sc

    def _local_worker(self):
        # self.live (sessions zellij vivantes → marqueurs « ● en cours ») est figé
        # à l'ouverture. En revenant à l'home juste après avoir quitté une
        # session, zellij peut encore la lister une fraction de seconde → marqueur
        # faux. On rafraîchit ~8 s pour que l'home se corrige tout seul.
        for _ in range(8):
            if self.rc_stop.wait(1):
                break
            try:
                self.live = live_sessions()
            except Exception:
                pass
        self.local_refreshing = False

    def _metrics_worker(self):
        # Métriques limitantes locales (RAM/disque/load) via thedev-metrics --raw
        # → bande du bas, toujours visible. Rafraîchi toutes les 3 s (lectures /proc,
        # quasi gratuit). L'usage Claude n'y est pas (pas lisible localement sans coût).
        while not self.rc_stop.is_set():
            try:
                out = subprocess.run(["thedev-metrics", "--raw"],
                                     capture_output=True, text=True, timeout=4).stdout
                m = []
                for ln in out.splitlines():
                    p = ln.split("\t")
                    if p[0] == "CLAUDE" and len(p) >= 3:
                        el = p[3] if len(p) >= 4 else ""   # écoulé dans la fenêtre (ex. 4h03)
                        m.append(("CLAUDE", p[1], int(p[2]), el))
                    elif p[0] == "RAM" and len(p) >= 2:
                        m.append(("RAM", int(p[1])))
                    elif p[0] == "DISK" and len(p) >= 3:
                        m.append(("DISK", p[1], int(p[2])))
                    elif p[0] == "LOAD" and len(p) >= 3:
                        m.append(("LOAD", float(p[1]), int(p[2])))
                    elif p[0] == "BAT" and len(p) >= 2:
                        st = p[2] if len(p) >= 3 else ""
                        tm = p[3] if len(p) >= 4 else ""
                        m.append(("BAT", int(p[1]), st, tm))
                self.metrics = m
            except Exception:
                pass
            if self.rc_stop.wait(3):
                break

    def _speedtest(self):
        try:
            subprocess.run([os.path.expanduser("~/.local/bin/thedev-metrics"), "--speedtest"],
                           capture_output=True, timeout=60)
            self.msg = ""
        except Exception:
            self.msg = "speed test failed"
        self._gather_infos()
        self.speed_running = False

    def _gather_infos(self):
        head = ""
        try:
            repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
            if os.path.isdir(os.path.join(repo, ".git")):
                head = subprocess.run(["git", "-C", repo, "rev-parse", "--short", "HEAD"],
                                      capture_output=True, text=True, timeout=5).stdout.strip()
        except Exception:
            pass
        d = gather_infos(self.vps, self.update_available, head,
                         bt_live=dict(getattr(self, "bt_state", {})))
        with self.rc_lock:
            # L'écoute a pu recevoir la batterie PENDANT le chargement (souvent dès
            # la connexion, alors qu'il n'y avait encore rien à mettre à jour) : on
            # repart de son état le plus récent, sinon la carte resterait sur
            # « lecture… » jusqu'au prochain changement des écouteurs.
            live = dict(getattr(self, "bt_state", {}))
            if live:
                bt = bluetooth_infos(live=live)
                d = [x for x in d if x[0] != "Bluetooth"] \
                    + [("Bluetooth", bt)]
            self.infos_data = d

    def _git_check(self):
        """En fond : la config (repo git d'où vient thedev) est-elle EN RETARD sur
        origin/main ? On ne montre le bouton QUE s'il manque des commits distants
        en local. Être EN AVANCE (commits locaux pas encore poussés — cas normal
        sur la machine où on édite la config) ne déclenche RIEN. No-op hors clone git."""
        try:
            repo = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
            if os.path.isdir(os.path.join(repo, ".git")):
                # fetch silencieux (met à jour FETCH_HEAD sans toucher le worktree)
                subprocess.run(["git", "-C", repo, "fetch", "-q", "origin", "main"],
                               capture_output=True, text=True, timeout=20)
                # nb de commits présents en distant mais ABSENTS en local (= retard)
                behind = subprocess.run(
                    ["git", "-C", repo, "rev-list", "--count", "HEAD..FETCH_HEAD"],
                    capture_output=True, text=True, timeout=8).stdout.strip()
                if behind.isdigit() and int(behind) > 0:
                    self.update_available = True
        except Exception:
            pass
        finally:
            self.git_checking = False

    def _ssh_warmup(self):
        """Déverrouille la clé SSH (agent/trousseau) et monte le master ControlMaster
        UNE FOIS, séquentiellement, avant que rc_worker/autos_worker ne se connectent
        en parallèle. À froid la clé est verrouillée : chaque connexion concurrente
        déclencherait sa propre pinentry (→ 4 saisies à l'ouverture). Ici la 1re
        connexion qui aboutit déverrouille la clé pour toute la session de login ; les
        hôtes/threads suivants réutilisent l'agent déverrouillé, sans prompt.
        `ssh_warmed` est le feu vert que le fan-out attend."""
        for h in self.rc_hosts:
            if self.rc_stop.is_set():
                break
            try:
                r = subprocess.run(
                    ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
                     "-o", "ControlMaster=auto", "-o", "ControlPath=~/.ssh/dev-cm-%C",
                     "-o", "ControlPersist=60s", h, "true"],
                    capture_output=True, text=True, timeout=12)
                if r.returncode == 0:
                    self.ssh_warmed.set()   # clé déverrouillée → on libère le fan-out
                    break
            except Exception:
                pass
        self.ssh_warmed.set()   # filet : tous injoignables (pas de pinentry si down) → on libère

    def _rc_worker(self):
        """Un thread de rafraîchissement PAR hôte, interrogés EN PARALLÈLE : un VPS
        lent ou injoignable ne retarde plus l'apparition ni le refresh des autres
        (avant, le fetch séquentiel faisait attendre indice derrière un jlax down
        ~6 s). Chaque hôte met à jour sa propre entrée dès que son fetch revient,
        puis reboucle ~4 s. S'arrête quand l'home se ferme (rc_stop)."""
        def host_loop(h):
            self.ssh_warmed.wait(12)   # attend le déverrouillage SSH (1 pinentry) avant de se connecter
            while not self.rc_stop.is_set():
                d = fetch_remote_claudes(h)
                with self.rc_lock:
                    self.rc_data[h] = d
                    self.rc_loading = False
                self.rc_stop.wait(4)   # prochain refresh de CET hôte (ou arrêt immédiat)
        threads = [threading.Thread(target=host_loop, args=(h,), daemon=True)
                   for h in self.rc_hosts]
        for t in threads:
            t.start()
        self.rc_stop.wait()   # le worker attend l'arrêt ; les threads par hôte font le travail

    def _refresh_local(self):
        """Recharge ws + live immédiatement (après rename/kill local)."""
        self.ws = load_workspaces()
        self.live = live_sessions()

    def _refresh_remote(self, host):
        """Déclenche un re-fetch immédiat pour un hôte distant (après kill remote)."""
        def do():
            d = fetch_remote_claudes(host)
            with self.rc_lock:
                self.rc_data[host] = d
        threading.Thread(target=do, daemon=True).start()

    def _autos_worker(self):
        """Gather les automations (timers thedev) : local + chaque VPS. Une passe (les
        timers ne changent pas en continu ; ré-appelé à l'ouverture de l'écran pour fraîcheur)."""
        hosts = ["local"] if self.vps else ["local"] + list(self.rc_hosts)
        res = []
        for h in hosts:
            if self.rc_stop.is_set():
                return
            if h != "local":
                self.ssh_warmed.wait(12)   # attend le déverrouillage SSH avant tout fetch distant
            res.extend(fetch_autos(h))
        with self.rc_lock:
            self.autos = res

    def _auto_systemctl(self, a, shell_cmd, working, done):
        """Joue une commande systemctl --user sur la machine de l'auto (local ou ssh),
        affiche un message, puis rafraîchit l'écran autos. `shell_cmd` = la commande
        shell complète (sans le wrapper ssh). `working`/`done` = messages."""
        self.msg = working
        try:
            if a["machine"] == "local":
                r = subprocess.run(["bash", "-lc", shell_cmd],
                                   capture_output=True, text=True, timeout=10)
            else:
                r = subprocess.run(
                    ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
                     "-o", "ControlPath=~/.ssh/dev-cm-%C", a["machine"],
                     'XDG_RUNTIME_DIR=/run/user/$(id -u) ' + shell_cmd],
                    capture_output=True, text=True, timeout=14)
            self.msg = done if r.returncode == 0 \
                else ("failed: %s" % (r.stderr.strip().splitlines()[-1] if r.stderr.strip() else "?"))
        except Exception as e:
            self.msg = "failed: %s" % e
        with self.rc_lock:
            self.autos = None
        threading.Thread(target=self._autos_worker, daemon=True).start()

    def _reactivate_auto(self, a):
        """État arrêté → actif : (re)démarre le timer. Il reprend son planning ; il lui
        faudra un workspace ouverte (accès Claude) pour s'exécuter vraiment — l'autre axe."""
        u = "%s.timer" % a["name"]
        self._auto_systemctl(a, "systemctl --user start " + u,
                             "reactivating %s…" % a["name"], "%s reactivated" % a["name"])

    def _stop_auto(self, a):
        """État actif → arrêté : stoppe le timer (économise des tokens, plus aucune exécution).
        On la relance d'un ↵ quand on veut."""
        if a["state"] not in ("active", "running"):
            self.msg = "%s is already stopped" % a["name"]; return
        u = "%s.timer" % a["name"]
        self._auto_systemctl(a, "systemctl --user stop " + u,
                             "stopping %s…" % a["name"], "%s stopped" % a["name"])

    def _delete_auto(self, a):
        """Supprime l'automation À TOUT JAMAIS : désactive+stoppe le timer, retire les
        units systemd (timer+service) et recharge le daemon. Le prompt feeds/<nom>.prompt
        reste dans le repo (versionné) — on ne touche pas au dépôt git d'ici."""
        n = a["name"]
        cmd = ("systemctl --user disable --now %s.timer 2>/dev/null; "
               "rm -f ~/.config/systemd/user/%s.timer ~/.config/systemd/user/%s.service; "
               "systemctl --user daemon-reload") % (n, n, n)
        self._auto_systemctl(a, cmd, "deleting %s…" % n, "%s deleted" % n)

    # --- construction des lignes affichées -------------------------------
    def left_rows(self):
        rows = []
        f = self.filt
        if self.mode == "sessions":
            def rank(lst):
                if not f:
                    return lst
                scored = []
                for w in lst:
                    s = fuzzy(f, w["name"])
                    if s is not None:
                        scored.append((s, w))
                scored.sort(key=lambda x: -x[0])
                return [w for _, w in scored]
            # Un workspace = un dossier. Ouverts ● = session zellij vivante (rejoint
            # par attach) ; récents = fermés (même de force), relancés + repris.
            live, rest = self.split_live()
            live, rest = rank(live), rank(rest)
            lim = 10 ** 9 if (self.show_all or f) else self.CAP
            if live:
                rows.append({"kind": "header", "text": "open workspaces"})
                for w in live:
                    rows.append({"kind": "ws", "w": w, "live": True})
            if rest:
                rows.append({"kind": "header", "text": "recent workspaces"})
                for w in rest[:lim]:
                    rows.append({"kind": "ws", "w": w, "live": False})
                if len(rest) > lim:
                    rows.append({"kind": "more", "n": len(rest) - lim})
            if not rows:
                rows.append({"kind": "header", "text": "(no thedev workspace)"})
        else:
            if not f:
                rows.append({"kind": "dir", "path": os.path.dirname(self.bdir), "name": ".."})
                for path, name, _ in list_dirs(self.bdir):
                    rows.append({"kind": "dir", "path": path, "name": name})
            else:
                scored = []
                for path, name, _ in list_dirs(self.bdir):
                    s = fuzzy(f, name)
                    if s is not None:
                        scored.append((s, path, name))
                scored.sort(key=lambda x: -x[0])
                for _, path, name in scored:
                    rows.append({"kind": "dir", "path": path, "name": name})
                if not scored:
                    rows.append({"kind": "header", "text": "(no folder matching \"%s\")" % f})
        return rows

    def right_rows(self):
        if self.mode == "sessions":
            rows = []
            # En tête si la config locale est en retard sur son git d'origine
            # (détecté en fond par _git_check ; clic → git pull côté dev()).
            # 1ʳᵉ action, présélectionnée à l'ouverture (cf. focus="right", ri=0) : quitter.
            # Sur un serveur → revenir au laptop (la session SSH se termine, on retombe sur
            # l'home local) ; en local → sortir de l'home vers le shell.
            if self.vps:
                rows.append({"kind": "act", "id": "quit_vps", "text": "← leave the VPS"})
            else:
                rows.append({"kind": "act", "id": "quit", "text": "⏻ quit thedev"})
            if self.update_available:
                rows.append({"kind": "act", "id": "update_dev", "text": "󰑐 update thedev"})
            # « nouvelle workspace » est un bouton repliable : un clic déplie/replie
            # ses deux cibles (dossier courant · ailleurs). cf. self.new_open.
            rows.append({"kind": "rcgap"})
            rows.append({"kind": "act", "id": "new_menu", "text": "new workspace"})
            if self.new_open:
                # barre verticale à gauche : rattache visuellement les cibles au bouton.
                rows.append({"kind": "act", "id": "new_here",
                             "text": "│ here · %s" % self.cur_dir})
                rows.append({"kind": "act", "id": "browse", "text": "│ elsewhere"})
            # Déjà sur un serveur distant → ne pas proposer de sauter (SSH) vers un autre.
            if not self.vps:
                # Chaque serveur est annoté de son état (connu en fond par _rc_worker) :
                # une croix + « injoignable » (gris) prévient AVANT le clic qu'un saut
                # SSH échouera. L'erreur vit sur la row (rendu segmenté), pas dans le texte.
                with self.rc_lock:
                    states = {h: self.rc_data.get(h, {}) for h in self.rc_hosts}
                for h in self.rc_hosts:
                    d = states.get(h, {})
                    rows.append({"kind": "act", "id": "server:%s" % h,
                                 "text": "server %s" % h,
                                 "err": d.get("error")})
            # Sous les boutons : remote controls dispo (sessions serveur + panes).
            # On n'affiche un hôte que s'il a des sessions (ou est en chargement /
            # injoignable) — pas de ligne « (aucune session) » ni d'en-tête vide.
            if self.rc_hosts:
                rc_rows = []
                with self.rc_lock:
                    for h in self.rc_hosts:
                        d = self.rc_data.get(h, {})
                        if d.get("loading"):
                            rc_rows.append({"kind": "rcinfo", "text": "%s · loading…" % h})
                        elif d.get("error"):
                            pass   # injoignable déjà affiché sur le bouton « ↗ <h> » → pas de doublon ici
                        elif d.get("sessions"):
                            for s in d["sessions"]:
                                rc_rows.append({"kind": "rcsess", "host": h, "name": s["name"],
                                                "cwd": s["cwd"], "nclaude": len(s["panes"]),
                                                "remote": s.get("remote"),
                                                "busy": s.get("busy", False),
                                                "claude_dead": s.get("claude_dead", False)})
                        # aucune session → rien pour cet hôte
                if rc_rows:
                    rows.append({"kind": "rcgap"})   # simple ligne vide (remplace l'ancien titre)
                    rows.extend(rc_rows)
            # épinglé tout en bas du panneau (footer) : écran d'infos pratiques
            with self.rc_lock:
                if self.autos is None:
                    nop = ninact = None
                else:
                    nop = sum(1 for a in self.autos
                              if a["state"] in ("active", "running") and a.get("open"))
                    ninact = len(self.autos) - nop
            # bouton masqué s'il n'y a aucune automation (mais affiché pendant le chargement)
            if nop is None or (nop + ninact) > 0:
                rows.append({"kind": "act", "id": "autos", "footer": True,
                             "text": "↻ automations", "nop": nop, "ninact": ninact})
            rows.append({"kind": "act", "id": "commandement", "text": "⌘ org", "footer": True})
            rows.append({"kind": "act", "id": "infos", "text": "󰋽 info", "footer": True})
            return rows
        rows = [
            {"kind": "act", "id": "start_here", "text": "start here · %s" % self.bdir},
            {"kind": "act", "id": "mksub", "text": "create a folder"},
        ]
        if self.creating:
            rows.append({"kind": "input", "text": self.newname})
        # Espace de dev déjà existant dans ce dossier → une seule reprise
        # (dernière conversation), cohérent avec la vue par dossier.
        real = os.path.realpath(self.bdir)
        w = next((x for x in self.ws if x["cwd"] == real), None)
        if w:
            rows.append({"kind": "header", "text": "resume"})
            rows.append({"kind": "ws", "w": w, "live": w["name"] in self.live})
        return rows

    @staticmethod
    def selectable_idx(rows):
        return [i for i, r in enumerate(rows) if r["kind"] in ("ws", "dir", "act", "more", "rcsess")]

    # --- rendu -----------------------------------------------------------
    def draw_panel(self, win, title, rows, sel_pos, focused, off):
        h, w = win.getmaxyx()
        win.erase()
        win.attrset(self.CYAN if focused else curses.A_DIM)
        win.box()
        win.attrset(0)
        # en-tête aéré : titre en évidence + filet, puis une ligne vide.
        win.addnstr(1, 2, title, w - 4, (self.CYAN | curses.A_BOLD) if focused else (curses.A_BOLD | curses.A_DIM))
        try:
            win.addnstr(2, 2, "─" * (w - 4), w - 4, curses.A_DIM)
        except curses.error:
            pass
        TOP = 4                         # ligne 3 laissée vide (aération)
        # Lignes marquées "footer" : la SUITE finale → épinglées tout en bas, dans l'ordre
        # (ex. autos puis infos), juste au-dessus de la bordure. Le reste défile.
        nfoot = 0
        while nfoot < len(rows) and rows[len(rows) - 1 - nfoot].get("footer"):
            nfoot += 1
        footers = rows[len(rows) - nfoot:] if nfoot else []
        body = rows[:len(rows) - nfoot] if nfoot else rows
        inner = (h - TOP - 1) - nfoot
        sels = self.selectable_idx(rows)          # indices dans `rows` complet
        cur_row = sels[sel_pos] if sels and 0 <= sel_pos < len(sels) else -1

        def paint(yy, row, is_sel):
            x = 2
            for text, attr in self.render_row(row, is_sel):
                avail = (w - 2) - x
                if avail <= 0:
                    break
                try:
                    win.addnstr(yy, x, text, avail, attr)
                except curses.error:
                    pass
                x += len(text)
            if is_sel:                            # surbrillance pleine largeur
                try:
                    win.chgat(yy, 1, w - 2, self.SEL)
                except curses.error:
                    pass

        # corps défilant (le footer n'entre pas dans le scroll)
        if 0 <= cur_row < len(body):
            if cur_row < off:
                off = cur_row
            elif cur_row >= off + inner:
                off = cur_row - inner + 1
        while off > 0 and body[off - 1]["kind"] == "header":
            off -= 1
        y = TOP
        for i in range(off, min(len(body), off + inner)):
            paint(y, body[i], i == cur_row and focused)
            y += 1
        base = len(rows) - nfoot                  # footers épinglés en bas, dans l'ordre
        for k, frow in enumerate(footers):
            paint((h - 1 - nfoot) + k, frow, cur_row == (base + k) and focused)
        win.noutrefresh()
        return off

    # --- ambiance (zones vides) : étoiles + oiseau occasionnel + mini-île ------
    # Règles UX : uniquement l'espace MORT d'un panneau (sous les lignes, au-dessus
    # des footers), recalculé à chaque draw → si le contenu grandit, l'ambiance
    # recule d'elle-même. Rythme temps réel (tick 0,4 s, indépendant des redraws
    # clavier), figé pendant une saisie inline. Palette : verts pâles de la landing.
    def _amb_free(self, rows, h):
        """(y0, y1) de la zone vide d'un panneau tel que peint par draw_panel."""
        nfoot = 0
        while nfoot < len(rows) and rows[len(rows) - 1 - nfoot].get("footer"):
            nfoot += 1
        inner = (h - 4 - 1) - nfoot
        used = min(len(rows) - nfoot, inner)
        return 4 + used + 2, h - 3 - nfoot

    AMB_L1 = '▀█▀ █ █ █▀▀ █▀▄ █▀▀ █ █'
    AMB_L2 = ' █  █▀█ █▀▀ █ █ █▀▀ ▀▄▀'
    AMB_L3 = ' ▀  ▀ ▀ ▀▀▀ ▀▀  ▀▀▀  ▀ '

    def draw_ambiance(self, key, win, rows):
        """Ambiance simple : quelques étoiles qui scintillent + un oiseau qui
        traverse de temps en temps la zone VIDE du panneau (recalculée à chaque
        draw — si le contenu grandit, l'ambiance recule). Figée pendant une
        saisie inline ; horloge temps réel par panneau (tick 0,4 s)."""
        import random
        h, w = win.getmaxyx()
        y0, y1 = self._amb_free(rows, h)
        if y1 - y0 < 3 or w < 24:
            self.amb.pop(key, None)
            return
        tick = int(time.monotonic() / 0.4)
        st = self.amb.get(key)
        if not st or st["wh"] != (w, h, y0, y1):
            rng = random.Random()
            nstars = max(4, min(12, ((y1 - y0 + 1) * w) // 150))
            stars = [(rng.randrange(y0, y1 + 1), rng.randrange(2, w - 2), rng.randrange(9))
                     for _ in range(nstars)]
            birds = [{"on": False, "wait": 8 + rng.randrange(20), "x": 2, "y": y0}]
            st = {"wh": (w, h, y0, y1), "stars": stars, "last": tick, "birds": birds}
            if key == "L":
                # « la colline » : le sol s'élève d'un niveau en plateau doux, un
                # arbre unique en silhouette au sommet, herbes sur les pentes.
                # Même langage que la landing : ▄ clair (108) sur corps sombre (65).
                hc = (w * 55) // 100 + rng.randrange(max(1, (w * 30) // 100))
                hw = max(9, w // 7) + rng.randrange(max(1, w // 9))
                hc = min(hc, w - hw - 4)                          # colline à droite, entière
                gh = [1 if abs(x - hc) <= hw else 0 for x in range(w)]
                gcol = [rng.randrange(3) == 0 for _ in range(w)]
                grass = []
                for _ in range(max(4, w // 18)):
                    gx = 3 + rng.randrange(max(1, w - 6))
                    if abs(gx - hc) < 4 or hw - 2 <= abs(gx - hc) <= hw + 2:
                        continue                    # ni collée au tronc, ni sur les pentes
                    grass.append((gx, rng.randrange(3) == 0))
                st["ground"] = {"tree": hc, "grass": grass, "gh": gh,
                                "gcol": gcol, "seed": rng.randrange(10000)}
            self.amb[key] = st
        dt = 0 if self.creating else max(0, min(4, tick - st["last"]))
        st["last"] = tick
        # — étoiles : scintillement très lent (une sur neuf brille à la fois)
        for sy, sx, ph in st["stars"]:
            a = self.PALE1 if (tick // 5 + ph) % 9 == 0 else curses.A_DIM
            try:
                win.addstr(sy, sx, "·", a)
            except curses.error:
                pass
        # — oiseaux : chacun traverse la zone à son rythme
        for j, b in enumerate(st["birds"]):
            if not b["on"]:
                b["wait"] -= dt
                if b["wait"] <= 0:
                    b.update(on=True, x=2, y=random.randrange(y0, y1 + 1))
            else:
                b["x"] += dt
                if b["x"] >= w - 3:
                    b.update(on=False, wait=25 + random.randrange(50))
            if b["on"]:
                try:
                    win.addstr(b["y"], b["x"], "^" if (tick + j) % 2 else "v", curses.A_DIM)
                except curses.error:
                    pass
        # — « la colline » (panneau gauche) : sol à deux niveaux (plateau ▄ clair
        # sur corps █ sombre), arbre au sommet (tronc brun, canopée 3-5-3 en verts
        # mélangés, cime qui penche), herbes dont la vague de vent descend la pente.
        g = st.get("ground")
        if g:
            gy = y1 + 1
            gh = g["gh"]
            for x in range(1, w - 1):
                # blocs PLEINS (█) pour que l'herbe posée dessus touche le sol ;
                # les demi-blocs ▄ ne servent qu'aux pentes de la colline.
                try:
                    if gh[x]:
                        win.addstr(gy, x, "█", self.PALE3 | curses.A_DIM)
                        edge = not (0 <= x - 1 < w and gh[x - 1]) or not (0 <= x + 1 < w and gh[x + 1])
                        win.addstr(gy - 1, x, "▄" if edge else "█", self.PALE2 | curses.A_DIM)
                    else:
                        a = self.PALE2 if g["gcol"][x] else self.PALE3
                        win.addstr(gy, x, "█", a | curses.A_DIM)
                except curses.error:
                    pass
            # — ÉTOILE FILANTE : timing en secondes (mouvement fluide même à faible
            # taux de rafraîchissement). D1 dérive lente · D2 accélération · D3 sortie.
            D1, D2, D3 = 3.6, 1.7, 1.2
            wd = st.get("wind")
            if wd is None:
                # première étoile filante DÈS l'ouverture, puis à intervalles variés
                wd = {"on": False, "t": tick, "n": 0}
                st["wind"] = wd
            if not wd["on"] and tick >= wd["t"]:
                # une ÉTOILE FILANTE en 4 actes : un point naît et dérive à peine,
                # sa lumière monte et il grossit, puis la vitesse explose (easing
                # quadratique) et il DEVIENT une traînée qui file au-dessus de
                # l'arbre. Chemin figé (Bresenham) + timeline de positions (hp).
                dh = min(30, (w * 2) // 5)                    # course longue, horizontale
                sy0 = sy1 = gy - 7                            # y CONSTANT, au-dessus de l'arbre
                sx1 = min(w - 3, g["tree"] + 6)
                sx0 = max(2, sx1 - dh)
                path = []
                xx, yy = sx0, sy0
                ex, ey = sx1, sy1
                dxp, dyp = abs(ex - xx), abs(ey - yy)
                stx = 1 if ex >= xx else -1
                sty = 1 if ey >= yy else -1
                if dxp >= dyp:
                    err = dxp // 2
                    for _ in range(dxp + 1):
                        path.append((xx, yy)); err -= dyp
                        if err < 0: yy += sty; err += dxp
                        xx += stx
                else:
                    err = dyp // 2
                    for _ in range(dyp + 1):
                        path.append((xx, yy)); err -= dxp
                        if err < 0: xx += stx; err += dyp
                        yy += sty
                # position pilotée par le TEMPS continu (voir pos() au rendu) ; on ne
                # fige ici que le chemin, le point de rupture P1 et l'instant eW où la
                # tête franchit l'arbre (→ coup de vent).
                M = len(path)
                P1 = max(2, M // 5)
                ti = max(0, min(M - 1, g["tree"] - sx0))
                if ti <= P1:
                    eW = D1 * (ti / max(1, P1))
                else:
                    eW = D1 + D2 * (((ti - P1) / max(1, M - 1 - P1)) ** (1 / 2.4))
                wd.update(on=True, t0=tick, ts=time.monotonic(), path=path,
                          P1=P1, M=M, eW=eW, n=wd["n"] + 1,
                          end=tick + int((D1 + D2 + D3) / 0.4) + 2)
            elif wd["on"] and tick >= wd["end"]:
                wd.update(on=False, t=tick + 7 + random.randrange(12))
            flyby = wd["on"] and not self.creating
            # coup de vent sur l'arbre juste APRÈS le passage de l'étoile au-dessus
            wake = False
            if flyby and "ts" in wd:
                wake = 0 <= (time.monotonic() - wd["ts"]) - wd["eW"] <= 1.6
            for gx, tall in g["grass"]:
                sy = gy - 1 - gh[gx]
                ph = (tick // 2 + gx // 4) % 2 if wake else 0   # vague au passage de l'avion
                try:
                    if tall:                      # herbe haute : pointe qui se couche
                        win.addstr(sy - 1, gx, "/" if ph else "|", self.PALE2 | curses.A_DIM)
                        win.addstr(sy, gx, "|", self.PALE3 | curses.A_DIM)
                    else:
                        win.addstr(sy, gx, "'" if ph else ",", self.PALE2 | curses.A_DIM)
                except curses.error:
                    pass
            if y1 - y0 >= 4:                      # place pour l'arbre complet
                import random as _rr
                tx = g["tree"]
                wind = 1 if wake else 0           # la cime ploie brièvement dans le sillage
                rnd = _rr.Random(g["seed"] + wd["n"])     # remélange une fois par passage
                shim = _rr.Random(g["seed"] * 31 + tick // 2)  # bruissement continu :
                pal = (self.PALE1, self.PALE2, self.PALE3)     # ~1 feuille sur 4 change
                try:                                           # de vert toutes les 0,8 s
                    win.addstr(gy - 1, tx, "█", self.BROWN | curses.A_DIM)   # tronc dans le plateau
                    win.addstr(gy - 2, tx, "█", self.BROWN | curses.A_DIM)
                    # sillage → le haut de la canopée penche d'une case à DROITE :
                    # le pixel le plus à gauche des feuilles s'efface un instant.
                    for row, cw, off in ((gy - 3, 1, 0), (gy - 4, 2, wind), (gy - 5, 1, wind)):
                        for cx in range(tx - cw + off, tx + cw + off + 1):
                            c = rnd.choice(pal)
                            if shim.random() < 0.25:
                                c = shim.choice(pal)
                            win.addstr(row, cx, "█", c)
                except curses.error:
                    pass
                # — l'ÉTOILE FILANTE, en 4 actes le long du chemin :
                #   1 naissance : un point faible dérive imperceptiblement ;
                #   2 incandescence : la lumière monte par paliers, le point grossit
                #     (flancs lumineux) tout en accélérant doucement ;
                #   3 rupture : la vitesse explose, le point DEVIENT une traînée en
                #     dégradé qui file au-dessus de l'arbre ;
                #   4 évanouissement : la traînée glisse hors du chemin et s'éteint.
                if flyby and wd.get("path"):
                    self.star_anim = True                   # → run() rafraîchit plus vite
                    path, M, P1 = wd["path"], wd["M"], wd["P1"]
                    e = time.monotonic() - wd["ts"]
                    vexit = 2.4 * (M - 1 - P1) / D2          # vitesse à la rupture (cases/s)

                    def pos(t):                             # index continu de la tête
                        if t < D1:
                            return P1 * (t / D1)             # dérive lente, linéaire
                        if t < D1 + D2:
                            u = (t - D1) / D2
                            return P1 + (M - 1 - P1) * (u ** 2.4)   # accélération
                        return (M - 1) + (t - D1 - D2) * vexit      # sortie à vitesse max
                    hf = pos(e)
                    head = int(hf)
                    v = hf - pos(max(0.0, e - 0.33))        # vitesse instantanée (cases/0,33 s)

                    def put(idx, gl, at):
                        if 0 <= idx < M:
                            x, y = path[idx]
                            if 2 <= x <= w - 2 and y0 <= y <= y1:
                                try:
                                    win.addstr(y, x, gl, at)
                                except curses.error:
                                    pass
                    # tête : la lumière monte pendant la dérive lente, puis éclat
                    grow = ((".", self.PALE3 | curses.A_DIM), ("·", self.PALE3),
                            ("·", self.PALE2), ("•", self.PALE2),
                            ("•", self.PALE1), ("✦", self.PALE1 | curses.A_BOLD),
                            ("✦", self.STARC))
                    if e < D1:
                        gl, at = grow[min(len(grow) - 1, int(len(grow) * e / D1))]
                    else:
                        gl, at = "✦", self.STARC
                    if head < M:
                        put(head, gl, at)
                    # traînée : n'existe qu'avec la VITESSE ; longueur ∝ vitesse, dégradé
                    # vif → éteint. Comme elle suit la vitesse, elle POUSSE case par case
                    # (elle ne surgit pas d'un coup) et comble l'écart entre deux frames.
                    if v >= 2.2:
                        L = max(2, min(12, int(v * 1.4)))
                        grad = (("✧", self.PALE1 | curses.A_BOLD), ("✦", self.PALE1),
                                ("•", self.PALE2), ("·", self.PALE2 | curses.A_DIM),
                                ("·", self.PALE3 | curses.A_DIM), ("·", curses.A_DIM))
                        for i in range(1, L + 1):
                            gi = min(len(grad) - 1, (i * len(grad)) // (L + 1))
                            put(head - i, *grad[gi])
        win.noutrefresh()

    def _auto_count(self, machine, cwd):
        """(total, arrêtées) des automations rattachées à (machine, cwd) — pour le badge.
        Matching par CWD (le dossier de le workspace) et non par nom : robuste même si le nom
        de session diffère du basename du cwd. Le 2e nombre alimente le ○ rouge (timer stoppé)."""
        c = (cwd or "").rstrip("/")
        if not c:
            return (0, 0)
        rel = [a for a in (self.autos or [])
               if a.get("machine") == machine and (a.get("cwd") or "").rstrip("/") == c]
        ns = sum(1 for a in rel
                 if not (a["state"] in ("active", "running") and a.get("open")))
        return (len(rel), ns)

    def _auto_badge(self, machine, cwd):
        """Segments du badge auto pour une ligne de session, même affichage que le footer :
        ● N opérationnelles (violet) + ○ M inactives (rouge). Rien si aucune auto rattachée ;
        pas de puce pour un compteur nul."""
        na, ns = self._auto_count(machine, cwd)
        if not na:
            return []
        nop = na - ns
        segs = []
        if nop:
            segs.append(("  ● %d" % nop, self.MAG | curses.A_BOLD))
        if ns:
            segs.append(("  ○ %d" % ns, self.RED | curses.A_BOLD))
        return segs

    def render_row(self, r, is_sel):
        """Retourne une liste de segments [(texte, attr), …]."""
        if r["kind"] == "header":
            return [(r["text"], self.CYAN | curses.A_BOLD)]
        if r["kind"] == "rcgap":      # ligne vide de séparation (remplace l'ancien titre)
            return [("", 0)]
        if r["kind"] == "rcinfo":     # état (chargement / injoignable)
            return [("  " + r["text"], curses.A_DIM)]
        if r["kind"] == "subhdr":     # mini-entête grise d'un groupe d'actions
            return [("  " + r["text"], curses.A_DIM)]
        if r["kind"] == "rcsess":     # « ● <vps>.remote.<workspace> (<n claude>) » — point vert = session avec Claude ;
            p = "▸ " if is_sel else "  "   # ○ jaune = thedev actif (watcher vivant) SANS Claude interactif.
            # ● vert = au moins 1 Claude debout, suivi de (n). ○ jaune = 0 Claude → on
            # n'affiche PAS « (0) » (le ○ le dit déjà). Pas de mot « détaché » : toute
            # session distante l'est de toute façon.
            if r.get("claude_dead"):
                dot = ("○ ", self.YEL | curses.A_BOLD)
            elif r.get("busy"):                       # Claude en plein tour → ●↔○ vert qui pulse
                dot = ("● ", self.GREEN | curses.A_BOLD) if self._blink_on() else ("○ ", self.GREEN | curses.A_BOLD)
            else:
                dot = ("● ", self.GREEN | curses.A_BOLD)
            segs = [(p, 0), dot, ("%s." % r["host"], 0)]
            if r.get("remote"):
                segs += [("remote", curses.A_DIM), (".", 0)]
            segs += [(r["name"], 0)]
            nc = r.get("nclaude", 0)
            if nc:                                  # 0 Claude → rien (le ○ le dit déjà)
                segs += [("  (%d)" % nc, curses.A_DIM)]
            segs += self._auto_badge(r["host"], r.get("cwd", ""))
            return segs
        if r["kind"] == "input":
            return [("    ▸ " + r.get("text", "") + "▏", self.GREEN | curses.A_BOLD)]
        p = "▸ " if is_sel else "  "
        if r["kind"] == "more":
            return [(p + "show more… (%d more)" % r.get("n", 0),
                     curses.A_REVERSE if is_sel else curses.A_DIM)]
        if r["kind"] == "act":
            if r.get("id") == "update_dev":   # mise à jour dispo : jaune, bien visible
                return [(p + r["text"], self.YEL | curses.A_BOLD)]
            if r.get("id") == "autos":        # automations : ● violet opérationnelles + ○ rouge inactives
                segs = [(p + r["text"], self.MAG | curses.A_BOLD)]
                nop, ninact = r.get("nop"), r.get("ninact")
                if nop is None:               # autos pas encore récupérées → chargement
                    segs.append(("  loading…", curses.A_DIM))
                else:
                    if nop:                   # pas de puce opérationnelle si 0
                        segs.append(("  ● %d" % nop, self.MAG | curses.A_BOLD))
                    if ninact:                # pas de puce inactive si 0
                        segs.append(("  ○ %d" % ninact, self.RED | curses.A_BOLD))
                return segs
            if r.get("id") in ("quit", "quit_vps"):
                return [(p + r["text"], curses.A_DIM)]
            if r.get("id") in ("new_here", "browse"):   # cibles déroulées : gris, pas vert
                return [(p + r["text"], curses.A_DIM)]
            segs = [(p + r["text"], self.GREEN)]
            if r.get("err"):                  # serveur injoignable : croix + raison en gris
                segs += [("  ✗ ", curses.A_DIM), (r["err"], curses.A_DIM)]
            return segs
        if r["kind"] == "dir":
            return [(p + r["name"], self.CYAN)]
        # ws : un workspace de dev (dossier). ● si la session zellij tourne.
        #   ● 08 Jun  diakhrisma   (vivant : nom en cyan gras)
        #     06 Jun  gus_project  (fermé : nom coloré par projet)
        w = r["w"]
        live = r.get("live")
        if live and w.get("cwd") in self.waiting_cwds:   # t'attend (question/permission) → ◆ cyan fixe
            dot = ("◆ ", self.CYAN | curses.A_BOLD)
        elif live and w.get("cwd") in self.stuck_cwds:   # calcule depuis > 10 min → coincé ? ● orange fixe
            dot = ("● ", self.ORANGE | curses.A_BOLD)
        elif live and w.get("cwd") in self.busy_cwds:    # en plein tour → ●↔○ vert qui pulse
            dot = ("● ", self.GREEN | curses.A_BOLD) if self._blink_on() else ("○ ", self.GREEN | curses.A_BOLD)
        elif live:
            dot = ("● ", self.GREEN)
        else:
            dot = ("  ", 0)
        # ouverts → âge relatif (il y a 2m / 1h) ; fermés → date (bossé le 18 Jun)
        when = ("%-6s  " % fmt_age(w["mtime"])) if live else (fmt_date(w["mtime"]) + "  ")
        segs = [(p, 0), dot, (when, curses.A_DIM)]
        if self.vps:                  # sur un VPS : ces sessions sont « remote » (préfixe gris)
            segs.append(("remote.", curses.A_DIM))
        segs.append((w["name"], (self.CYAN | curses.A_BOLD) if live else self.pcolor(w["name"])))
        segs += self._auto_badge("local", w.get("cwd", ""))
        return segs

    def header_line(self):
        if self.mode == "sessions":
            if self.filt:
                return "filter: %s_   (Esc clears)" % self.filt
            li = self.left_item() if self.focus == "left" else None
            if li and li.get("kind") == "ws":
                live = li.get("live") or li["w"]["name"] in self.live
                base = "↵ open · ^R rename · ^Del delete"
                return base + " · ^Q close" if live else base
            if li and li.get("kind") == "rcsess":
                return "↵ open · ^Q close"
            return "thedev · ↑↓ navigate · ↵ select · Esc quit"
        nf = count_files(self.bdir)
        nd = len(list_dirs(self.bdir))
        return "%s · %d folders · %d files" % (self.bdir, nd, nf)

    def draw_status(self, H, W):
        """Ligne du bas = barre de statut : où on opère (VPS distant ou local),
        puis le message transitoire éventuel (création de dossier, hint Ctrl-R…)."""
        col = 2
        if self.vps:   # serveur distant : badge rouge bien visible
            badge = " VPS · %s " % self.vps
            self.scr.addnstr(H - 1, col, badge, max(0, W - col - 1),
                             self.RED | curses.A_BOLD | curses.A_REVERSE)
            col += len(badge) + 1
        else:          # machine locale
            tag = " local "
            self.scr.addnstr(H - 1, col, tag, max(0, W - col - 1),
                             curses.A_DIM | curses.A_REVERSE)
            col += len(tag) + 1
        if self.msg:
            self.scr.addnstr(H - 1, col, self.msg, max(0, W - col - 1), self.YEL)
        # Coin bas-droit : HEURE + BATTERIE, rien d'autre. Les jauges détaillées
        # (fenêtre Claude, RAM, disque, charge) ont déménagé dans la colonne de
        # gauche de la page agents (`sidebar`), où elles sont visibles en permanence pendant
        # le travail — les répéter ici ne ferait que charger l'écran.
        if True:
            segs = [(time.strftime("%H:%M"), curses.A_DIM)]
            for it in (self.metrics or []):
                if it[0] != "BAT":
                    continue
                # Couleurs RÉSERVÉES : vert = en charge, rouge = batterie
                # faible ; neutre sinon. Pas de flèche — le temps restant dit
                # déjà le sens.
                p, st, tm = it[1], it[2], it[3]
                c = self.GREEN if st == "chg" else (self.RED if p < 15 else 0)
                segs += [(" │ ", curses.A_DIM), ("bat ", curses.A_DIM),
                         ("%d%%" % p, c)]
                if tm:
                    segs.append((" %s" % tm, curses.A_DIM))
            total = sum(len(t) for t, _ in segs)
            x = W - 2 - total
            if x > col + 1:               # ne pas écraser le badge/msg
                for t, a in segs:
                    try:
                        self.scr.addnstr(H - 1, x, t, max(0, W - 1 - x), a)
                    except curses.error:
                        pass
                    x += len(t)

    def draw_carte(self):
        # Écran org — DEUX panneaux : à gauche l'arbre LEADS + SESSIONS
        # (navigable, jamais les panes) ; à droite le CONTEXTE du nœud sélectionné.
        self.scr.erase()
        H, W = self.scr.getmaxyx()
        DIM = curses.A_DIM
        G, C, R = self.GREEN, self.CYAN, self.RED
        _me = getattr(self, "carte_me", ""); _som = getattr(self, "carte_sommet", "")
        hdr = "⌘ ORG"
        if _me: hdr += "  ·  view from %s" % _me
        self.scr.addnstr(0, 2, hdr, W - 4, C | curses.A_BOLD)
        with self.rc_lock:
            nodes = self.carte_nodes
        if nodes is None:
            try:
                self.scr.addnstr(1, 2, "─" * (W - 4), W - 4, DIM)
                self.scr.addnstr(3, 2, "loading the org tree…", W - 4, DIM)
            except curses.error: pass
            self.scr.refresh(); return
        # ── sous-en-tête : les appareils que COUVRE l'arbre + qui POSSÈDE le owner ──
        machines = [n["machine"] for n in nodes if n.get("type") == "chef"]
        owner = _som or _me                        # la machine qui tient le owner
        mlist = " · ".join(machines) or "—"
        try:
            x = 2
            self.scr.addnstr(1, x, "machines: ", W - 4, DIM); x += len("machines: ")
            self.scr.addnstr(1, x, mlist, max(0, W - 1 - x), C | curses.A_BOLD); x += len(mlist)
            if owner:
                tail = "   ·   owner on %s" % owner
                self.scr.addnstr(1, x, tail, max(0, W - 1 - x), DIM)
            self.scr.addnstr(2, 2, "─" * (W - 4), W - 4, DIM)
        except curses.error:
            pass
        sel_idx = [i for i, n in enumerate(nodes) if n["sel"]]
        if not sel_idx:
            try: self.scr.addnstr(3, 2, "(no known workspace: the namespace fills in as workspaces open and sync up)", W - 4, DIM)
            except curses.error: pass
            self.scr.refresh(); return
        self.ci = max(0, min(self.ci, len(sel_idx) - 1))
        cur = sel_idx[self.ci]
        lw = (W * 55) // 100
        # ── gauche : l'arbre, hiérarchie PAR LA COULEUR (un rôle = une couleur) ──
        #   ⌘ owner = magenta · ⬡ lead = cyan + nom machine en clair · ◇ domaine = jaune
        #   connecteurs grisés · ● N actives en vert · ⚠ blockers en rouge
        def lput(row, x0, segs):                   # segments colorés, bornés au panneau gauche
            x = x0
            for s, a in segs:
                if x >= lw - 1: break
                try: self.scr.addnstr(row, x, s, lw - 1 - x, a)
                except curses.error: pass
                x += len(s)
        y = 3
        for i, n in enumerate(nodes):
            if y >= H - 1:
                break
            t = n["type"]; prefix = n.get("prefix", "")
            if t == "retour":
                try: self.scr.addnstr(y, 2, n["label"], lw - 3, self.SEL if i == cur else DIM)
                except curses.error: pass
                y += 2; continue                    # respiration après Retour
            if i == cur:                            # sélection : barre douce sur toute la ligne
                segs = [(prefix + n["glyph"] + " " + n["name"] + n.get("suffix", ""), self.SEL)]
            else:
                if   t == "general": ga, na = self.MAG | curses.A_BOLD, self.MAG | curses.A_BOLD
                elif t == "chef":    ga, na = C | curses.A_BOLD, curses.A_BOLD
                else:                ga, na = self.YEL, self.YEL
                segs = [(prefix, DIM), (n["glyph"] + " ", ga), (n["name"], na)]
                if n.get("suffix"): segs.append((n["suffix"], DIM))
                if n.get("nlive"):  segs.append(("  ● %d" % n["nlive"], G | curses.A_BOLD))
                if n.get("warn"):   segs.append(("  ⚠ reorg", R | curses.A_BOLD))
            lput(y, 2, segs)
            nb = n.get("bloc", 0)
            if nb:
                try: self.scr.addnstr(y, lw - 5, "⚠%d" % nb, 4, R | curses.A_BOLD)
                except curses.error: pass
            y += 1
        for yy in range(3, H - 1):                 # ligne verticale : arbre │ contexte droit (sous le séparateur)
            try: self.scr.addnstr(yy, lw, "│", 1, DIM)
            except curses.error: pass
        # ── droite : contexte du nœud sélectionné ──
        n = nodes[cur]; rx = lw + 2
        def rl(row, text, attr=0):
            if 2 <= row < H - 1 and W - rx - 1 > 0:
                try: self.scr.addnstr(row, rx, text, W - rx - 1, attr)
                except curses.error: pass
        def puts(row, segs):                       # segments colorés sur une ligne
            if not (2 <= row < H - 1): return
            x = rx; xmax = W - 1
            for s, a in segs:
                if x >= xmax: break
                try: self.scr.addnstr(row, x, s, xmax - x, a)
                except curses.error: pass
                x += len(s)
        def eq_segs(r):                            # point coloré · nom · état (⚠ rouge) · fraîcheur
            dot, da = {"busy": ("◆", self.ORANGE | curses.A_BOLD),
                       "live": ("●", G | curses.A_BOLD)}.get(r["live"], ("○", DIM))
            segs = [(dot + " ", da), ("%-16s " % r["workspace"][:16], 0)]
            et = r["etat"] or "—"; mb = re.match(r'(⚠\d+)(?: · )?(.*)', et)
            if mb: segs += [(mb.group(1) + " ", R | curses.A_BOLD), (mb.group(2), 0)]
            else:  segs.append((et, 0))
            if r.get("ago"): segs.append(("  · " + r["ago"], DIM))
            return segs
        ry = 3
        if n["type"] == "retour":
            rl(ry, "‹ Back", C | curses.A_BOLD); ry += 2
            rl(ry, "↵  back to home   (Esc too)", DIM)
        elif n["type"] in ("chef", "souschef"):
            # DROITE = enfants DIRECTS : sous-leads (si scindé) OU sessions directes.
            kids = n.get("children", []); nb = n.get("bloc", 0)
            ntot = len(n["rows"]); nlive = sum(1 for r in n["rows"] if r["live"] in ("live", "busy"))
            if n["type"] == "chef":
                rl(ry, "⬡ LEAD  %s" % n["machine"], C | curses.A_BOLD)
            else:
                rl(ry, "◇ SUB-LEAD  %s" % n["domaine"], self.YEL | curses.A_BOLD)
            ry += 1
            kind_lbl = "sub-lead(s)" if any(k["kind"] == "souschef" for k in kids) else "direct session(s)"
            meta = [("%d workspaces · %d active  ·  %d %s" % (ntot, nlive, len(kids), kind_lbl), DIM)]
            if nb: meta.append(("   ⚠%d" % nb, R | curses.A_BOLD))
            puts(ry, meta); ry += 2
            for k in kids:
                if ry >= H - 1: break
                if k["kind"] == "souschef":
                    segs = [("⬡ %-14s " % k["domaine"], C), ("%d ws · %d active" % (k["n"], k["live"]), DIM)]
                    if k["bloc"]: segs.append(("  ⚠%d" % k["bloc"], R | curses.A_BOLD))
                    puts(ry, segs)
                else:
                    puts(ry, eq_segs(k))
                ry += 1
        else:  # general
            rows = n["rows"]; nb = n.get("bloc", 0)
            rl(ry, "⌘ OWNER", self.MAG | curses.A_BOLD); ry += 1
            meta = [("all machines %s" % (("· top %s" % n["sommet"]) if n["sommet"] else "(local)"), DIM)]
            if nb: meta.append(("   ⚠%d" % nb, R | curses.A_BOLD))
            puts(ry, meta); ry += 2
            for m in ([n["me"]] if any(r["machine"] == n["me"] for r in rows) else []) + \
                     sorted(mm for mm in {r["machine"] for r in rows} if mm != n["me"]):
                if ry >= H - 1: break
                mr = [r for r in rows if r["machine"] == m]
                lv = sum(1 for r in mr if r["live"] in ("live", "busy")); mb2 = sum(r["bloc"] for r in mr)
                segs = [("⬡ %-14s " % m, 0), ("%d ws · %d active" % (len(mr), lv), DIM)]
                if mb2: segs.append(("  ⚠%d" % mb2, R | curses.A_BOLD))
                puts(ry, segs); ry += 1
        try:
            self.scr.addnstr(H - 1, 2, "↑↓ navigate  ·  ↵ lead → chat · Back → home  ·  Esc home", W - 4, DIM)
        except curses.error:
            pass
        self.scr.refresh()

    def ram_top(self, n=14):
        """RSS cumulée par logiciel → [(nom, kio)], du plus gros au plus petit.

        Somme par `comm` : un navigateur ou un node éclaté en vingt process
        compte pour UN logiciel — c'est la seule lecture qui permet de décider
        quoi fermer. `ps` une fois, agrégation en Python."""
        try:
            out = subprocess.run(["ps", "-eo", "rss=,comm="],
                                 capture_output=True, text=True, timeout=6).stdout
        except Exception:
            return []
        agg = {}
        for line in out.splitlines():
            parts = line.split(None, 1)
            if len(parts) != 2:
                continue
            try:
                agg[parts[1].strip()] = agg.get(parts[1].strip(), 0) + int(parts[0])
            except ValueError:
                continue
        return sorted(agg.items(), key=lambda kv: -kv[1])[:n]

    def draw_infos(self):
        """Écran Infos : un DIAGNOSTIC, pas un recueil. Il doit se lire en une
        seconde : la ligne de verdict en tête dit s'il y a quelque chose à voir, et
        chaque ligne tient en « libellé court + valeur en gras colorée ». La
        couleur porte le jugement (vert = rien à faire), les explications vivent
        dans la vue détail (↵). Toute ligne qui ne peut jamais signaler un problème
        n'a rien à faire ici."""
        self.scr.erase()
        H, W = self.scr.getmaxyx()
        DIM, B = curses.A_DIM, curses.A_BOLD
        G, Y, R, C = self.GREEN, self.YEL, self.RED, self.CYAN
        COL = {"grn": G, "yel": Y, "red": R}
        title = "󰋽 " + (self.infos_zoom or "info").upper()
        self.scr.addnstr(0, 2, title, W - 4, G | B)
        try:
            self.scr.addnstr(1, 2, "─" * (W - 4), W - 4, DIM)
        except curses.error:
            pass
        with self.rc_lock:
            data = self.infos_data
            rc = dict(self.rc_data)

        def put(row, x0, segs, xmax):
            x = x0
            for t, a in segs:
                if x >= xmax:
                    break
                try:
                    self.scr.addnstr(row, x, t, xmax - x, a)
                except curses.error:
                    pass
                x += len(t)
        KEYS = {"thedev": "d", "Claude": "c", "system": "s", "network": "r"}
        def box(top, left, w, h, title, sel=False):
            bd = C if sel else DIM
            key = KEYS.get(title.split(" ")[0]) if not self.infos_zoom else None
            try:
                self.scr.addnstr(top, left, "╭─ ", w, bd)
                self.scr.addnstr(top, left + 3, title, w,
                                 (C | curses.A_REVERSE | B) if sel else (C | B))
                tx = left + 3 + len(title)
                if key:
                    self.scr.addnstr(top, tx, "  " + key, 3, DIM)
                    tx += 3
                self.scr.addnstr(top, tx, " " + "─" * max(0, left + w - 2 - tx) + "╮", max(0, left + w - tx), bd)
                for r in range(1, h - 1):
                    self.scr.addnstr(top + r, left, "│", 1, bd)
                    self.scr.addnstr(top + r, left + w - 1, "│", 1, bd)
                self.scr.addnstr(top + h - 1, left, "╰" + "─" * (w - 2) + "╯", w, bd)
            except curses.error:
                pass

        def layout_col(x, panels, top0, boty, w):
            """Remplit la hauteur [top0, boty) en AÉRANT plutôt qu'en étirant :
            l'espace libre sert d'abord à une marge intérieure, puis à une ligne
            vide entre les lignes ; le reste agrandit les cartes également, pour
            que les deux colonnes finissent au même niveau."""
            n = len(panels)
            if not n:
                return
            avail = boty - top0 - (n - 1)                  # 1 ligne entre cartes
            base = sum(len(r) + 2 for _, r in panels)
            pad = 1 if base + 2 * n <= avail else 0
            base += 2 * n * pad
            spread = sum(max(0, len(r) - 1) for _, r in panels)
            gapr = 1 if base + spread <= avail else 0
            base += spread * gapr
            extra, rem = divmod(max(0, avail - base), n)
            top = top0
            for idx, (title, rows) in enumerate(panels):
                h = len(rows) + 2 + 2 * pad + gapr * max(0, len(rows) - 1) \
                    + extra + (1 if idx < rem else 0)
                h = min(h, boty - top)
                if h < 3:
                    break
                box(top, x, w, h, title)
                # contenu centré dans la carte : le surplus se partage haut/bas
                content = len(rows) + gapr * max(0, len(rows) - 1)
                y = top + 1 + max(pad, (h - 2 - content) // 2)
                for segs in rows:
                    if y >= top + h - 1:
                        break
                    put(y, x + 3, segs, x + w - 2)
                    y += 1 + gapr
                top += h + 1
        def hint(H):
            try:
                self.scr.addnstr(H - 2, 2, "d thedev   c Claude   s system   r network   "
                                 "t test speed   Esc "
                                 + ("back" if self.infos_zoom else "quit"), W - 4, DIM)
            except curses.error:
                pass

        LBL = 12
        def lab(k):
            return (" %-*s " % (LBL, k), DIM)
        def gauge_row(label, pct, detail, contentw, inv=False, val=None):
            pct = max(0.0, min(100.0, float(pct)))
            barw = max(8, min(40, contentw - (LBL + 2) - 8 - 18))
            fill = int(round(pct / 100 * barw))
            if inv == "sig":
                col = G if pct >= 60 else (Y if pct >= 40 else R)
            else:
                col = ((G if pct >= 80 else (Y if pct >= 60 else R)) if inv else
                       (G if pct < 70 else (Y if pct < 88 else R)))
            v = val if val is not None else "%3.0f%%" % pct
            return [lab(label), ("█" * fill, col), ("░" * (barw - fill), DIM),
                    (" %5s " % v, col | B), (" " + (detail or "")[:16], DIM)]
        def kv_row(k, v):
            if isinstance(v, tuple):
                txt, c = v[0], COL.get(v[1], 0)
                return [lab(k), (str(txt), (c | B) if c else 0)]
            return [lab(k), (str(v), 0)]
        def chips_row(k, chips):
            segs = [lab(k)]
            for n, word, c in chips:
                if n == 0:
                    continue                      # un compteur à zéro ne dit rien
                plural = "s" if (not isinstance(n, int) or n > 1) else ""
                segs += [(str(n), COL.get(c, 0) | B), (" %s%s   " % (word, plural), DIM)]
            return segs
        def speed_row(k, d):
            segs = [lab(k),
                    ("↓ ", DIM), ("%.0f" % d["down"], COL.get(d["cdown"], 0) | B),
                    ("  ↑ ", DIM), ("%.1f" % d["up"], COL.get(d["cup"], 0) | B), (" Mb/s", DIM)]
            if d["ping"] is not None:
                segs += [("   ", 0), ("%d" % d["ping"], COL.get(d["cping"], 0) | B), (" ms", DIM)]
            segs.append(("   " + d["age"] + " ago", DIM))
            if d.get("autre"):
                segs.append((" · " + d["where"], DIM))
            return segs
        def buds_row(k, chips, case_age):
            # Règle batterie de thedev : vert = en charge, rouge = faible, neutre sinon.
            # Un boîtier lu en cache est grisé : c'est un dernier niveau connu.
            segs = [lab(k)]
            for name, lvl, st in chips:
                stale = name == "case" and case_age is not None
                col = DIM if stale else (G if st == 1 else (R if lvl < 15 else 0))
                segs += [(name + " ", DIM), ("%d%%" % lvl, col | (0 if stale else B))]
                if stale:
                    # Le boîtier ne donne son niveau qu'ouvert, un écouteur dedans :
                    # sans l'âge, une vieille mesure se lirait comme l'état actuel.
                    age = ("%d min" % (case_age // 60) if case_age < 3600
                           else "%d h" % (case_age // 3600))
                    segs.append(("  " + age + " ago", DIM))
                segs.append(("   ", 0))
            return segs
        def items_to_rows(items, contentw):
            out = []
            for it in items:
                if isinstance(it, tuple) and it[0] == "gaugesig":
                    out.append(gauge_row(it[1], it[2], it[3], contentw, inv="sig"))
                elif isinstance(it, tuple) and it[0] in ("gauge", "gaugeinv"):
                    out.append(gauge_row(it[1], it[2], it[3], contentw,
                                         inv=it[0] == "gaugeinv",
                                         val=it[4] if len(it) > 4 else None))
                elif isinstance(it, tuple) and it[0] == "kv":
                    out.append(kv_row(it[1], it[2]))
                elif isinstance(it, tuple) and it[0] == "chips":
                    out.append(chips_row(it[1], it[2]))
                elif isinstance(it, tuple) and it[0] == "speed":
                    out.append(speed_row(it[1], it[2]))
                elif isinstance(it, tuple) and it[0] == "buds":
                    out.append(buds_row(it[1], it[2], it[3]))
                else:
                    out.append([(" " + str(it), DIM)])
            return out
        def parc_rows():
            n = len(live_sessions())
            out = [[lab("local"), ("● ", G), (str(n), G | B), (" session%s" % ("s" if n > 1 else ""), DIM)]]
            for host in self.rc_hosts:
                d = rc.get(host) or {"loading": True}
                if d.get("loading"):
                    out.append([lab(host), ("…", DIM)])
                elif d.get("error"):
                    out.append([lab(host), ("○ ", R), ("unreachable", R | B)])
                else:
                    ss = d.get("sessions", [])
                    if ss:
                        np = sum(len(x.get("panes", [])) for x in ss)
                        out.append([lab(host), ("● ", G), (str(len(ss)), G | B),
                                    (" session%s   " % ("s" if len(ss) > 1 else ""), DIM),
                                    (str(np), B), (" Claude", DIM)])
                    else:
                        out.append([lab(host), ("○ ", DIM), ("empty", DIM)])
            return out
        if data is None:
            try:
                self.scr.addnstr(3, 2, "loading…", W - 4, DIM)
            except curses.error:
                pass
            self.draw_status(H, W)
            self.scr.noutrefresh()
            curses.doupdate()
            return

        sec = {t: rows for t, rows in data}

        # ── vue détail : la carte telle quelle, puis ce qui l'explique ──
        z = self.infos_zoom
        if z:
            w = W - 4
            name = {"Claude": "Claude · Max 5x"}.get(z, z)
            cards = [(name, items_to_rows(sec.get(z, []), w - 6)),
                     ("details", items_to_rows([i for i in sec.get(z + "+", [])], w - 6))]
            if z == "thedev" and self.rc_hosts:
                cards.append(("machines", parc_rows()))
            if z == "system":
                tot = 0
                for ln in _read_file("/proc/meminfo").splitlines():
                    if ln.startswith("MemTotal:"):
                        tot = int(ln.split()[1])
                ram = self.ram_top(8)
                top_kb = ram[0][1] if ram else 1
                rows = []
                for nm, kb in ram:
                    bw = max(8, min(40, w - 50))
                    f_ = int(round(bw * kb / max(1, top_kb)))
                    rows.append([lab(nm[:12]), ("█" * f_, C), ("░" * (bw - f_), DIM),
                                 (" %6.0f MB" % (kb / 1024.0), C | B),
                                 ("  %4.1f %%" % (100.0 * kb / tot if tot else 0), DIM)])
                cards.append(("RAM by program", rows))
            layout_col(2, cards, 3, H - 3, w)
            hint(H)
            self.draw_status(H, W)
            self.scr.noutrefresh()
            curses.doupdate()
            return

        colw = (W - 7) // 2
        contentw = colw - 6
        leftx, rightx = 2, 2 + colw + 3
        top0, boty = 4, H - 3

        left = [("thedev", items_to_rows(sec.get("thedev", []), contentw)),
                ("Claude · Max 5x", items_to_rows(sec.get("Claude", []), contentw))]
        if sec.get("Bluetooth"):
            left.append(("Bluetooth", items_to_rows(sec["Bluetooth"], contentw)))
        right = [("system", items_to_rows(sec.get("system", []), contentw)),
                 ("network", items_to_rows(sec.get("network", []), contentw))]

        # ── le verdict : tout ce qui est jaune ou rouge dans les cartes, en une ligne.
        # Tiré du RENDU lui-même, pas recalculé : il ne peut pas contredire les cartes.
        def colour_of(a):
            k = a & curses.A_COLOR
            return R if k == (R & curses.A_COLOR) else (Y if k == (Y & curses.A_COLOR) else None)
        issues = []
        for _t, rows in left + right:
            for segs in rows:
                worst = None
                for t, a in segs:
                    c = colour_of(a)
                    if c == R or (c == Y and worst is None):
                        worst = c
                if worst is not None:
                    name = next((t.strip() for t, _a in segs
                                 if t.strip() and t.strip() not in ("●", "○", "►", "↓", "↑")), "?")
                    issues.append((name, worst))
        if not issues:
            put(2, 2, [("● ", G), ("all green", G | B)], W - 2)
        else:
            worst = R if any(c == R for _n, c in issues) else Y
            segs = [("● ", worst), ("%d to check   " % len(issues), worst | B)]
            for n, c in issues:
                segs += [(n, c | B), ("   ", 0)]
            put(2, 2, segs, W - 2)

        layout_col(leftx, left, top0, boty, colw)
        layout_col(rightx, right, top0, boty, colw)
        hint(H)
        self.draw_status(H, W)
        self.scr.noutrefresh()
        curses.doupdate()

    def draw_autos(self):
        self.scr.erase()
        H, W = self.scr.getmaxyx()
        self.scr.addnstr(0, 2, "↻ AUTOMATIONS", W - 4, self.MAG | curses.A_BOLD)   # magenta = couleur du bouton home
        try:
            self.scr.addnstr(1, 2, "─" * (W - 4), W - 4, curses.A_DIM)
        except curses.error:
            pass
        hint = "↵ restart · s stop · e adjust · d delete"
        try:
            self.scr.addnstr(2, 2, hint, W - 4, curses.A_DIM)
        except curses.error:
            pass
        with self.rc_lock:
            autos = self.autos
        y = [4]
        def line(text, attr=0, col=2):
            if 0 <= y[0] < H - 1 and W - col - 1 > 0:
                try:
                    self.scr.addnstr(y[0], col, text, W - col - 1, attr)
                except curses.error:
                    pass
            y[0] += 1
        def seg_line(segs):
            if 0 <= y[0] < H - 1:
                x = 2
                for text, attr in segs:
                    if W - x - 1 <= 0:
                        break
                    try:
                        self.scr.addnstr(y[0], x, text, W - x - 1, attr)
                    except curses.error:
                        pass
                    x += len(text)
            y[0] += 1
        # bouton Retour — 1er élément navigable, sélectionné par défaut à l'ouverture
        bsel = (self.ai == -1)
        seg_line([("  " + ("▸ " if bsel else "  "), 0), ("‹ Back", self.CYAN | curses.A_BOLD)])
        if bsel:
            try:
                self.scr.chgat(y[0] - 1, 2, W - 4, self.SEL)
            except curses.error:
                pass
        line("", 0)
        flat = []                         # automations sélectionnables, dans l'ordre affiché
        if autos is None:
            line("loading…", curses.A_DIM)
        elif not autos:
            self.ai = -1                  # seul élément navigable : le bouton Retour
            line("(no automation)", curses.A_DIM)
            line("", 0)
            line("An automation = a thedev systemd --user timer (e.g. the morning briefing)", curses.A_DIM)
            line("that drops a task into an open workspace. It only runs while that", curses.A_DIM)
            line("workspace is open/detached.", curses.A_DIM)
        else:
            if self.ai >= len(autos):     # clamp dans [-1 (Retour) .. n-1]
                self.ai = len(autos) - 1
            if self.ai < -1:
                self.ai = -1
            # Une ligne compacte par auto : <server>.<dossier>.<nom violet>. État BINAIRE :
            # opérationnelle (● vert) = timer actif ET Claude présent ; sinon arrêtée (○ rouge).
            # Pas d'état intermédiaire : sans Claude, le feed ne se lance pas → autant la dire
            # arrêtée. Le détail (cause + action) ne se déplie QUE sur la sélection.
            for a in autos:
                if y[0] >= H - 2:
                    break
                idx = len(flat); flat.append(a)
                sel = (idx == self.ai)
                actif = a["state"] in ("active", "running")
                acces = bool(a.get("open"))
                op = actif and acces                      # opérationnelle ssi les deux sont bons
                if op:
                    icon, icol = ("►" if a["state"] == "running" else "●"), self.GREEN
                else:
                    icon, icol = "○", self.RED
                dossier = a.get("workspace") or os.path.basename((a.get("cwd") or "").rstrip("/")) or "?"
                segs = [("  " + ("▸ " if sel else "  "), 0), (icon + " ", icol),
                        ("%s.%s." % (a["machine"], dossier), curses.A_DIM),
                        (a["name"], self.MAG | curses.A_BOLD)]
                if a.get("desc"):                       # la petite phrase qui explique l'auto
                    segs.append(("  — " + a["desc"], curses.A_DIM))
                seg_line(segs)
                if sel:
                    try:
                        self.scr.chgat(y[0] - 1, 2, W - 4, self.SEL)
                    except curses.error:
                        pass
                    if op:
                        seg_line([("        ", 0), ("operational", self.GREEN),
                                  ("   ·   next %s" % a["next"], curses.A_DIM)])
                        line("        ↵ join", curses.A_DIM)
                    else:
                        cause = "timer stopped" if not actif else "no Claude in the workspace"
                        seg_line([("        ", 0), ("stopped", self.RED | curses.A_BOLD),
                                  (": " + cause, curses.A_DIM)])
                        if not actif:
                            line("        ↵ reactivate the timer", self.CYAN | curses.A_BOLD)
                        else:
                            line("        ▲ restart a thedev in %s on %s (↵)" % (a.get("cwd") or "?", a["machine"]),
                                 self.YEL | curses.A_BOLD)
        self._autos_flat = flat
        self.draw_status(H, W)
        self.scr.noutrefresh()
        curses.doupdate()

    def draw(self):
        self.star_anim = False         # remis à True par draw_ambiance si une étoile file
        if self.mode == "autos":
            self.draw_autos()
            return
        if self.mode == "carte":
            self.draw_carte()
            return
        if self.mode == "infos":
            self.draw_infos()
            return
        self.scr.erase()
        H, W = self.scr.getmaxyx()
        self.scr.addnstr(0, 2, self.header_line(), max(0, W - 4), curses.A_DIM)
        self.draw_status(H, W)         # ligne du bas : hôte en cours (VPS / local) + msg
        self.scr.noutrefresh()
        top, bot = 1, H - 1
        # On RÉSERVE en bas une bande « paysage » (~40 % de la hauteur, min 12
        # lignes) pour la colline + l'avion, quitte à caper la liste des workspaces
        # récentes avec un « voir plus ». Déplier (show_all) reprend cette bande →
        # la liste descend jusqu'en bas et sacrifie l'avion.
        _land = max(12, (2 * (H - 2)) // 5)
        self.CAP = max(6, (H - 2) - 9 - _land)
        # Le panneau ACTIONS prend ~1/3 de l'écran (jusqu'à 76 colonnes) ;
        # le reste va aux WORKSPACES.
        lw = W - min(76, max(46, (W * 36) // 100))
        lrows, rrows = self.left_rows(), self.right_rows()
        lwin = curses.newwin(bot - top, lw - 1, top, 1)
        rwin = curses.newwin(bot - top, W - lw - 1, top, lw)
        ltitle = "  WORKSPACES" if self.mode == "sessions" else "  FOLDERS"
        self.loff = self.draw_panel(lwin, ltitle, lrows, self.li, self.focus == "left", self.loff)
        self.draw_panel(rwin, "  ACTIONS", rrows, self.ri, self.focus == "right", 0)
        if self.mode == "sessions":
            # logo pâle dans le HEADER du panneau WORKSPACES (en bout de filet, à droite)
            pw = lw - 1
            if pw >= 78:
                import random as _r
                lx = pw - len(self.AMB_L1) - 3
                try:
                    lwin.addstr(2, lx - 2, " " * (len(self.AMB_L1) + 4))  # le filet s'arrête au logo
                    for dy, (row, attr) in enumerate(((self.AMB_L1, self.PALE1),
                                                      (self.AMB_L2, self.PALE2),
                                                      (self.AMB_L3, self.PALE3))):
                        lwin.addstr(1 + dy, lx, row, attr)
                except curses.error:
                    pass
                # étoiles du header (pas d'oiseau ici — le ciel du header reste calme)
                tick = int(time.monotonic() / 0.4)
                hb = self.amb.get("H")
                if not hb or hb["w"] != pw:
                    stars = []
                    ns = _r.choice((1, 2))           # 1-2 étoiles au header, hors du logo
                    while len(stars) < ns:
                        sx = _r.randrange(12, pw - 2)
                        if lx - 2 <= sx <= lx + len(self.AMB_L1) + 1:
                            continue
                        stars.append((_r.choice((1, 3)), sx, _r.randrange(9)))  # pas sur le filet
                    hb = {"w": pw, "stars": stars}
                    self.amb["H"] = hb
                for sy, sx, ph in hb["stars"]:       # scintillement lent
                    a = self.PALE1 if (tick // 5 + ph) % 9 == 0 else curses.A_DIM
                    try:
                        lwin.addstr(sy, sx, "·", a)
                    except curses.error:
                        pass
                lwin.noutrefresh()
            # oiseaux + étoiles dans les espaces vides des deux panneaux
            self.draw_ambiance("L", lwin, lrows)
            self.draw_ambiance("R", rwin, rrows)
        curses.doupdate()

    # --- navigation ------------------------------------------------------
    def clamp(self):
        if self.mode in ("infos", "autos"):
            return
        ln = len(self.selectable_idx(self.left_rows()))
        rn = len(self.selectable_idx(self.right_rows()))
        self.li = max(0, min(self.li, ln - 1)) if ln else 0
        self.ri = max(0, min(self.ri, rn - 1)) if rn else 0

    def move(self, d):
        if self.focus == "left":
            rows = self.left_rows()
            sels = self.selectable_idx(rows)
            if not sels:
                return
            ni = (self.li + d) % len(sels)
            if rows[sels[ni]]["kind"] == "more":
                # atteindre "voir plus" en défilant déplie et continue sur les sessions
                self.show_all = True
                sels = self.selectable_idx(self.left_rows())
                self.li = min(ni, len(sels) - 1) if sels else 0
            else:
                self.li = ni
        else:
            n = len(self.selectable_idx(self.right_rows()))
            if n:
                self.ri = (self.ri + d) % n

    def left_item(self):
        rows = self.left_rows()
        sels = self.selectable_idx(rows)
        return rows[sels[self.li]] if sels and self.li < len(sels) else None

    def right_item(self):
        rows = self.right_rows()
        sels = self.selectable_idx(rows)
        return rows[sels[self.ri]] if sels and self.ri < len(sels) else None

    # --- actions ---------------------------------------------------------
    def session_running(self, rr):
        return bool(rr.get("cwd")) and os.path.basename(rr["cwd"]) in self.live

    def decide_session(self, rr):
        """Ouvrir une session (Entrée) → toujours RESUME, jamais destructif.
        _dev_launch transforme ça en `zellij attach` si la session est vivante
        (cas typique : reconnexion SSH sur une session détachée → on REJOINT
        sans rien écraser), sinon recrée le layout + reprend la conversation.
        « Fermer & relancer » (RECREATE) est sur Ctrl-R — voir focused_session()
        — pour ne jamais tuer par réflexe une session ● qu'on voulait rejoindre."""
        self.decision = ("RESUME", rr["cwd"], rr["id"])
        return "quit"

    def focused_session(self):
        """Le workspace ● sous le curseur (panneau actif), ou None. Sert à Ctrl-R
        (fermer & relancer). Renvoie un dict {cwd, id, name, mtime}."""
        it = self.left_item() if self.focus == "left" else self.right_item()
        if it and it.get("kind") == "ws":
            return it["w"]
        return None

    def activate_left(self):
        it = self.left_item()
        if not it:
            return
        if it["kind"] == "more":
            self.show_all = True
            return
        if it["kind"] == "ws":
            return self.decide_session(it["w"])
        if it["kind"] == "dir":
            self.bdir = it["path"]
            self.filt = ""          # réinitialise la recherche dans le nouveau dossier
            self.li = 0
            self.loff = 0

    def activate_right(self):
        it = self.right_item()
        if not it:
            return
        if it["kind"] == "ws":
            return self.decide_session(it["w"])
        if it["kind"] == "rcsess":   # session distante : s'y connecter direct (srv <cwd>)
            self.decision = ("SERVER", it["host"], it["cwd"])
            return "quit"
        aid = it.get("id")
        if aid == "autos":           # écran des automations (Esc pour revenir)
            self.enter_autos()
            return
        if aid == "commandement":    # cockpit org : session dédiée (arbre gauche · lead droite)
            self.decision = ("COCKPIT",)
            return "quit"
        if aid == "infos":           # écran d'infos pratiques (Esc pour revenir)
            self.enter_infos()
            return
        if aid == "update_dev":      # met à jour la config (git pull) côté dev()
            self.decision = ("UPDATE",)
            return "quit"
        if aid in ("quit", "quit_vps"):  # quitte l'home SANS décision → shell (local) / retour laptop (vps)
            self.decision = None
            return "quit"
        if aid == "new_menu":        # déplie/replie les cibles « ici / ailleurs »
            self.new_open = not self.new_open
            return
        if aid == "new_here":
            self.decision = ("NEW", self.cur_dir)
            return "quit"
        if aid and aid.startswith("server:"):
            self.decision = ("SERVER", aid.split(":", 1)[1])
            return "quit"
        if aid == "browse":
            self.mode = "browser"
            self.bdir = self.cur_dir
            self.focus = "left"
            self.filt = ""
            self.li = self.ri = 0
            self.loff = 0
        elif aid == "start_here":
            self.decision = ("NEW", self.bdir)
            return "quit"
        elif aid == "mksub":
            self.creating = True
            self.newname = ""

    def _modal(self, title, body, input_label=None, default=""):
        """Modal overlay centré. Retourne (confirmed, text).
        Si input_label : champ de saisie pré-rempli avec default.
        Sinon text=None. Esc → (False, None), ↵ → (True, text)."""
        H, W = self.scr.getmaxyx()
        body_lines = body if isinstance(body, list) else [body]
        all_text = [title] + body_lines + ([input_label or ""] if input_label else [])
        bw = min(W - 6, max(46, max(len(l) for l in all_text if l) + 8))
        bh = 3 + len(body_lines) + (3 if input_label else 0) + 3
        by = max(0, (H - bh) // 2)
        bx = max(0, (W - bw) // 2)
        win = curses.newwin(bh, bw, by, bx)
        text = default
        while True:
            win.erase()
            win.box()
            # titre
            win.addnstr(1, 2, title, bw - 4, curses.A_BOLD)
            # corps
            for i, line in enumerate(body_lines):
                win.addnstr(2 + i, 2, line, bw - 4)
            row = 2 + len(body_lines)
            # champ de saisie optionnel
            if input_label:
                row += 1
                win.addnstr(row, 2, input_label, bw - 4, curses.A_DIM)
                row += 1
                field = (text + " " * bw)[:bw - 4]
                win.addnstr(row, 2, field, bw - 4, curses.A_REVERSE)
                row += 1
            # hint
            row += 1
            win.addnstr(row, 2, "↵ confirm  Esc cancel", bw - 4, curses.A_DIM)
            win.refresh()
            ch = self.scr.getch()
            if ch == 27:
                return False, None
            if ch in (curses.KEY_ENTER, 10, 13):
                return True, text
            if input_label:
                if ch in (curses.KEY_BACKSPACE, 127, 8):
                    text = text[:-1]
                elif 32 <= ch < 127:
                    text += chr(ch)

    def prompt(self, label):
        curses.curs_set(1)
        curses.echo()
        H, W = self.scr.getmaxyx()
        self.scr.move(H - 1, 0)
        self.scr.clrtoeol()
        self.scr.addnstr(H - 1, 2, label, W - 4, self.GREEN)
        self.scr.refresh()
        try:
            s = self.scr.getstr(H - 1, 2 + len(label), 200).decode("utf-8", "replace")
        except Exception:
            s = ""
        curses.noecho()
        curses.curs_set(0)
        return s.strip()

    # --- boucle ----------------------------------------------------------
    def run(self):
        # Si des hôtes RC : getch non bloquant (timeout) pour afficher la liste dès
        # qu'elle charge ET la rafraîchir en continu (statut « en cours » live).
        while True:
            try:
                self.clamp()
                self.draw()
            except Exception:
                # Un bug de rendu ne doit PLUS tuer l'home (sortie « sans raison »).
                # On logue la trace pour corriger la cause, et on continue.
                import traceback
                try:
                    with open(os.path.expanduser("~/.cache/home-crash.log"), "a") as _f:
                        _f.write("=== draw crash ===\n" + traceback.format_exc() + "\n")
                except Exception:
                    pass
                self.msg = "⚠ display error, see ~/.cache/home-crash.log"
            # getch non bloquant tant qu'il y a qqch à rafraîchir (liste RC live,
            # check git en fond, ou écran infos en cours de chargement) ; sinon bloque.
            self._refresh_busy()                      # busy local (throttle interne) → clignotement
            poll = bool(self.rc_hosts) or self.git_checking or self.local_refreshing or (self.metrics is not None) or (self.mode == "infos") or (self.autos is None) or (self.mode == "carte" and self.carte_nodes is None) or bool(self.busy_cwds) or bool(self.waiting_cwds) or bool(self.amb)
            # étoile filante en vol → rafraîchissement rapide (~7 fps) pour un
            # mouvement fluide ; sinon cadence normale (ambiance/live) ou blocker.
            self.scr.timeout(140 if self.star_anim else (400 if poll else -1))
            try:
                ch = self.scr.getch()
            except KeyboardInterrupt:
                return
            if ch == -1:                            # timeout : simple redraw
                continue
            # Alt+I = l'écran INFOS (même geste qu'Alt+I dans zellij). Le terminal
            # envoie ESC puis 'i' ; comme ESC seul = retour/quitter ici, on lève
            # l'ambiguïté en regardant la touche suivante. Si ce n'est pas 'i',
            # on la remet dans la file et l'ESC reprend son sens normal.
            if ch == 27:
                self.scr.timeout(60)
                nxt = self.scr.getch()
                if nxt in (ord("i"), ord("I")):
                    self.enter_infos()
                    continue
                if nxt != -1:
                    curses.ungetch(nxt)
            if self.creating:                       # saisie inline du nom de dossier
                if ch in (curses.KEY_ENTER, 10, 13):
                    nm = self.newname.strip()
                    if nm:
                        newdir = os.path.join(self.bdir, nm)
                        try:
                            # Juste créer le dossier : on reste dans l'home, il
                            # apparaît en haut de la liste (tri par mtime). Pas de
                            # lancement de session — l'utilisateur choisit ensuite.
                            os.makedirs(newdir, exist_ok=True)
                            self.msg = "folder created: %s" % nm
                        except OSError as e:
                            self.msg = "failed: %s" % e
                    self.creating = False; self.newname = ""
                elif ch == 27:
                    self.creating = False; self.newname = ""
                elif ch in (curses.KEY_BACKSPACE, 127, 8):
                    self.newname = self.newname[:-1]
                elif 32 <= ch < 127:
                    self.newname += chr(ch)
                continue
            if self.mode == "autos":                # écran automations : navigable
                n = len(self._autos_flat)
                if n == 0:
                    self.ai = -1                    # vide/chargement : focus sur le bouton Retour
                if self.confirm_del is not None:    # confirmation de suppression en attente
                    a = self.confirm_del
                    self.confirm_del = None
                    if ch in (ord("y"), ord("Y"), ord("o"), ord("O")):
                        self._delete_auto(a)
                    else:
                        self.msg = "deletion cancelled"
                    continue
                if ch == 27:
                    if self.back_page():
                        return
                elif ch == curses.KEY_UP:
                    self.ai = self.ai - 1
                    if self.ai < -1: self.ai = n - 1
                elif ch == curses.KEY_DOWN:
                    self.ai = self.ai + 1
                    if self.ai > n - 1: self.ai = -1
                elif ch in (curses.KEY_ENTER, 10, 13) and self.ai == -1:
                    if self.back_page():                          # bouton Retour
                        return
                elif ch in (curses.KEY_ENTER, 10, 13) and 0 <= self.ai < n:
                    a = self._autos_flat[self.ai]
                    if a["state"] not in ("active", "running"):   # arrêté → réactiver le timer
                        self._reactivate_auto(a)
                    else:                                         # actif → rejoindre/rattacher le workspace
                        cwd = a.get("cwd")
                        if not cwd:
                            self.msg = "no known cwd: open a thedev manually"
                        elif a["machine"] == "local":
                            self.decision = ("NEW", cwd); return
                        else:
                            self.decision = ("SERVER", a["machine"], cwd); return
                elif ch in (ord("s"), ord("S")) and 0 <= self.ai < n:   # arrêter (économiser des tokens)
                    self._stop_auto(self._autos_flat[self.ai])
                elif ch in (ord("e"), ord("E")) and 0 <= self.ai < n:   # ajuster : aside Claude dans le thedev concerné
                    a = self._autos_flat[self.ai]
                    self.decision = ("ADJUST", a["machine"], a.get("cwd") or "", a["name"]); return
                elif ch in (ord("d"), ord("D")) and 0 <= self.ai < n:   # supprimer (à tout jamais)
                    a = self._autos_flat[self.ai]
                    self.confirm_del = a
                    self.msg = "delete \"%s\" forever? y = yes, anything else = no" % a["name"]
                continue
            if self.mode == "carte":                # écran org : ↑↓ navigue · ↵ ouvre le lead · Esc retour
                if ch == 27:
                    self.mode = "sessions"; self.focus = "left"
                    self.li = self.ri = 0; self.loff = 0
                elif ch == curses.KEY_UP:
                    self.ci = max(0, self.ci - 1)
                elif ch == curses.KEY_DOWN:
                    self.ci += 1
                elif ch in (curses.KEY_ENTER, 10, 13):
                    if self._open_chef() == "quit":   # convoque un lead → décision CHEF, dev() lance
                        return
                continue
            if self.mode == "infos":
                # Navigation par LETTRES, sans sélection de carte : seules deux cartes
                # ont un détail, les parcourir une à une ne servait à rien.
                #   d thedev, c Claude, s système, r réseau, t débit, Échap retour/quitter
                if ch in (ord("t"), ord("T")) and not self.speed_running:
                    self.speed_running = True
                    self.msg = "measuring speed… (~10 s)"
                    threading.Thread(target=self._speedtest, daemon=True).start()
                elif ch in (ord("r"), ord("s"), ord("d"), ord("c")):
                    z = {ord("r"): "network", ord("s"): "system", ord("d"): "thedev",
                         ord("c"): "Claude"}[ch]
                    self.infos_zoom = None if self.infos_zoom == z else z
                elif ch == 27:
                    if self.infos_zoom:
                        self.infos_zoom = None
                    elif self.back_page():
                        return
                continue
            self.msg = ""
            if ch in (curses.KEY_UP,):
                self.move(-1)
            elif ch in (curses.KEY_DOWN,):
                self.move(1)
            elif ch == curses.KEY_LEFT:
                self.focus = "left"
            elif ch == curses.KEY_RIGHT:
                self.focus = "right"
            elif ch == 9:  # Tab → bascule focus
                self.focus = "right" if self.focus == "left" else "left"
            elif ch in (curses.KEY_ENTER, 10, 13):
                if (self.activate_left() if self.focus == "left" else self.activate_right()) == "quit":
                    return
            elif ch == 18:  # Ctrl-R : renommer le workspace sélectionnée
                li = self.left_item() if self.focus == "left" else None
                if li and li.get("kind") == "ws":
                    w = li["w"]
                    _body = ["\"%s\"" % w["name"]]
                    if w["name"] in self.live:
                        _body += ["", "open workspace -> closed & restarted",
                                  "(re-anchoring: jobs and unsaved buffers are lost)"]
                    ok, new_name = self._modal(
                        "Rename workspace", _body,
                        input_label="New name:", default=w["name"])
                    if ok and new_name and new_name != w["name"]:
                        if not re.match(r'^[A-Za-z0-9._-]+$', new_name):
                            self.msg = "invalid name (alphanumeric . _ - only)"
                        else:
                            new_cwd = os.path.join(os.path.dirname(w["cwd"]), new_name)
                            try:
                                import shutil as _shutil
                                old_name = w["name"]
                                old_cwd  = w["cwd"]
                                was_live = old_name in self.live
                                if os.path.isdir(old_cwd):
                                    os.rename(old_cwd, new_cwd)
                                if old_name in self.live:
                                    subprocess.run(["zellij", "action", "rename-session", new_name],
                                                   capture_output=True)
                                    time.sleep(0.25)  # zellij propage rename-session
                                # déplacer l'historique Claude. NB : Claude Code
                                # encode le chemin en remplaçant TOUT caractère non
                                # alphanumérique par « - » (donc les « _ » de
                                # jlal_perso aussi) — pas seulement les « / ».
                                _base = os.path.expanduser("~/.claude/projects")
                                _enc = lambda p: re.sub(r'[^A-Za-z0-9]', '-', p)
                                _old_h = os.path.join(_base, _enc(old_cwd))
                                _new_h = os.path.join(_base, _enc(new_cwd))
                                if os.path.isdir(_old_h) and not os.path.exists(_new_h):
                                    _shutil.move(_old_h, _new_h)
                                # Réécrire le cwd DANS les transcripts : load_workspaces()
                                # lit le champ "cwd" du jsonl (pas le nom du dossier), et
                                # il pointe encore vers l'ancien chemin → le workspace garderait
                                # l'ancien nom et ne matcherait plus la session zellij vivante.
                                if os.path.isdir(_new_h):
                                    _o = ('"cwd":"%s"' % old_cwd).encode()
                                    _n = ('"cwd":"%s"' % new_cwd).encode()
                                    for _f in glob.glob(os.path.join(_new_h, "*.jsonl")):
                                        try:
                                            with open(_f, "rb") as _fh:
                                                _data = _fh.read()
                                            if _o in _data:
                                                with open(_f, "wb") as _fh:
                                                    _fh.write(_data.replace(_o, _n))
                                        except OSError:
                                            pass
                                # réancrage : les process de le workspace vivante gardent
                                # l'ANCIEN cwd (on ne peut pas chdir un process de
                                # l'extérieur) → hooks cassés, chemins morts. On relance
                                # depuis le nouveau chemin via une décision RECREATE
                                # (delete-session + relance du layout, conv reprise). Le
                                # rename-session ci-dessus a déjà mis la session vivante
                                # au nouveau nom → delete-session basename(new_cwd) la vise.
                                if was_live and os.environ.get("ZELLIJ_SESSION_NAME") != old_name:
                                    self.decision = ("RECREATE", new_cwd, w.get("id") or "")
                                    return
                                # sinon (workspace fermée, ou home tourne DANS la
                                # session à renommer → un delete-session se tuerait) :
                                # renommage disque seulement, pas de relance auto.
                                self._refresh_local()
                                if was_live:
                                    self.msg = ("renamed; detach (Ctrl+Q) then reopen "
                                                "\"%s\" to re-anchor" % new_name)
                                else:
                                    self.msg = "renamed: %s → %s" % (old_name, new_name)
                            except Exception as e:
                                self.msg = "failed: %s" % str(e)[:60]
                    else:
                        self.msg = "rename cancelled" if ok else ""
                else:
                    self.msg = "select a workspace on the left"
            elif ch == 17:  # Ctrl-Q : fermer la session ouverte (zellij delete-session)
                li = self.left_item() if self.focus == "left" else None
                if li and li.get("kind") == "ws":
                    w = li["w"]
                    if w["name"] not in self.live:
                        self.msg = "^Q: workspace not open"
                        continue
                    ok, _ = self._modal(
                        "Close workspace",
                        ["\"%s\"" % w["name"], "", "The workspace will be closed."])
                    if ok:
                        subprocess.run(["zellij", "delete-session", w["name"], "--force"],
                                       capture_output=True)
                        self._refresh_local()
                        self.msg = "workspace \"%s\" closed" % w["name"]
                elif li and li.get("kind") == "rcsess":
                    ok, _ = self._modal(
                        "Close remote workspace",
                        ["\"%s\" on %s" % (li["name"], li["host"]), "", "The workspace will be closed."])
                    if ok:
                        subprocess.run(
                            ["ssh", "-o", "ConnectTimeout=6", "-o", "BatchMode=yes",
                             "-o", "ControlMaster=auto", "-o", "ControlPath=~/.ssh/dev-cm-%C",
                             "-o", "ControlPersist=30s",
                             li["host"],
                             "bash -lic 'zellij delete-session %s --force 2>&1'" % li["name"]],
                            capture_output=True, timeout=10)
                        self._refresh_remote(li["host"])
                        self.msg = "workspace \"%s\" closed on %s" % (li["name"], li["host"])
                else:
                    self.msg = "select a workspace on the left"
            elif ch in (curses.KEY_DC, 519):  # Suppr / Ctrl+Suppr : supprimer session + historique
                li = self.left_item() if self.focus == "left" else None
                if li and li.get("kind") == "ws":
                    w = li["w"]
                    ok, _ = self._modal(
                        "Delete the session and its history",
                        ["\"%s\"" % w["name"], "",
                         "Deletes: zellij session, project folder,",
                         "thedev registry and Claude history."])
                    if ok:
                        subprocess.run(["zellij", "delete-session", w["name"], "--force"],
                                       capture_output=True)
                        self._refresh_local()
                        # registre agents
                        subprocess.run([os.path.expanduser("~/.local/bin/agent-register"),
                                        "gc", "0"], capture_output=True)
                        # historique Claude : dossier ~/.claude/projects/<encoded_cwd>
                        cwd = w.get("cwd", "")
                        if cwd:
                            encoded = cwd.lstrip("/").replace("/", "-")
                            claude_proj = os.path.expanduser("~/.claude/projects/-" + encoded)
                            if os.path.isdir(claude_proj):
                                import shutil
                                shutil.rmtree(claude_proj, ignore_errors=True)
                        self.msg = "session \"%s\" deleted" % w["name"]
                else:
                    self.msg = "select a local workspace on the left"
            elif ch == 27:  # Esc : efface le filtre, sinon revient aux sessions, sinon quitte
                if self.filt:
                    self.filt = ""; self.li = 0
                elif self.mode == "browser":
                    self.mode = "sessions"; self.focus = "left"; self.li = self.ri = 0; self.loff = 0
                else:
                    return
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                if self.filt:
                    self.filt = self.filt[:-1]; self.li = 0
            elif 32 <= ch < 127:
                self.filt += chr(ch); self.li = 0


def main():
    # `--page infos|autos` ouvre DIRECTEMENT cet écran, seul (sans la liste des
    # sessions derrière) : c'est ainsi que la colonne de gauche de la page agents les
    # affiche en plein écran. Retour/Esc ferme alors le process (cf. back_page).
    argv = sys.argv[1:]
    page = None
    if "--page" in argv:
        i = argv.index("--page")
        page = argv[i + 1] if i + 1 < len(argv) else None
        del argv[i:i + 2]
    cur_dir = os.path.realpath(argv[0]) if argv else os.getcwd()
    outfile = argv[1] if len(argv) > 1 else None
    picker = [None]

    def wrapped(scr):
        p = Picker(scr, cur_dir)
        picker[0] = p
        if page in ("infos", "autos"):
            p.solo_page = page
            (p.enter_infos if page == "infos" else p.enter_autos)()
        p.run()
        p.rc_stop.set()   # stoppe le polling RC en fond

    # stdout peut être un pipe : curses doit utiliser le tty. wrapper() ouvre le
    # terminal via initscr (qui lit /dev/tty) ; on écrit la décision à part.
    curses.wrapper(wrapped)
    dec = picker[0].decision if picker[0] else None
    if not dec:
        sys.exit(1)
    line = "\t".join(dec) + "\n"
    if outfile:
        with open(outfile, "w", encoding="utf-8") as f:
            f.write(line)
    else:
        sys.stdout.write(line)


if __name__ == "__main__":
    main()
