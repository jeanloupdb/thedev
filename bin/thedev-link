#!/usr/bin/env bash
# @thedev liens ouvre un espace aux missions entrantes (watcher inbox, modele via Model:)
# thedev-link — ouvre/ferme un ESPACE aux MISSIONS (liens thedev, cross-machine).
# Voir NAMING.md + plans/thedev-liens.md. Modèle plat : des espaces pairs s'envoient
# des missions ; ici on est le CÔTÉ QUI REÇOIT (le watcher + l'exécution).
#
#   thedev-link open      lance le watcher de l'espace courant (dans la sandbox) + s'inscrit
#   thedev-link close     arrête le watcher + se désinscrit
#   thedev-link status    ouvert ? combien de missions en cours ?
#
# Le watcher (crun bash, gratuit) surveille l'inbox ; à l'arrivée d'une mission il lance
# un crun-mission = `claude "<mission>"` INTERACTIF (abonnement, pas `-p`/crédits), qui
# écrit son résultat dans l'outbox. Séquentiel (1 mission à la fois). Timeout 600s défaut.
# Une mission plus vieille que MISSION_TTL (défaut 600s) est écartée (stale) sans être exécutée.
set -u
ROOT="$HOME/.cache/thedev"
me="$(basename "$0")"

# Adaptateur moteur (engine read …) résolu en VOISIN de ce script (relocatable) :
# le watcher reçoit déjà $0 en chemin absolu (readlink -f). Permet d'extraire le
# résultat d'une mission sans connaître le schéma de transcript du moteur.
_self="$0"; case "$_self" in */*) ;; *) _self="$(command -v -- "$_self")" ;; esac
ENGINE="$(dirname "$(readlink -f -- "$_self")")/engine"

espace_name()  { printf '%s' "${ZELLIJ_SESSION_NAME:-$(basename "$(pwd -P)")}"; }
machine_name() { cat "$HOME/.config/dev-vps" 2>/dev/null || hostname -s; }

# alias → id de modèle complet (l'émetteur peut écrire `Model: fable`). Un id
# déjà complet ou inconnu passe tel quel → on n'empêche jamais un futur modèle.
_norm_model() {
  case "$1" in
    fable|Fable|fable-5)  echo claude-fable-5 ;;
    opus|Opus)            echo claude-opus-4-8 ;;
    sonnet|Sonnet)        echo claude-sonnet-4-6 ;;
    haiku|Haiku)          echo claude-haiku-4-5-20251001 ;;
    *)                    echo "$1" ;;
  esac
}

cmd_open() {
  local esp cwd; esp="$(espace_name)"; cwd="$(pwd -P)"
  command -v crun >/dev/null 2>&1 || { echo "✗ crun requis (sandbox)"; exit 1; }
  crun "link-$esp" -- "$(readlink -f "$0")" __watch "$esp" "$cwd"
  echo "✓ espace '$esp' OUVERT aux missions — watcher dans la sandbox ('crun list')."
}

cmd_close() {
  local esp; esp="$(espace_name)"
  crun kill "link-$esp" 2>/dev/null
  rm -f "$ROOT/links/$esp"
  echo "✓ espace '$esp' FERMÉ aux missions."
}

cmd_status() {
  local esp; esp="$(espace_name)"
  if [ -f "$ROOT/links/$esp" ]; then
    echo "● OUVERT :"; sed 's/^/   /' "$ROOT/links/$esp"
    echo "   missions en cours : $(find "$ROOT/spaces/$esp/work" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)"
  else
    echo "○ FERMÉ — l'espace '$esp' n'écoute pas (thedev-link open pour ouvrir)."
  fi
}

# ── LE WATCHER (tourne comme crun dans la sandbox) ───────────────────────────
cmd_watch() {
  local esp="$1" cwd="$2"
  local sdir="$ROOT/spaces/$esp" reg="$ROOT/links/$esp"
  WATCHER_START=$(date +%s)   # global lu par _process pour distinguer backlog / file live
  mkdir -p "$sdir"/inbox "$sdir"/outbox "$sdir"/work "$sdir"/done "$ROOT/links"
  cat > "$reg" <<EOF
espace=$esp
machine=$(machine_name)
cwd=$cwd
watcher_pid=$$
opened=$(date -Iseconds)
EOF
  trap 'rm -f "$reg"; echo "🔗 watcher '"'"$esp"'"' arrêté."; exit 0' EXIT INT TERM
  echo "🔗 watcher '$esp' ACTIF — inbox: $sdir/inbox (Ctrl-C pour fermer)"
  local m id
  while true; do
    for m in "$sdir"/inbox/*.mission; do
      [ -e "$m" ] || continue
      id="$(basename "$m" .mission)"
      mkdir -p "$sdir/work/$id"
      mv "$m" "$sdir/work/$id/mission" 2>/dev/null || continue
      echo "→ mission $id reçue, traitement…"
      _process "$esp" "$cwd" "$id"
      echo "✓ mission $id terminée."
    done
    if command -v inotifywait >/dev/null 2>&1; then
      inotifywait -q -t 30 -e create,moved_to,close_write "$sdir/inbox" >/dev/null 2>&1
    else
      sleep 5
    fi
  done
}

_process() {
  local esp="$1" cwd="$2" id="$3"
  local sdir="$ROOT/spaces/$esp" wdir="$ROOT/spaces/$esp/work/$3"
  local out="$sdir/outbox/$id.result"

  # Garde-fou TTL — n'écarte QUE le BACKLOG : une mission déposée AVANT le démarrage
  # de CE watcher (file restée d'une session précédente, émetteur très probablement
  # parti) ET trop vieille. Une mission arrivée APRÈS le démarrage = file LIVE → jamais
  # écartée, même si elle a patienté des heures derrière une longue mission (en async,
  # son résultat reste récupérable via `mission result`). Surchargeable via MISSION_TTL.
  local created cepoch age ttl="${MISSION_TTL:-600}"
  created="$(grep -i '^Created:' "$wdir/mission" | head -1 | cut -d' ' -f2-)"
  cepoch="$(date -d "$created" +%s 2>/dev/null || echo 0)"
  if [ "${cepoch:-0}" -gt 0 ] && [ "$cepoch" -lt "${WATCHER_START:-0}" ]; then
    age=$(( $(date +%s) - cepoch ))
    if [ "$age" -gt "$ttl" ]; then
      printf 'Status: stale\nFinished: %s\n\nMission écartée : backlog déposé il y a %ss (TTL %ss) avant le démarrage du watcher — émetteur probablement parti, non exécutée.\n' \
        "$(date -Iseconds)" "$age" "$ttl" > "$out"
      cp "$out" "$wdir/result" 2>/dev/null
      rm -rf "$sdir/done/$id" 2>/dev/null; mv "$wdir" "$sdir/done/$id" 2>/dev/null
      echo "⏭ mission $id écartée (backlog stale : ${age}s > ${ttl}s)"
      return 0
    fi
  fi

  # Attente du résultat : pilotée par la VIVACITÉ du pane, pas par un timeout fixe.
  # Un `Timeout:` dans la mission = plafond DUR optionnel (utile pour borner une
  # mission courte). Absent = pas de plafond : on attend tant que le crun-mission
  # tourne (un workflow de refonte peut durer des heures). Garde-fou ultime
  # MISSION_HARDCAP (défaut 6 h) pour qu'un process vivant-mais-bloqué ne fige
  # pas l'espace indéfiniment (le watcher est séquentiel). 0 = aucun plafond.
  local timeout body hardcap="${MISSION_HARDCAP:-21600}"
  timeout="$(grep -i '^Timeout:' "$wdir/mission" | head -1 | tr -dc '0-9')"   # vide = pas de plafond mission
  body="$(awk 'f{print} /^[[:space:]]*$/{f=1}' "$wdir/mission")"

  # Modèle imposé par la mission (en-tête `Model:`). Absent = défaut machine.
  local model model_id="" model_line=""
  model="$(grep -i '^Model:' "$wdir/mission" | head -1 | cut -d: -f2- | tr -d '[:space:]')"
  if [ -n "$model" ]; then
    model_id="$(_norm_model "$model")"
    model_line="export CLAUDE_PANE_MODEL=$(printf '%q' "$model_id")"
  fi
  cat > "$wdir/prompt" <<EOF
Tu es un crun-mission de thedev (réseau d'espaces pairs — voir ~/.claude/CLAUDE.md et NAMING.md).
On t'a envoyé cette MISSION via un lien depuis un autre espace :

--- MISSION ---
$body
--- FIN MISSION ---

Exécute-la dans cet espace (« $esp », dossier $cwd). Tu peux lancer d'autres cruns si utile.
Quand tu as TERMINÉ, écris ton résultat (texte clair, concis, le résultat seulement) ainsi :
  1. écris-le dans : $out.tmp
  2. puis renomme : mv $out.tmp $out
N'écris ce fichier qu'UNE fois, à la toute fin — c'est lui qui signale la fin
(et déclenche la fermeture de ce pane). Si tu lances un workflow ou des agents
en arrière-plan, ATTENDS leur fin complète avant d'écrire ce fichier : l'écrire
trop tôt tuerait le travail encore en cours.
(Filet : si tu n'écris pas ce fichier, ta DERNIÈRE réponse sera capturée comme
résultat — termine donc toujours par le résultat complet, autonome.)
Reste STRICTEMENT dans le périmètre de cet espace (règles de ~/.claude/CLAUDE.md).
EOF
  cat > "$wdir/run.sh" <<EOF
#!/usr/bin/env bash
cd $(printf '%q' "$cwd") || exit 1
# Via engine launch (→ claude-pane) : le Claude de mission reçoit la surcouche
# zellij (crun, pane-name, vocabulaire thedev) et les bons flags. ONCE=1 →
# pas de keep-alive ni de sleep ; PANE_NAME=mission-* → le hook SessionStart
# n'enregistre pas et ne renomme pas (pane géré par crun).
unset CLAUDE_RESUME_ID   # une mission est toujours une session neuve
export CLAUDE_PANE_ONCE=1 CLAUDE_PANE_NAME=$(printf '%q' "mission-$id")
$model_line
exec engine launch -- "\$(cat $(printf '%q' "$wdir/prompt"))"
EOF
  chmod +x "$wdir/run.sh"
  crun "mission-$id" -- "$wdir/run.sh"
  # Boucle tant que : pas de résultat ET (pane vivant) ET (sous le plafond mission,
  # s'il y en a un) ET (sous le hardcap). On sonde la vivacité du pane via crun
  # plutôt que de parier sur une durée. grace : laisse 2 sondes au pane pour
  # apparaître dans le registre crun avant de le croire mort.
  local waited=0 grace=0 reason="" te tp tmt now idle="${MISSION_IDLE_GRACE:-30}" tidle="${MISSION_TRANSCRIPT_IDLE:-150}"
  while [ ! -f "$out" ]; do
    sleep 3; waited=$((waited+3)); now=$(date +%s)
    if [ -n "$timeout" ] && [ "$timeout" -gt 0 ] 2>/dev/null && [ "$waited" -ge "$timeout" ]; then reason="timeout"; break; fi
    if [ "$hardcap" -gt 0 ] 2>/dev/null && [ "$waited" -ge "$hardcap" ]; then reason="hardcap"; break; fi
    # Fin de tour DÉTERMINISTE (sentinelle du hook Stop) : fini + idle ≥ grace sans
    # résultat → on tranche. mtime rafraîchi à chaque tour → multi-tours protégé.
    if [ -f "$wdir/turn-ended" ]; then
      te=$(stat -c %Y "$wdir/turn-ended" 2>/dev/null || echo 0)
      [ $(( now - te )) -ge "$idle" ] && { reason="turn-ended"; break; }
    fi
    # Filet INDÉPENDANT du hook : le transcript (écrit par Claude Code à chaque
    # message/tool-call) ne bouge plus depuis tidle s → session idle, même si le
    # hook Stop n'a jamais tiré. Évite de pendre jusqu'au hardcap.
    if [ -s "$wdir/transcript_path" ]; then
      tp=$(cat "$wdir/transcript_path" 2>/dev/null)
      tmt=$(stat -c %Y "$tp" 2>/dev/null || echo "$now")
      [ $(( now - tmt )) -ge "$tidle" ] && { reason="transcript-idle"; break; }
    fi
    if [ "$grace" -ge 4 ] && ! crun alive "mission-$id" 2>/dev/null; then reason="dead"; break; fi
    # Boot-grace : aucun signe de vie de la SESSION (ni transcript_path posé par
    # SessionStart, ni turn-ended) après boot s → la session n'a jamais démarré
    # (dialogue trust/permissions bloquant, crash au boot…). On conclut tout de
    # suite avec le screen-dump, au lieu de pendre jusqu'au hardcap.
    if [ "$waited" -ge "${MISSION_BOOT_GRACE:-90}" ] && [ ! -s "$wdir/transcript_path" ] && [ ! -f "$wdir/turn-ended" ]; then
      reason="never-started"; break
    fi
    grace=$((grace+1))
  done

  # Capture d'écran du pane AVANT de le tuer (révèle un dialogue interactif bloquant,
  # une erreur au boot…) → archivée avec la mission. Puis kill.
  crun logs "mission-$id" > "$wdir/screen.txt" 2>/dev/null || true
  crun kill "mission-$id" 2>/dev/null

  # SOURCE DE VÉRITÉ : le transcript JSONL (écrit par Claude Code, pas par le LLM).
  # Toujours archivé → on a TOUJOURS le déroulé exact, succès comme échec.
  tp=""; [ -s "$wdir/transcript_path" ] && tp=$(cat "$wdir/transcript_path" 2>/dev/null)
  [ -n "$tp" ] && [ -f "$tp" ] && cp "$tp" "$wdir/transcript.jsonl" 2>/dev/null

  if [ ! -f "$out" ]; then
    # Le LLM n'a pas écrit son fichier → on extrait NOUS-MÊMES son dernier message
    # du transcript : c'est sa réponse, capture déterministe (réplique le stdout
    # de claude -p, mais en interactif/abonnement).
    local last=""
    if [ -s "$wdir/transcript.jsonl" ]; then
      # Capture déterministe via l'adaptateur moteur : thedev-link n'a plus à
      # connaître le schéma JSONL de Claude Code (cf. ENGINE-ADAPTER.md).
      last=$("$ENGINE" read --transcript "$wdir/transcript.jsonl" --last --role assistant 2>/dev/null)
    fi
    if [ -n "$last" ]; then
      printf 'Status: ok\nSource: transcript (fin: %s)\nFinished: %s\n\n%s\n' \
        "${reason:-?}" "$(date -Iseconds)" "$last" > "$out"
    else
      # Pas même un message dans le transcript → la session n'a jamais vraiment
      # démarré (dialogue interactif bloquant ? crash au boot ?). screen.txt joint.
      local st="failed"
      case "$reason" in dead) st="crashed" ;; hardcap) st="hung" ;; never-started) st="never-started (dossier non approuvé ? dialogue bloquant ? voir screen.txt)" ;; esac
      printf 'Status: %s\nReason: %s\nFinished: %s\n\nAucune réponse dans le transcript (%s). Session jamais démarrée ? Voir done/%s/{screen.txt,transcript.jsonl} sur la machine.\n' \
        "$st" "${reason:-arrêt}" "$(date -Iseconds)" "${tp:-transcript_path inconnu}" "$id" > "$out"
    fi
  fi
  cp "$out" "$wdir/result" 2>/dev/null
  rm -rf "$sdir/done/$id" 2>/dev/null; mv "$wdir" "$sdir/done/$id" 2>/dev/null
}

case "${1:-}" in
  open)    cmd_open ;;
  close)   cmd_close ;;
  status)  cmd_status ;;
  __watch) shift; cmd_watch "$@" ;;
  *) printf 'usage:\n  %s open|close|status\n' "$me"; exit 1 ;;
esac
