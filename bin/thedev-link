#!/usr/bin/env bash
# @thedev liens opens a workspace to incoming tasks (inbox watcher, model via Model:)
# thedev-link — ouvre/ferme une WORKSPACE aux TASKS (liens thedev, cross-machine).
# Voir NAMING.md + plans/thedev-liens.md. Modèle plat : des workspaces pairs s'envoient
# des tasks ; ici on est le CÔTÉ QUI REÇOIT (le watcher + l'exécution).
#
#   thedev-link open      lance le watcher de le workspace courante (dans jobs) + s'inscrit
#   thedev-link close     arrête le watcher + se désinscrit
#   thedev-link status    ouvert ? combien de tasks en cours ?
#
# Le watcher (job bash, gratuit) surveille l'inbox ; à l'arrivée d'une task il lance
# un job-task = `claude "<task>"` INTERACTIF (abonnement, pas `-p`/crédits), qui
# écrit son résultat dans l'outbox. Séquentiel (1 task à la fois). Timeout 600s défaut.
# Une task plus vieille que MISSION_TTL (défaut 600s) est écartée (stale) sans être exécutée.
set -u
ROOT="$HOME/.cache/thedev"
me="$(basename "$0")"

# Adaptateur moteur (engine read …) résolu en VOISIN de ce script (relocatable) :
# le watcher reçoit déjà $0 en chemin absolu (readlink -f). Permet d'extraire le
# résultat d'une task sans connaître le schéma de transcript du moteur.
_self="$0"; case "$_self" in */*) ;; *) _self="$(command -v -- "$_self")" ;; esac
ENGINE="$(dirname "$(readlink -f -- "$_self")")/engine"

workspace_name()  { printf '%s' "${ZELLIJ_SESSION_NAME:-$(basename "$(pwd -P)")}"; }
machine_name() { cat "$HOME/.config/dev-vps" 2>/dev/null || hostname -s; }

# alias → id de modèle complet (l'émetteur peut écrire `Model: fable`). Un id
# déjà complet ou inconnu passe tel quel → on n'empêche jamais un futur modèle.
_norm_model() {
  case "$1" in
    fable|Fable|fable-5)  echo claude-fable-5 ;;
    opus|Opus)            echo claude-opus-4-8 ;;
    sonnet|Sonnet)        echo claude-sonnet-4-6 ;;
    haiku|Haiku)          echo claude-haiku-4-5-20251001 ;;
    *)                    echo "$1" ;;
  esac
}

cmd_open() {
  local eq cwd; eq="$(workspace_name)"; cwd="$(pwd -P)"
  command -v job >/dev/null 2>&1 || { echo "✗ job is required (jobs page)"; exit 1; }
  job "link-$eq" -- "$(readlink -f "$0")" __watch "$eq" "$cwd"
  echo "✓ workspace '$eq' OPEN to tasks, watcher in jobs ('job list')."
}

cmd_close() {
  local eq; eq="$(workspace_name)"
  job kill "link-$eq" 2>/dev/null
  rm -f "$ROOT/links/$eq"
  echo "✓ workspace '$eq' CLOSED to tasks."
}

cmd_status() {
  local eq; eq="$(workspace_name)"
  if [ -f "$ROOT/links/$eq" ]; then
    echo "● OPEN:"; sed 's/^/   /' "$ROOT/links/$eq"
    echo "   running tasks: $(find "$ROOT/spaces/$eq/work" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)"
  else
    echo "○ CLOSED: workspace '$eq' is not listening (thedev-link open to open it)."
  fi
}

# ── LE WATCHER (tourne comme job dans jobs) ───────────────────────────
cmd_watch() {
  local eq="$1" cwd="$2"
  local sdir="$ROOT/spaces/$eq" reg="$ROOT/links/$eq"
  WATCHER_START=$(date +%s)   # global lu par _process pour distinguer backlog / file live
  mkdir -p "$sdir"/inbox "$sdir"/outbox "$sdir"/work "$sdir"/done "$ROOT/links"
  cat > "$reg" <<EOF
workspace=$eq
machine=$(machine_name)
cwd=$cwd
watcher_pid=$$
opened=$(date -Iseconds)
EOF
  trap 'rm -f "$reg"; echo "🔗 watcher '"'"$eq"'"' stopped."; exit 0' EXIT INT TERM
  echo "🔗 watcher '$eq' ACTIVE, inbox: $sdir/inbox (Ctrl-C to close)"
  local m id
  while true; do
    for m in "$sdir"/inbox/*.mission; do
      [ -e "$m" ] || continue
      id="$(basename "$m" .mission)"
      mkdir -p "$sdir/work/$id"
      mv "$m" "$sdir/work/$id/mission" 2>/dev/null || continue
      echo "→ task $id received, processing…"
      _process "$eq" "$cwd" "$id"
      echo "✓ task $id done."
    done
    if command -v inotifywait >/dev/null 2>&1; then
      inotifywait -q -t 30 -e create,moved_to,close_write "$sdir/inbox" >/dev/null 2>&1
    else
      sleep 5
    fi
  done
}

_process() {
  local eq="$1" cwd="$2" id="$3"
  local sdir="$ROOT/spaces/$eq" wdir="$ROOT/spaces/$eq/work/$3"
  local out="$sdir/outbox/$id.result"

  # Garde-fou TTL — n'écarte QUE le BACKLOG : une task déposée AVANT le démarrage
  # de CE watcher (file restée d'une session précédente, émetteur très probablement
  # parti) ET trop vieille. Une task arrivée APRÈS le démarrage = file LIVE → jamais
  # écartée, même si elle a patienté des heures derrière une longue task (en async,
  # son résultat reste récupérable via `delegate result`). Surchargeable via MISSION_TTL.
  local created cepoch age ttl="${MISSION_TTL:-600}"
  created="$(grep -i '^Created:' "$wdir/mission" | head -1 | cut -d' ' -f2-)"
  cepoch="$(date -d "$created" +%s 2>/dev/null || echo 0)"
  if [ "${cepoch:-0}" -gt 0 ] && [ "$cepoch" -lt "${WATCHER_START:-0}" ]; then
    age=$(( $(date +%s) - cepoch ))
    if [ "$age" -gt "$ttl" ]; then
      printf 'Status: stale\nFinished: %s\n\nTask discarded: backlog dropped %ss ago (TTL %ss) before the watcher started, sender probably gone, not run.\n' \
        "$(date -Iseconds)" "$age" "$ttl" > "$out"
      cp "$out" "$wdir/result" 2>/dev/null
      rm -rf "$sdir/done/$id" 2>/dev/null; mv "$wdir" "$sdir/done/$id" 2>/dev/null
      echo "⏭ task $id discarded (stale backlog: ${age}s > ${ttl}s)"
      return 0
    fi
  fi

  # Attente du résultat : pilotée par la VIVACITÉ du pane, pas par un timeout fixe.
  # Un `Timeout:` dans la task = plafond DUR optionnel (utile pour borner une
  # task courte). Absent = pas de plafond : on attend tant que le job-task
  # tourne (un workflow de refonte peut durer des heures). Garde-fou ultime
  # MISSION_HARDCAP (défaut 6 h) pour qu'un process vivant-mais-bloqué ne fige
  # pas le workspace indéfiniment (le watcher est séquentiel). 0 = aucun plafond.
  local timeout body hardcap="${MISSION_HARDCAP:-21600}"
  timeout="$(grep -i '^Timeout:' "$wdir/mission" | head -1 | tr -dc '0-9')"   # vide = pas de plafond task
  body="$(awk 'f{print} /^[[:space:]]*$/{f=1}' "$wdir/mission")"

  # Modèle imposé par la task (en-tête `Model:`). Absent = défaut machine.
  local model model_id="" model_line=""
  model="$(grep -i '^Model:' "$wdir/mission" | head -1 | cut -d: -f2- | tr -d '[:space:]')"
  if [ -n "$model" ]; then
    model_id="$(_norm_model "$model")"
    model_line="export CLAUDE_PANE_MODEL=$(printf '%q' "$model_id")"
  fi
  cat > "$wdir/prompt" <<EOF
You are a thedev task job (network of peer workspaces, see ~/.claude/CLAUDE.md and NAMING.md).
This TASK was sent to you through a link from another workspace:

--- TASK ---
$body
--- END TASK ---

Carry it out in this workspace ("$eq", folder $cwd). You may launch other jobs if useful.
When you are DONE, write your result (plain, concise text, the result only) like this:
  1. write it to: $out.tmp
  2. then rename it: mv $out.tmp $out
Write this file only ONCE, at the very end: it is what signals completion
(and triggers closing this pane). If you launch a workflow or agents
in the background, WAIT until they have fully finished before writing this file: writing it
too early would kill the work still in progress.
(Safety net: if you do not write this file, your LAST reply will be captured as the
result, so always end with the complete, self-contained result.)
Stay STRICTLY within the scope of this workspace (rules in ~/.claude/CLAUDE.md).
EOF
  cat > "$wdir/run.sh" <<EOF
#!/usr/bin/env bash
cd $(printf '%q' "$cwd") || exit 1
# Via engine launch (→ agent-pane) : l'agent de task reçoit la surcouche
# zellij (job, pane-name, vocabulaire thedev) et les bons flags. ONCE=1 →
# pas de keep-alive ni de sleep ; PANE_NAME=mission-* → le hook SessionStart
# n'enregistre pas et ne renomme pas (pane géré par job).
unset CLAUDE_RESUME_ID   # une task est toujours une session neuve
export CLAUDE_PANE_ONCE=1 CLAUDE_PANE_NAME=$(printf '%q' "task-$id")
$model_line
exec engine launch -- "\$(cat $(printf '%q' "$wdir/prompt"))"
EOF
  chmod +x "$wdir/run.sh"
  # --close : le pane se ferme seul a la fin de claude (sinon les panes EXITED s empilent dans jobs)
  job --close "task-$id" -- "$wdir/run.sh"
  # Boucle tant que : pas de résultat ET (pane vivant) ET (sous le plafond task,
  # s'il y en a un) ET (sous le hardcap). On sonde la vivacité du pane via job
  # plutôt que de parier sur une durée. grace : laisse 2 sondes au pane pour
  # apparaître dans le registre job avant de le croire mort.
  local waited=0 grace=0 reason="" te tp tmt now idle="${MISSION_IDLE_GRACE:-30}" tidle="${MISSION_TRANSCRIPT_IDLE:-150}"
  while [ ! -f "$out" ]; do
    sleep 3; waited=$((waited+3)); now=$(date +%s)
    if [ -n "$timeout" ] && [ "$timeout" -gt 0 ] 2>/dev/null && [ "$waited" -ge "$timeout" ]; then reason="timeout"; break; fi
    if [ "$hardcap" -gt 0 ] 2>/dev/null && [ "$waited" -ge "$hardcap" ]; then reason="hardcap"; break; fi
    # Fin de tour DÉTERMINISTE (sentinelle du hook Stop) : fini + idle ≥ grace sans
    # résultat → on tranche. mtime rafraîchi à chaque tour → multi-tours protégé.
    if [ -f "$wdir/turn-ended" ]; then
      te=$(stat -c %Y "$wdir/turn-ended" 2>/dev/null || echo 0)
      [ $(( now - te )) -ge "$idle" ] && { reason="turn-ended"; break; }
    fi
    # Filet INDÉPENDANT du hook : le transcript (écrit par Claude Code à chaque
    # message/tool-call) ne bouge plus depuis tidle s → session idle, même si le
    # hook Stop n'a jamais tiré. Évite de pendre jusqu'au hardcap.
    if [ -s "$wdir/transcript_path" ]; then
      tp=$(cat "$wdir/transcript_path" 2>/dev/null)
      tmt=$(stat -c %Y "$tp" 2>/dev/null || echo "$now")
      [ $(( now - tmt )) -ge "$tidle" ] && { reason="transcript-idle"; break; }
    fi
    if [ "$grace" -ge 4 ] && ! job alive "task-$id" 2>/dev/null; then reason="dead"; break; fi
    # Boot-grace : aucun signe de vie de la SESSION (ni transcript_path posé par
    # SessionStart, ni turn-ended) après boot s → la session n'a jamais démarré
    # (dialogue trust/permissions bloquant, crash au boot…). On conclut tout de
    # suite avec le screen-dump, au lieu de pendre jusqu'au hardcap.
    if [ "$waited" -ge "${MISSION_BOOT_GRACE:-90}" ] && [ ! -s "$wdir/transcript_path" ] && [ ! -f "$wdir/turn-ended" ]; then
      reason="never-started"; break
    fi
    grace=$((grace+1))
  done

  # Capture d'écran du pane AVANT de le tuer (révèle un dialogue interactif bloquant,
  # une erreur au boot…) → archivée avec la task. Puis kill.
  job logs "task-$id" > "$wdir/screen.txt" 2>/dev/null || true
  job kill "task-$id" 2>/dev/null

  # SOURCE DE VÉRITÉ : le transcript JSONL (écrit par Claude Code, pas par le LLM).
  # Toujours archivé → on a TOUJOURS le déroulé exact, succès comme échec.
  tp=""; [ -s "$wdir/transcript_path" ] && tp=$(cat "$wdir/transcript_path" 2>/dev/null)
  [ -n "$tp" ] && [ -f "$tp" ] && cp "$tp" "$wdir/transcript.jsonl" 2>/dev/null

  if [ ! -f "$out" ]; then
    # Le LLM n'a pas écrit son fichier → on extrait NOUS-MÊMES son dernier message
    # du transcript : c'est sa réponse, capture déterministe (réplique le stdout
    # de claude -p, mais en interactif/abonnement).
    local last=""
    if [ -s "$wdir/transcript.jsonl" ]; then
      # Capture déterministe via l'adaptateur moteur : thedev-link n'a plus à
      # connaître le schéma JSONL de Claude Code (cf. ENGINE-ADAPTER.md).
      last=$("$ENGINE" read --transcript "$wdir/transcript.jsonl" --last --role assistant 2>/dev/null)
    fi
    if [ -n "$last" ]; then
      printf 'Status: ok\nSource: transcript (fin: %s)\nFinished: %s\n\n%s\n' \
        "${reason:-?}" "$(date -Iseconds)" "$last" > "$out"
    else
      # Pas même un message dans le transcript → la session n'a jamais vraiment
      # démarré (dialogue interactif bloquant ? crash au boot ?). screen.txt joint.
      local st="failed"
      case "$reason" in dead) st="crashed" ;; hardcap) st="hung" ;; never-started) st="never-started (folder not trusted? blocking dialog? see screen.txt)" ;; esac
      printf 'Status: %s\nReason: %s\nFinished: %s\n\nNo reply in the transcript (%s). Session never started? See done/%s/{screen.txt,transcript.jsonl} on the machine.\n' \
        "$st" "${reason:-stopped}" "$(date -Iseconds)" "${tp:-unknown transcript_path}" "$id" > "$out"
    fi
  fi
  cp "$out" "$wdir/result" 2>/dev/null
  rm -rf "$sdir/done/$id" 2>/dev/null; mv "$wdir" "$sdir/done/$id" 2>/dev/null
}

case "${1:-}" in
  open)    cmd_open ;;
  close)   cmd_close ;;
  status)  cmd_status ;;
  __watch) shift; cmd_watch "$@" ;;
  *) printf 'usage:\n  %s open|close|status\n' "$me"; exit 1 ;;
esac
