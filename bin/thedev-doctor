#!/usr/bin/env bash
# @thedev infra install diagnostic: deps, symlinked scripts, engine, hooks, launch
# thedev-doctor — vérifie qu'une install thedev est complète et cohérente. Read-only :
# il diagnostique et pointe quoi relancer, il ne répare rien lui-même.
set -u

# Repo résolu depuis l'emplacement RÉEL de ce script (relocatable).
_self="$0"; case "$_self" in */*) ;; *) _self="$(command -v -- "$_self")" ;; esac
ROOT="$(cd "$(dirname "$(readlink -f -- "$_self")")/.." && pwd)"

pass=0 warn=0 fail=0
ok() { printf '  \033[32m✓\033[0m %s\n' "$1"; pass=$((pass+1)); }
wa() { printf '  \033[33m⚠\033[0m %s\n' "$1"; warn=$((warn+1)); }
ko() { printf '  \033[31m✗\033[0m %s\n' "$1"; fail=$((fail+1)); }
hr() { printf '\033[2m── %s ──\033[0m\n' "$1"; }

printf 'thedev doctor — %s\n\n' "$ROOT"

hr "dependencies"
for d in zellij claude nvim python3 git jq fzf inotifywait; do
  command -v "$d" >/dev/null 2>&1 && ok "$d" || ko "$d missing"
done

hr "@thedev scripts on the PATH (~/.local/bin)"
miss=""
for b in $("$ROOT/bin/thedev-manifest" --scripts 2>/dev/null); do
  [ -e "$HOME/.local/bin/$b" ] || miss="$miss $b"
done
if [ -z "$miss" ]; then ok "all @thedev scripts present"
else wa "missing from ~/.local/bin:$miss → rerun ./install.sh"; fi

hr "engine (engine adapter)"
if command -v engine >/dev/null 2>&1; then
  if engine selftest >/dev/null 2>&1; then ok "engine selftest PASS"
  else wa "engine present but selftest not PASS → run 'engine selftest'"; fi
else ko "engine not on the PATH → rerun ./install.sh"; fi

hr "hooks Claude (settings.json)"
if grep -q 'agent-track' "$HOME/.claude/settings.json" 2>/dev/null; then ok "agent-track hook wired"
else wa "hook not wired → registry/busy/pulse/nudge disabled (rerun ./install.sh)"; fi

hr "launch"
if grep -q 'dev-launcher' "$HOME/.bashrc" 2>/dev/null; then ok "dev-launcher sourced in ~/.bashrc"
else wa "dev-launcher not sourced → the 'dev' command is unavailable (rerun ./install.sh)"; fi

hr "zellij (layout / config / theme)"
for l in config.kdl layouts/dev.kdl; do
  [ -e "$HOME/.config/zellij/$l" ] && ok "zellij/$l" || wa "zellij/$l missing (rerun ./install.sh)"
done

echo
if [ "$fail" -eq 0 ] && [ "$warn" -eq 0 ]; then
  printf '\033[32mOK: install complete\033[0m (%d checks)\n' "$pass"
elif [ "$fail" -eq 0 ]; then
  printf '\033[33m%d warning(s)\033[0m (%d ok)\n' "$warn" "$pass"
else
  printf '\033[31m%d blocking problem(s)\033[0m (%d ok, %d warn)\n' "$fail" "$pass" "$warn"
fi
[ "$fail" -eq 0 ]
