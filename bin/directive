#!/usr/bin/env bash
# @thedev org directive: TOP-DOWN instruction from the owner to a workspace
# directive — l'owner (sur le sommet) dirige un workspace d'une machine. La directive est
# DÉPOSÉE dans la file du sommet (pas d'appel direct : une machine feuille — un laptop —
# n'est pas joignable depuis le VPS). La machine cible la CONSOMME à son réveil
# (`directives pull`). C'est l'axe descendant de la couche org (cf. VISION §« Ordres
# ↓ » et plans/org.md). Distinct de `delegate` (horizontal, synchrone, SSH direct).
#
#   directive <machine>/<workspace> "<intention>"     dépose une directive
#   directive list [<machine>]                       liste les directives en attente dans la file
#
# La file vit sur le SOMMET : ~/.cache/thedev/command/ordres/<machine>/<id>.ordre. Lancé
# depuis le sommet (l'owner), on écrit en local ; ailleurs, on dépose via SSH au sommet.
set -u

sommet="$(grep -vE '^\s*#|^\s*$' "$HOME/.config/thedev-sommet" 2>/dev/null | head -n1 | tr -d '[:space:]')"
me="$( { cat "$HOME/.config/dev-vps" 2>/dev/null || hostname -s; } )"
on_sommet() { [ -n "$sommet" ] && { [ "$me" = "$sommet" ] || [ "$(hostname -s)" = "$sommet" ]; }; }
QROOT='$HOME/.cache/thedev/command/ordres'   # non-expansé : évalué là où la file vit

cmd_list() {
  local machine="${1:-}"
  local sh='shopt -s nullglob; base="'"$QROOT"'"; n=0;
    for d in "$base"/*/; do m=$(basename "$d"); [ -n "'"$machine"'" ] && [ "$m" != "'"$machine"'" ] && continue;
      for f in "$d"*.ordre; do t=$(sed -n "s/^Target: //p" "$f"); fr=$(sed -n "s/^From: //p" "$f");
        printf "  ● %s/%s  (from %s)  id %s\n" "$m" "$t" "$fr" "$(basename "$f" .ordre)"; n=$((n+1)); done; done;
    [ $n -eq 0 ] && echo "  (no pending directive)"; true'
  if on_sommet; then eval "$sh"
  else [ -n "$sommet" ] && ssh -o ConnectTimeout=10 "$sommet" "$sh" || echo "directive: no reachable top"; fi
}

# --- dépôt d'une directive --------------------------------------------------------
tgt="${1:-}"
case "$tgt" in
  list) shift; cmd_list "${1:-}"; exit 0 ;;
  */*)  ;;
  *)    echo "usage: directive <machine>/<workspace> \"<intent>\"   |   directive list [<machine>]" >&2; exit 1 ;;
esac
shift; txt="$*"
[ -n "$txt" ] || { echo "directive: empty intent" >&2; exit 1; }
machine="${tgt%%/*}"; workspace="${tgt#*/}"
from="$me/${ZELLIJ_SESSION_NAME:-owner}"
ts="$(date +%Y%m%dT%H%M%S)-$$"

# corps de la directive (From/Target/Created + texte), déposé atomiquement (.tmp → mv)
body="$(printf 'From: %s\nTarget: %s\nCreated: %s\n\n%s\n' "$from" "$workspace" "$(date -Iseconds)" "$txt")"

if on_sommet; then
  dir="$HOME/.cache/thedev/command/ordres/$machine"; mkdir -p "$dir" || exit 1
  printf '%s' "$body" > "$dir/$ts.ordre.tmp" && mv "$dir/$ts.ordre.tmp" "$dir/$ts.ordre"
else
  [ -n "$sommet" ] || { echo "directive: no top declared (~/.config/thedev-sommet)" >&2; exit 1; }
  printf '%s' "$body" | ssh -o ConnectTimeout=10 "$sommet" \
    "d=\$HOME/.cache/thedev/command/ordres/$machine; mkdir -p \"\$d\" && cat > \"\$d/$ts.ordre.tmp\" && mv \"\$d/$ts.ordre.tmp\" \"\$d/$ts.ordre\"" \
    || { echo "directive: drop at top '$sommet' failed" >&2; exit 1; }
fi
echo "✓ directive dropped for $machine/$workspace (top queue), id $ts"
echo "  $machine will consume it when it wakes up (\`directives pull\`)."
