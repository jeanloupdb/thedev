#!/usr/bin/env bash
# @thedev session barre + pour ajouter un soldat aside a la stack
# aside-button — barre "＋" fixe en bas de la colonne droite (toujours sous tous
# les soldats). Tu y vas avec Alt+↓ ; Entrée ouvre un nouveau soldat qui rejoint
# la stack au-dessus.
#
# Deux états VISUELS, pour qu'on voie quand la ligne est sélectionnée :
#   - au REPOS (pane non focus) : « ＋ Nouveau soldat » + métriques limitantes à droite ;
#   - SÉLECTIONNÉ (pane focus) : métriques MASQUÉES + action mise en évidence (inversé).
# Détection du focus via les événements terminaux focus-in/out (CSI I / CSI O,
# demandés par \033[?1004h, transmis par zellij). Si non transmis → reste au repos.

g=$'\033[1;32m'; d=$'\033[2m'; r=$'\033[0m'; rev=$'\033[7m'
printf '\033[?1004h'                       # demande les événements focus in/out
trap 'printf "\033[?1004l\r\033[K"' EXIT   # désactive + nettoie la ligne à la sortie
focused=0

render() {
  if [ "$focused" = 1 ]; then
    # sélectionné : pas de métriques (bruit), action claire et surlignée
    printf '\r\033[K %s%s  ＋  Nouveau soldat  —  Entrée pour ouvrir  %s' "$rev" "$g" "$r"
  else
    # au repos : action discrète + métriques limitantes à droite (source thedev-metrics)
    local metrics; metrics="$(thedev-metrics 2>/dev/null)"
    printf '\r\033[K %s＋ Nouveau soldat%s  %s[Entrée]%s   %s' "$g" "$r" "$d" "$r" "$metrics"
  fi
}

while :; do
  render
  # read 1 caractère brut (pour capter l'ESC des séquences de focus), timeout 3s
  # → la ligne se rafraîchit même sans frappe (métriques live).
  if IFS= read -t 3 -rsN1 c; then
    case "$c" in
      $'\033')                                  # début de séquence — focus event ?
        IFS= read -t 0.08 -rsN2 seq 2>/dev/null
        case "$seq" in '[I') focused=1 ;; '[O') focused=0 ;; esac
        ;;
      $'\r'|$'\n')                              # Entrée → ouvrir un nouveau soldat
        zellij action move-focus up 2>/dev/null
        renfort
        ;;
      q|Q) : ;;
    esac
  else
    [ "$?" -le 128 ] && sleep 1                 # EOF/erreur (pas un timeout) → anti-boucle folle
  fi
done
