#!/usr/bin/env bash
# @thedev naming indicateur « ● » busy dans la barre zjstatus (clignote tant qu'un Claude répond)
# tab-pulse — pousse dans zjstatus (widget pipe_busy) un POINT VERT CLIGNOTANT dès
# qu'un Claude de CETTE session zellij est « busy » (en plein tour). Posé juste
# devant la liste des pages ({pipe_busy}{tabs}) → se lit comme « ● devant la page »,
# sans dupliquer le nom de la page. S'auto-éteint quand plus aucun Claude n'est busy.
# Lancé détaché par le hook dev-claude-track (UserPromptSubmit), 1 instance/session (flock).
#
#   marqueur ~/.cache/dev-claude-busy/<sid> = <pane_id>\t<session> (sid = nom du fichier)
#   → la simple présence d'un marqueur pour CETTE session ($ZS) suffit (plus de
#     mapping pane→onglet via dump-layout : on ne montre plus le nom de la page).
set -u
ZS="${ZELLIJ_SESSION_NAME:-}"
[ -n "$ZS" ] || exit 0
BUSY_DIR="$HOME/.cache/dev-claude-busy"
[ -d "$BUSY_DIR" ] || exit 0

LOCK_DIR="$HOME/.cache/dev-claude-pulse"; mkdir -p "$LOCK_DIR" 2>/dev/null
safe=$(printf '%s' "$ZS" | tr -c 'A-Za-z0-9._-' '_')
exec 9>"$LOCK_DIR/$safe.tab.lock" 2>/dev/null || exit 0
flock -n 9 2>/dev/null || exit 0   # un tab-pulse tourne déjà pour cette session

# timeout : dans une session SANS le widget pipe_busy (ancien layout), `zellij pipe`
# bloque en attendant un consommateur → on borne pour ne jamais pendre.
push() { timeout 2 zellij pipe "zjstatus::pipe::pipe_busy::$1" >/dev/null 2>&1; }

parity=0
while :; do
  # un Claude de MA session ($ZS) est-il « busy » (en plein tour) ?
  busy=0
  for f in "$BUSY_DIR"/*; do
    [ -f "$f" ] || continue
    IFS=$'\t' read -r _pid zs < "$f" 2>/dev/null || continue
    [ "${zs:-}" = "$ZS" ] && { busy=1; break; }
  done
  if [ "$busy" = 0 ]; then push ""; break; fi   # plus de busy → efface l'indicateur

  glyph="●"; [ "$parity" = 1 ] && glyph="○"   # clignotement ●↔○ (même pulse que les panes)
  push "#[fg=#8ed68e,bold]$glyph"             # point vert seul, posé devant la 1re page
  parity=$(( 1 - parity ))
  sleep 1
done
exit 0
