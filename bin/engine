#!/usr/bin/env bash
# @thedev moteur façade moteur-agnostique : lance/liste/lit/observe un agent (voir ENGINE-ADAPTER.md)
# bin/engine — façade unique entre thedev et le moteur d'agent (aujourd'hui Claude
# Code). But : découpler thedev des internals d'un moteur précis (VISION.md principe 1,
# ENGINE-COUPLING.md). Frontière d'abstraction = le SCHÉMA : args stables en entrée,
# sortie stable, quel que soit le backend ($THEDEV_ENGINE, lib/engine/<nom>.sh).
# Exit : 0 ok · 2 non supporté par ce moteur · 1 erreur.
set -u

THEDEV_ENGINE="${THEDEV_ENGINE:-claude}"

# Repo thedev résolu depuis l'emplacement RÉEL de ce script (relocatable, marche
# même appelé via symlink depuis ~/.local/bin) — même idiome que claude-pane.
_self="$0"; case "$_self" in */*) ;; *) _self="$(command -v -- "$_self")" ;; esac
ROOT="$(cd "$(dirname "$(readlink -f -- "$_self")")/.." && pwd)"
BACKEND="$ROOT/lib/engine/$THEDEV_ENGINE.sh"
[ -f "$BACKEND" ] || { echo "engine: backend '$THEDEV_ENGINE' introuvable ($BACKEND)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$BACKEND"

verb="${1:-}"; shift 2>/dev/null || true

case "$verb" in
  launch|resume)
    cwd="" model="" resume="" init="" initfile=""
    [ "$verb" = resume ] && { resume="${1:-}"; shift 2>/dev/null || true; }
    extra=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --cwd)            cwd="$2"; shift 2 ;;
        --model)          model="$2"; shift 2 ;;
        --resume)         resume="$2"; shift 2 ;;
        --init)           init="$2"; shift 2 ;;
        --init-file)      initfile="$2"; shift 2 ;;
        --remote-control) shift 2 ;;   # auto sur VPS (claude-pane) — accepté, délégué
        --system-append)  shift 2 ;;   # prompt zellij natif (claude-pane) — délégué
        --)               shift; extra+=("$@"); break ;;
        *)                extra+=("$1"); shift ;;
      esac
    done
    engine_launch "$cwd" "$model" "$resume" "$init" "$initfile" -- ${extra[@]+"${extra[@]}"}
    ;;
  list)
    cwd="" all=0 json=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --cwd)  cwd="$2"; shift 2 ;;
        --all)  all=1; shift ;;
        --json) json=1; shift ;;
        *)      shift ;;
      esac
    done
    if [ "$all" != 1 ]; then
      [ -n "$cwd" ] || cwd="$(pwd -P)"
      cwd="$(realpath "$cwd" 2>/dev/null || printf '%s' "$cwd")"
    fi
    engine_list "$cwd" "$all" "$json"
    ;;
  read)
    id="" last=1 role=assistant json=0 ref=""   # défaut : dernier message assistant (= résultat de mission)
    while [ $# -gt 0 ]; do
      case "$1" in
        --last)       last=1; shift ;;
        --all)        last=0; shift ;;
        --role)       role="$2"; shift 2 ;;
        --json)       json=1; shift ;;
        --transcript) ref="$2"; shift 2 ;;
        --*)          shift ;;
        *)            [ -n "$id" ] || id="$1"; shift ;;
      esac
    done
    [ -n "$id" ] || [ -n "$ref" ] || { echo "engine read: ID ou --transcript requis" >&2; exit 1; }
    engine_read "$id" "$last" "$role" "$json" "$ref"
    ;;
  usage)
    json=0; [ "${1:-}" = --json ] && json=1
    engine_usage "$json"
    ;;
  running)
    id=""; [ "${1:-}" = --id ] && id="${2:-}"
    engine_running "$id"
    ;;
  event)
    type="${1:-}"; shift 2>/dev/null || true
    session="" cwd="" title="" transcript=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --session)    session="$2"; shift 2 ;;
        --cwd)        cwd="$2"; shift 2 ;;
        --title)      title="$2"; shift 2 ;;
        --transcript) transcript="$2"; shift 2 ;;
        *)            shift ;;
      esac
    done
    [ -n "$type" ] && [ -n "$session" ] || { echo "engine event: TYPE et --session requis" >&2; exit 1; }
    engine_event "$type" "$session" "$cwd" "$title" "$transcript"
    ;;
  install-hooks)
    engine_install_hooks
    ;;
  selftest)
    # Vérifie que l'adaptateur honore toujours le contrat (à lancer APRÈS une mise
    # à jour du moteur : si Claude Code change son format, `list`/`read` le révèlent).
    pass=0 fail=0
    ok() { printf '  \033[32m✓\033[0m %-8s : %s\n' "$1" "$2"; pass=$((pass+1)); }
    ko() { printf '  \033[31m✗\033[0m %-8s : %s\n' "$1" "$2"; fail=$((fail+1)); }
    printf 'engine selftest (backend : %s)\n' "$THEDEV_ENGINE"

    # list : parse des sessions — LE plus sensible à un changement de format moteur.
    lst=$(engine_list "" 1 0 2>/dev/null)
    n=$(printf '%s' "$lst" | grep -c .)
    bad=$(printf '%s\n' "$lst" | awk -F'\t' 'NF && NF!=5' | grep -c .)
    if   [ "$n" -gt 0 ] && [ "$bad" -eq 0 ]; then ok list "$n espaces, TSV à 5 colonnes valide"
    elif [ "$n" -eq 0 ]; then ko list "0 espace listé — le format du moteur a peut-être changé"
    else ko list "$bad ligne(s) TSV malformée(s)"; fi

    # running : doit être un entier.
    r=$(engine_running "" 2>/dev/null)
    case "$r" in ""|*[!0-9]*) ko running "valeur inattendue : '$r'" ;; *) ok running "$r process moteur vivant(s)" ;; esac

    # usage : TSV, ou exit 2 (non supporté), ou vide (pas de token) — jamais d'erreur dure.
    u=$(engine_usage 0 2>/dev/null); rc=$?
    if   [ "$rc" = 2 ]; then ok usage "non supporté par ce moteur (exit 2)"
    elif [ -n "$u" ];   then ok usage "$(printf '%s' "$u" | tr '\n\t' '  ')"
    else ok usage "pas de donnée (hors-ligne / pas de token)"; fi

    # read : dernier message assistant de la session la plus récente.
    fid=$(printf '%s' "$lst" | head -1 | cut -f1)
    if [ -n "$fid" ]; then
      msg=$(engine_read "$fid" 1 assistant 0 2>/dev/null) && ok read "session lue (${#msg} car.)" \
        || ko read "engine read a échoué"
    else ok read "aucune session à lire (ok)"; fi

    # event : round-trip busy → turn-end sur un id jetable (ne touche pas au registre).
    tsid=__engine_selftest__
    if [ -n "${CC_BUSY_DIR:-}" ]; then
      engine_event busy "$tsid" /tmp "" "" 2>/dev/null
      b1=$([ -f "$CC_BUSY_DIR/$tsid" ] && echo y || echo n)
      engine_event turn-end "$tsid" /tmp "" "" 2>/dev/null
      b2=$([ -f "$CC_BUSY_DIR/$tsid" ] && echo y || echo n)
      rm -f "$CC_BUSY_DIR/$tsid" 2>/dev/null
      { [ "$b1" = y ] && [ "$b2" = n ]; } && ok event "busy posé puis retiré (round-trip)" \
        || ko event "round-trip KO (posé=$b1 retiré=$b2)"
    else
      engine_event busy "$tsid" /tmp "" "" 2>/dev/null && engine_event turn-end "$tsid" /tmp "" "" 2>/dev/null \
        && ok event "busy/turn-end sans erreur" || ko event "engine_event a échoué"
    fi

    [ "$fail" -eq 0 ] && printf '\033[32mPASS\033[0m (%d/%d)\n' "$pass" "$((pass+fail))" \
      || printf '\033[31mFAIL\033[0m (%d/%d)\n' "$pass" "$((pass+fail))"
    [ "$fail" -eq 0 ]
    ;;
  ""|-h|--help|help)
    cat >&2 <<'USAGE'
engine — façade moteur-agnostique (backend via $THEDEV_ENGINE, défaut : claude)

  engine launch  [--cwd D] [--model M] [--resume ID] [--init MSG|--init-file F] [-- EXTRA…]
  engine resume  ID [mêmes options que launch]
  engine list    [--cwd D] [--all] [--json]
  engine read    ID|--transcript REF [--last|--all] [--role assistant|user|any] [--json]
  engine usage   [--json]
  engine running [--id ID]
  engine event   TYPE --session ID --cwd D [--title T] [--transcript REF]
                 TYPE ∈ session-start | busy | turn-end | session-end
  engine install-hooks
  engine selftest   # vérifie le contrat (à lancer après une mise à jour du moteur)

Exit : 0 ok · 2 non supporté par ce moteur · 1 erreur. Voir ENGINE-ADAPTER.md.
USAGE
    exit 1
    ;;
  *)
    echo "engine: verbe inconnu '$verb' (engine --help)" >&2
    exit 1
    ;;
esac
