#!/usr/bin/env bash
# @thedev veille sends text/photo to Telegram (Bot API, curl): delivery of feeds & alerts
# tg: pushes a message or a photo to Telegram through the Bot API. Zero dependency (curl).
# Built for digests in SEVERAL short messages + images (one call = one message).
# Retries on its own on Telegram flood control ("retry after N") → reliable unattended.
#
#   tg "<markdown text>"                     → message (parse_mode Markdown)
#   tg --photo <url|file> ["<caption>"]      → photo (remote URL OR local file), Markdown caption
#   tg --audio <file> ["<caption>"]          → audio file (mp3): Telegram player with duration
#   tg --plain "<text>"                      → message without formatting (no parse_mode)
#
# Config (SOURCED files, never printed; each file completes the variables):
#   ~/.config/thedev/telegram.env, ~/.config/heartbeat/heartbeat.env, ~/.claude/channels/telegram/.env
#   → TELEGRAM_BOT_TOKEN (required), TELEGRAM_CHAT_ID (recipient)
set -u

for f in "$HOME/.config/thedev/telegram.env" "$HOME/.config/heartbeat/heartbeat.env" "$HOME/.claude/channels/telegram/.env"; do
  # shellcheck disable=SC1090
  [ -f "$f" ] && . "$f"
done
: "${TELEGRAM_BOT_TOKEN:=}"; : "${TELEGRAM_CHAT_ID:=}"
[ -n "$TELEGRAM_BOT_TOKEN" ] && [ -n "$TELEGRAM_CHAT_ID" ] || {
  echo "tg: TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID missing (see ~/.config/thedev/telegram.env)" >&2; exit 1; }
API="https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}"

# Envoi avec réessai auto sur flood-control (« retry after N »). Le token n'apparaît
# JAMAIS en sortie : on ne montre que le statut renvoyé par Telegram.
send() {  # send <endpoint> <curl-args…>
  local ep="$1"; shift
  local out delay t
  for t in 1 2 3; do
    out=$(curl -sS -m 60 "$API/$ep" "$@" 2>&1)
    case "$out" in
      *'"ok":true'*) return 0 ;;
      *'retry after'*)
        delay=$(printf '%s' "$out" | grep -oE 'retry after [0-9]+' | grep -oE '[0-9]+$')
        sleep "$(( ${delay:-3} + 1 ))" ;;
      *) echo "tg: failed: $(printf '%s' "$out" | grep -oE '"description":"[^"]*"' | head -1)" >&2; return 1 ;;
    esac
  done
  echo "tg: failed after retries (flood control)" >&2; return 1
}

case "${1:-}" in
  -h|--help|"") grep -E '^#( |$)' "$0" | sed -E 's/^# ?//'; exit 0 ;;

  --photo)
    src="${2:-}"; cap="${3:-}"
    [ -n "$src" ] || { echo "tg --photo: url or file required" >&2; exit 1; }
    if [ -f "$src" ]; then
      send sendPhoto -F "chat_id=$TELEGRAM_CHAT_ID" -F "photo=@$src" \
        -F "caption=$cap" -F "parse_mode=Markdown"
    else
      send sendPhoto --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \
        --data-urlencode "photo=$src" --data-urlencode "caption=$cap" \
        --data-urlencode "parse_mode=Markdown"
    fi ;;

  --audio)
    src="${2:-}"; cap="${3:-}"
    [ -f "$src" ] || { echo "tg --audio: file required" >&2; exit 1; }
    send sendAudio -F "chat_id=$TELEGRAM_CHAT_ID" -F "audio=@$src" \
      -F "caption=$cap" -F "parse_mode=Markdown" ;;

  --plain)
    send sendMessage --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \
      --data-urlencode "text=${2:-}" --data-urlencode "disable_web_page_preview=true" ;;

  *)
    send sendMessage --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \
      --data-urlencode "text=$1" --data-urlencode "parse_mode=Markdown" \
      --data-urlencode "disable_web_page_preview=true" ;;
esac
