#!/usr/bin/env bash
# @thedev session menu de fermeture propre de la session
# debrief-menu — modal déclenché par Ctrl+Q dans zellij. Lancé en pane FLOTTANT
# close_on_exit. d = détacher (session vivante), f = fermer (tuer), autre = annuler.
#
# Plus de résumé de fin : le contexte d'équipe remonte EN CONTINU (note/resume/jalon/
# blocage) au fil du travail, il n'y a rien à capturer à la fermeture. « f » ferme, point.
#
# Rendu : minimaliste. Quelques lignes nues, alignées — pas de cadre ni de puce.

# Résolution FIABLE du nom de session : dans un pane lancé par un keybind, la var
# $ZELLIJ_SESSION_NAME peut être vide → fallback sur la session marquée (current).
# CRITIQUE : sans ce fallback, `delete-session --force ""` (nom vide) pouvait
# viser TOUTES les sessions au lieu de la courante.
sess="${ZELLIJ_SESSION_NAME:-}"
[ -z "$sess" ] && sess=$(zellij list-sessions --no-formatting 2>/dev/null | awk '/\(current\)/{print $1; exit}')

R=$'\033[0m'; B=$'\033[1m'; D=$'\033[2m'
G=$'\033[1;32m'; RED=$'\033[1;31m'

clear
printf '\n'
printf '  %sQuitter%s %s%s%s\n\n' "$B" "$R" "$D" "$sess" "$R"
printf '  %sd%s   détacher   %sla session reste vivante%s\n' "$G" "$R" "$D" "$R"
printf '  %sf%s   fermer     %stuer la session%s\n' "$RED" "$R" "$D" "$R"

# Ce que « fermer » va couper (missions/soutiens/gardes), aligné sous les descriptions.
# debrief-impact émet du TSV « <texte_visible>\t<rendu_ANSI> » ; rien si l'equipe est inerte.
impact=$(debrief-impact "$sess" 2>/dev/null)
if [ -n "$impact" ]; then
  while IFS=$'\t' read -r plain ren; do
    [ -n "$plain" ] || continue
    printf '      %s\n' "$ren"
  done <<<"$impact"
fi

printf '\n  %séchap · annuler%s\n' "$D" "$R"

read -rsn1 key
case "$key" in
  d|D) zellij action detach ;;
  f|F)
    # FERMER = tuer la session, POINT. Aucun résumé de fin (l'info remonte en continu).
    # Garde-fou : jamais delete-session sans nom confirmé.
    if [ -z "$sess" ]; then
      printf '\n  %sSession introuvable — rien fermé (sécurité).%s\n' "$RED" "$R"; sleep 1.5
    else
      zellij delete-session --force "$sess"
    fi
    ;;
  *)   : ;;
esac
