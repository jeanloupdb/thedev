#!/usr/bin/env python3
# @thedev session menu de fermeture propre de la session
"""debrief-menu — modal déclenché par Ctrl+Q, et par « accueil » dans la
colonne de gauche. Lancé en pane FLOTTANT close_on_exit.

Trois lignes SÉLECTIONNABLES (↑↓ ou clic, Entrée valide) :
    détacher   la session reste vivante
    fermer     tuer la session
    annuler

Ce que « fermer » coupe (missions, soutiens, gardes qui TOURNENT) est écrit
sous « fermer » comme une phrase en clair et en atténué — « ça coupe aussi
2 soutiens ». C'était auparavant un « ✗ 2 soutiens » rouge, aligné nulle part :
le glyphe et la couleur criaient l'alerte sans jamais dire ce qui se passait.
L'information est la même, mais elle se lit.

Rendu : un bloc de quelques lignes, CENTRÉ dans le pane (le pane flottant est
plus grand que le texte — collé en haut à gauche, le menu paraissait déréglé),
colonnes calculées depuis les libellés, pas de cadre ni de puce. Le surlignage
épouse le bloc et pas toute la largeur, pour ne pas peser.

`d` / `f` restent des raccourcis directs pour qui les connaît.
"""
import curses
import os
import subprocess
import sys
import textwrap


def sh(cmd, timeout=4):
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=timeout).stdout
    except Exception:
        return ""


def equipe():
    """Nom de session FIABLE : dans un pane lancé par un keybind,
    $ZELLIJ_SESSION_NAME peut être vide → repli sur la session marquée
    « (current) ». CRITIQUE : sans ce repli, `delete-session --force ""` (nom
    vide) pouvait viser TOUTES les sessions au lieu de la courante."""
    n = os.environ.get("ZELLIJ_SESSION_NAME", "").strip()
    if n:
        return n
    for line in sh(["zellij", "list-sessions", "--no-formatting"], 2).splitlines():
        if "(current)" in line:
            return line.split()[0]
    return ""


def impact(eq):
    """Ce que « fermer » va couper, en morceaux de phrase prêts à assembler
    (« 2 soutiens », « la garde « veille » »). Vide si l'equipe est inerte."""
    if not eq:
        return []
    return [l.strip() for l in sh(["debrief-impact", eq]).splitlines() if l.strip()]


def enumere(parts):
    """« a », « a et b », « a, b et c » — une énumération qui se lit à voix
    haute. Le « · » d'avant était un séparateur de tableau posé dans une phrase."""
    if len(parts) <= 1:
        return "".join(parts)
    return ", ".join(parts[:-1]) + " et " + parts[-1]


def main(scr):
    eq = equipe()
    hits = impact(eq)
    curses.use_default_colors()
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    curses.init_pair(1, curses.COLOR_GREEN, -1)
    curses.init_pair(2, curses.COLOR_RED, -1)
    GREEN, RED, DIM = curses.color_pair(1), curses.color_pair(2), curses.A_DIM
    SEL = curses.A_REVERSE
    if curses.COLORS >= 256:
        try:
            curses.init_pair(3, 252, 237)
            SEL = curses.color_pair(3)
        except curses.error:
            pass
    curses.mousemask(curses.ALL_MOUSE_EVENTS)
    curses.mouseinterval(0)
    scr.keypad(True)

    # (touche, libellé, description, couleur, décision)
    opts = [("d", "détacher", "la session reste vivante", GREEN, "detach"),
            ("f", "fermer",   "tuer la session",          RED,   "kill"),
            (None, "annuler", "",                         DIM,   None)]
    # La colonne des descriptions se cale sur le plus long libellé — trois
    # espaces après, jamais une tabulation devinée. Ajouter une entrée ne
    # décale donc plus rien à la main.
    col = max(len(o[1]) for o in opts) + 3
    note = ("ça coupe aussi " + enumere(hits)) if hits else ""
    sel = 0

    while True:
        scr.erase()
        h, w = scr.getmaxyx()
        # Le bloc est construit d'abord (lignes + largeur), puis posé centré :
        # sa taille dépend du nom d'équipe et de l'annotation, on ne peut pas
        # la coder en dur.
        head = "Quitter %s" % (eq or "?")
        # L'annotation passe à la ligne plutôt que d'être coupée : une liste
        # tronquée à « 2 missions, 3 soutiens… » cacherait précisément ce qu'on
        # est en train de tuer.
        nlines = textwrap.wrap(note, max(12, min(w - 4, 48) - col)) if note else []
        lines = [("head", None), ("blank", None)]
        for i, o in enumerate(opts):
            lines.append(("opt", i))
            if o[4] == "kill":
                lines.extend(("note", k) for k in range(len(nlines)))
        bw = max([len(head)] + [col + len(o[2]) for o in opts]
                 + [col + len(l) for l in nlines])
        bw = min(bw, max(1, w - 4))
        x = max(1, (w - bw) // 2)
        y = max(0, (h - len(lines)) // 2)

        ymap = {}
        for kind, i in lines:
            if y >= h:
                break
            try:
                if kind == "head":
                    scr.addnstr(y, x, "Quitter", max(0, w - x - 1), curses.A_BOLD)
                    scr.addnstr(y, x + 8, eq or "?", max(0, w - x - 9), DIM)
                elif kind == "note":
                    scr.addnstr(y, x + col, nlines[i], max(0, w - x - col - 1), DIM)
                elif kind == "opt":
                    _k, label, desc, c, _d = opts[i]
                    ymap[y] = i
                    a = SEL if i == sel else 0
                    if a:
                        # Un bandeau à la taille du bloc, pas de la largeur du
                        # pane : le pane est large, une barre pleine écraserait
                        # les trois lignes qu'elle est censée servir.
                        scr.addnstr(y, max(0, x - 1), " " * (bw + 2),
                                    max(0, w - x), SEL)
                    scr.addnstr(y, x, label, max(0, w - x - 1),
                                (c | curses.A_BOLD) | a)
                    if desc:
                        scr.addnstr(y, x + col, desc, max(0, w - x - col - 1),
                                    DIM | a)
            except curses.error:
                pass
            y += 1
        scr.refresh()

        try:
            c = scr.getch()
        except KeyboardInterrupt:
            return None
        if c in (27, ord("q")):
            return None
        if c in (curses.KEY_UP, ord("k")):
            sel = (sel - 1) % len(opts)
        elif c in (curses.KEY_DOWN, ord("j")):
            sel = (sel + 1) % len(opts)
        elif c in (curses.KEY_ENTER, 10, 13):
            return opts[sel][4]
        elif c in (ord("d"), ord("D")):
            return "detach"
        elif c in (ord("f"), ord("F")):
            return "kill"
        elif c == curses.KEY_MOUSE:
            try:
                _, _, my, _, bs = curses.getmouse()
            except curses.error:
                continue
            if not (bs & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED)):
                continue
            if my in ymap:
                sel = ymap[my]
                return opts[sel][4]


if __name__ == "__main__":
    eq_name = equipe()
    decision = curses.wrapper(main)
    if decision == "detach":
        subprocess.run(["zellij", "action", "detach"])
    elif decision == "kill":
        # FERMER = tuer la session, POINT. Garde-fou : jamais delete-session
        # sans nom confirmé (un nom vide viserait toutes les sessions).
        if not eq_name:
            sys.stderr.write("Session introuvable — rien fermé (sécurité).\n")
            sys.exit(1)
        subprocess.run(["zellij", "delete-session", "--force", eq_name])
